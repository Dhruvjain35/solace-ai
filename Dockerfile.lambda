# Container Lambda for Solace — no 250MB zip ceiling, no scipy stripping,
# models baked in (no S3 cold-fetch), libgomp from AL2023 dnf (no Debian mirror).
FROM public.ecr.aws/lambda/python:3.12

# OpenMP runtime for LightGBM (native AL2023 package — stable, no external mirror).
# Clear the dnf metadata cache afterwards so it is not baked into the image layer.
RUN dnf install -y libgomp \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Python deps — full versions, no manylinux cross-compile or stripping needed
# because we're building IN the Lambda runtime environment. The requirements file
# is removed after install so the (potentially sensitive) build manifest is not
# shipped inside the runtime image.
COPY requirements-lambda.txt /tmp/requirements-lambda.txt
RUN pip install --no-cache-dir -r /tmp/requirements-lambda.txt \
    && rm -f /tmp/requirements-lambda.txt

# Matplotlib arrives transitively (shap and catboost both pull it in, and
# unpickling artifacts.pkl imports them). On a read-only Lambda filesystem it
# cannot write its font cache to $HOME, so on every cold start it logged
#
#   mkdir -p failed for path /home/sbx_user1051/.config/matplotlib: Read-only file system
#   Matplotlib created a temporary cache directory at /tmp/matplotlib-...
#
# and then rebuilt the font cache from scratch. That was the last thing in the
# log before every single warmup invocation hit the 60-second timeout.
#
# Point it at a writable path and build the cache once, here, so it is baked into
# the image instead of reconstructed on every cold start.
ENV MPLCONFIGDIR=/tmp/matplotlib
RUN MPLCONFIGDIR=/var/task/.mplcache python -c "\
import matplotlib; matplotlib.use('Agg'); import matplotlib.pyplot" 2>/dev/null \
    || echo "matplotlib not installed in this image — nothing to pre-cache"

# App code
COPY backend/main.py ${LAMBDA_TASK_ROOT}/
COPY backend/lib ${LAMBDA_TASK_ROOT}/lib
COPY backend/db ${LAMBDA_TASK_ROOT}/db
COPY backend/routers ${LAMBDA_TASK_ROOT}/routers
COPY backend/services ${LAMBDA_TASK_ROOT}/services

# Model artifacts — copy whatever exists (empty dir is fine, simulation engine handles it)
COPY backend/models ${LAMBDA_TASK_ROOT}/models

# Drop privileges — the AL2023 Lambda base ships a non-root "sbx_user1051" (UID
# 993). Running as a non-root principal limits blast radius if app code is
# compromised; the runtime task files remain world-readable so the handler loads.
USER 993

CMD ["main.handler"]
