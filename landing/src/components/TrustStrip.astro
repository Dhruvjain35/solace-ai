---
/* Not in Superhuman. Solace needs it: the security review is the actual buying
   gate for a hospital, and it currently lives three clicks deep.

   Every fact here is one I could verify in the repo. This is new copy, so it is
   written to the verified floor rather than inheriting claims from /security.
   No shield icons, no padlocks — the bordered grid IS the visual. */
const facts = [
  {
    title: 'HIPAA Business Associate',
    body: 'A signed BAA before any patient data moves.',
  },
  {
    title: 'Consent gate',
    body: 'No consent, no AI call. Enforced at the API, not in policy.',
  },
  {
    title: 'Append-only audit log',
    body: 'Every read and every write, kept for six years.',
  },
  {
    title: 'SOC 2 Type II in progress',
    body: 'Ask us for the current status and our questionnaire.',
  },
];
---

<section class="trust-section" data-background-color="primary-default" aria-labelledby="trust-heading">
  <div class="container page-section trust">
    <div class="trust__head">
      <h2 id="trust-heading" class="heading-medium">Let your security team kick the tires.</h2>
      <p class="text-medium text-sub">
        We would rather be precise than impressive. Here is exactly where we stand.
      </p>
      <a class="cta-secondary" href="/privacy">Read the privacy policy</a>
    </div>

    <ul class="trust__grid">
      {facts.map((f) => (
        <li class="trust__cell neu-raised">
          <h3 class="heading-xsmall">{f.title}</h3>
          <p class="text-small text-sub">{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* The security section sat on flat white between two coloured neighbours and
     fell out of the page. A wide, quiet brand field puts it back in — quiet
     because this is the section a security reviewer reads, and it should look
     careful rather than sold. */
  .trust-section {
    position: relative;
    background-image:
      radial-gradient(ellipse 60% 90% at 4% 0%,   rgb(from var(--solace-30) r g b / 0.22), transparent 62%),
      radial-gradient(ellipse 66% 96% at 98% 92%, rgb(from var(--slate-20) r g b / 0.30), transparent 66%);
  }
  .trust-section > * { position: relative; z-index: 1; }

  .trust__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4x);
    max-inline-size: 62ch;
    padding-block-end: var(--space-12x);
  }
  .trust__head .cta-secondary { margin-block-start: var(--space-2x); }

  /* Four surfaces, not four compartments. They were cells inside one panel,
     divided by hairlines — which reads as a table, and a table is the one thing
     a security list should not look like. Each fact now sits on its own raised
     surface with its own catch-light along the top edge and its own shade
     underneath, so the grid has depth to it rather than ruling.

     The numbers are gone with the dividers. They were there to give the eye an
     order to read four identical boxes in; four separate cards do that on their
     own, and a numbered list implies a sequence these facts do not have. */
  .trust__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4x);
  }
  @media (min-width: 640.02px)  { .trust__grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-5x); } }
  @media (min-width: 1080.02px) { .trust__grid { grid-template-columns: repeat(4, 1fr); } }

  .trust__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2_5x);
    padding: var(--space-7x) var(--space-6x);
    border-radius: var(--radius-4x);
    /* .neu-raised is tuned for buttons, and at card size its ladder reads flat.
       This is the same construction one step up: the catch-light and the hairline
       stay, the drop gets a longer pure-Y ladder so the card sits ON the field
       rather than against it. Kept short of .neu-panel, which is the page's
       signature surface and should stay the biggest thing in the room. */
    box-shadow:
      inset 0 1px 0 0 rgb(from var(--white) r g b / 95%),
      inset 0 0 0 1px rgb(from var(--neutral-40) r g b / 10%),
      0 1px 2px -1px  rgb(from var(--neutral-40) r g b / 12%),
      0 4px 8px -2px  rgb(from var(--neutral-40) r g b / 11%),
      0 10px 20px -6px rgb(from var(--neutral-40) r g b / 10%),
      0 20px 36px -12px rgb(from var(--neutral-40) r g b / 8%);
    /* The lift on hover is already in .neu-raised, which was built for controls.
       These are not controls, so it is dialled back to a rise rather than a
       press: the surface lifts, nothing invites a click. */
    transition: translate var(--motion-duration-slow) var(--ease-ui),
                box-shadow var(--motion-duration-slow) var(--ease-ui);
  }
  @media (hover: hover) {
    .trust__cell:hover {
      translate: 0 -3px;
      box-shadow:
        inset 0 1px 0 0 rgb(from var(--white) r g b / 95%),
        inset 0 0 0 1px rgb(from var(--neutral-40) r g b / 12%),
        0 2px 4px -1px  rgb(from var(--neutral-40) r g b / 13%),
        0 6px 12px -3px rgb(from var(--neutral-40) r g b / 12%),
        0 14px 28px -8px rgb(from var(--neutral-40) r g b / 11%),
        0 28px 48px -14px rgb(from var(--neutral-40) r g b / 9%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trust__cell { transition: none; }
    .trust__cell:hover { translate: none; }
  }

  .trust__cell h3 { color: var(--color-text-base); }
</style>
