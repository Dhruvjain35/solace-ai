---
/* Superhuman's tabbed section. All four panels render — this is not a swap.
   The sticky bar highlights whichever panel is in view.

   Every figure is live DOM and every one is a 12s looping film.

   None of the four appears anywhere else on the site. That is a hard rule, not
   a preference: this section and the eight acts on /product cover the same four
   products, and showing the same figure in both made the site read as one page
   printed twice. So the tour gets the walkthrough — the phone screen by screen,
   the score changing, the note being written, the chart being questioned — and
   the home page gets a DIFFERENT true fact about each of the same four:

     Intake  -> the interpreter delay collapsing, which is what the phone is for
     Triage  -> the calibrated uncertainty underneath the number
     Scribe  -> clicking a drafted line to hear the seconds that produced it
     Atlas   -> the same intelligence arriving as a card inside the EHR

   Four products, eight figures, no repeats. */
import GraphicLanguages from './mockups/GraphicLanguages.astro';
import GraphicConfidence from './mockups/GraphicConfidence.astro';
import GraphicEvidence from './mockups/GraphicEvidence.astro';
import GraphicHooks from './mockups/GraphicHooks.astro';
import ActGlyph from './mockups/ActGlyph.astro';
const panels = [
  {
    id: 'suite-intake',
    tab: 'Intake',
    eyebrow: 'Smart Patient Intake',
    heading: 'Everyone speaks first language',
    glyph: 'language',
    sub: 'They talk the way they think. Their exact words are kept, the team reads it in English, and the answer goes back spoken.',
    link: { label: 'See the patient flow', href: '/product#patient-side' },
    mock: 'languages',
  },
  {
    id: 'suite-triage',
    tab: 'Triage',
    eyebrow: 'Triage',
    heading: 'It tells you when it is unsure',
    glyph: 'confidence',
    sub: 'Most triage models hand you one number and stop. This one publishes the set the answer is actually in, and a wide set goes to a person.',
    link: { label: 'How the score works', href: '/product#patient-side' },
    mock: 'confidence',
  },
  {
    id: 'suite-scribe',
    tab: 'Ambient Scribe',
    eyebrow: 'Ambient Scribe',
    heading: 'A note you can check',
    glyph: 'evidence',
    sub: 'The note drafts while you talk. Click any line and the exact seconds of audio that produced it play back.',
    link: { label: 'See what it drafts', href: '/product#patient-side' },
    mock: 'evidence',
  },
  {
    id: 'suite-atlas',
    tab: 'Atlas',
    eyebrow: 'Atlas',
    heading: 'It comes to you, in the chart',
    glyph: 'hooks',
    sub: 'A standard hook fires when you sign an order and the card arrives in place. No new tab, nothing extra to remember.',
    link: { label: 'Bring Atlas to your team', href: '/clinicians' },
    mock: 'hooks',
  },
];
---

<section data-background-color="secondary-default" aria-labelledby="suite-heading">
  <div class="container page-section suite">
    <div class="suite__head">
      <h2 id="suite-heading" class="heading-large">The whole front door.</h2>
      <a class="cta-secondary" href="/demo">See the full flow</a>
    </div>

    <div class="suite__tabs" role="tablist" aria-label="Solace suite" data-suite-tabs>
      {panels.map((p, i) => (
        <a class="suite__tab" href={`#${p.id}`} role="tab" data-index={i} aria-selected={i === 0 ? 'true' : 'false'}>
          {p.tab}
        </a>
      ))}
    </div>

    <div class="suite__panels">
      {panels.map((p, i) => (
        <>
          {i > 0 && <div class="hatch-rule" aria-hidden="true"></div>}
          <article class="suite__panel" id={p.id} data-panel-index={i}>
            <div class="suite__copy">
              <p class="eyebrow">{p.eyebrow}</p>
              <div class="suite__dashed" aria-hidden="true"></div>
              <h3 class="heading-medium suite__heading">{p.heading}<ActGlyph kind={p.glyph} /></h3>
              <p class="text-medium text-sub">{p.sub}</p>
              <a class="arrow-link" href={p.link.href}>
                <span>{p.link.label}</span>
                <svg viewBox="0 0 20 14.17" fill="none" aria-hidden="true">
                  <circle cx="2" cy="7.08" r="1.6" fill="currentColor" />
                  <path d="M6.5 7.08h11M13.4 2.2l4.9 4.88-4.9 4.89" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>

            <figure class="suite__figure">
              {p.mock === 'languages'  && <div class="suite__mock"><GraphicLanguages /></div>}
              {p.mock === 'confidence' && <div class="suite__mock"><GraphicConfidence /></div>}
              {p.mock === 'evidence'   && <div class="suite__mock"><GraphicEvidence /></div>}
              {p.mock === 'hooks'      && <div class="suite__mock"><GraphicHooks /></div>}
            </figure>
          </article>
        </>
      ))}
    </div>
  </div>
</section>

<script>
  // Not an animation — this is state. The bar reflects whichever panel owns the
  // viewport. Everything that actually moves is CSS.
  const bar = document.querySelector('[data-suite-tabs]');
  if (bar) {
    const tabs = Array.from(bar.querySelectorAll('.suite__tab'));
    const panels = Array.from(document.querySelectorAll('[data-panel-index]'));
    const setActive = (i: number) => {
      bar.setAttribute('data-active-index', String(i));
      tabs.forEach((t, n) => t.setAttribute('aria-selected', n === i ? 'true' : 'false'));
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setActive(Number((visible.target as HTMLElement).dataset.panelIndex));
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: [0, 0.25, 0.5, 1] },
    );
    panels.forEach((p) => io.observe(p));
  }
</script>

<style>
  .suite__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-5x);
    align-items: flex-start;
    padding-block-end: var(--space-8x);
  }
  @media (min-width: 640.02px) {
    .suite__head { flex-direction: row; align-items: center; justify-content: space-between; }
  }

  /* Sticky under the site header. */
  .suite__tabs {
    display: none;
    position: sticky;
    inset-block-start: var(--page-header-height);
    z-index: var(--z-sticky);
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--color-border-sub);
    background-color: var(--color-bg-secondary);
  }
  @media (min-width: 640.02px) { .suite__tabs { display: grid; } }

  .suite__tab {
    padding: var(--space-5x) var(--space-4x);
    text-align: center;
    font-size: var(--font-size-text-small);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-sub);
    border-inline-end: 1px solid var(--color-border-sub);
    transition: background-color var(--motion-duration-base) var(--ease-ui),
                color var(--motion-duration-base) var(--ease-ui);
  }
  .suite__tab:last-child { border-inline-end: none; }
  .suite__tab[aria-selected='true'] {
    background-color: hsl(from var(--color-bg-secondary) h s calc(l - 3));
    color: var(--color-text-base);
  }

  .suite__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-8x);
    padding: var(--space-8x);
    background-color: var(--color-bg-tertiary);
    border-inline: 1px solid var(--color-border-sub);
    border-block-end: 1px solid var(--color-border-sub);
    scroll-margin-block-start: calc(var(--page-header-height) * 2);
  }
  @media (min-width: 1080.02px) {
    .suite__panel { flex-direction: row; align-items: center; gap: var(--space-16x); padding: var(--space-12x); }
    .suite__copy, .suite__figure { flex: 1 1 0; min-inline-size: 0; }
  }

  .suite__heading { max-inline-size: 15ch; }
  .suite__copy { display: flex; flex-direction: column; gap: var(--space-4x); align-items: flex-start; }

  /* 4-on / 4-off dashed rule under the eyebrow. */
  .suite__dashed {
    inline-size: min(100%, 320px);
    block-size: 1px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--color-border-sub) 0, var(--color-border-sub) 4px,
      transparent 4px, transparent 8px
    );
  }


  /* Figures are components now, not images, so the old height cap and shadow
     are gone — each mockup owns its own surface and elevation. The figure just
     centres and bounds them. */
  .suite__figure {
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-inline-size: 0;
  }
  .suite__figure > :global(*) { max-inline-size: 560px; inline-size: 100%; }

  /* The graphics size themselves in cqw, and an element cannot be its own query
     container — with container-type on the graphic root, its own cqw units were
     resolving against a 1376px ancestor and every measurement came out ~2.5x
     too large. The container has to be this wrapper. */
  .suite__mock { container-type: inline-size; inline-size: 100%; max-inline-size: 560px; }



  @media (prefers-reduced-motion: reduce) {
    .suite__tab { transition: none; }
  }
</style>
