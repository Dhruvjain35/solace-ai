---
import MarkPaths from './brand/MarkPaths.astro';
import WordPaths from './brand/WordPaths.astro';

export interface Props {
  /** Cap height of the lockup in px. Mark and wordmark scale together. */
  size?: number;
  /** Render the monogram only, without the wordmark. */
  markOnly?: boolean;
}
const { size = 26, markOnly = false } = Astro.props;

/* Both are traced from the shipped brand artwork, so they inherit currentColor
   and stay crisp at any size. The wordmark PNG was 206x70, which pixelated
   badly at the footer's ~1500px ghost treatment. */
const MARK_RATIO = 800 / 990; // w/h
---

<span class="logo" style={`--logo-size:${size}px`}>
  <svg class="logo__mark" viewBox="0 0 800 990" fill="currentColor" role="img" aria-label={markOnly ? 'Solace' : ''} aria-hidden={markOnly ? undefined : 'true'}>
    <MarkPaths />
  </svg>
  {!markOnly && (
    <svg class="logo__word" viewBox="0 0 1648 560" fill="currentColor" role="img" aria-label="Solace">
      <WordPaths />
    </svg>
  )}
</span>

<style define:vars={{ markRatio: MARK_RATIO }}>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-size) * 0.30);
  }
  .logo__mark {
    block-size: calc(var(--logo-size) * 1.16);
    inline-size: auto;
    aspect-ratio: 800 / 990;
    flex: none;
  }
  .logo__word {
    block-size: calc(var(--logo-size) * 0.80);
    inline-size: auto;
    aspect-ratio: 1648 / 560;
    flex: none;
  }
</style>
