---
/* Ambient scribe — a clinician-side surface, not a phone. And a 6s film.

   The phone belongs to the patient. Intake is the only patient-facing step in
   this section; the scribe runs in the room while the clinician works, so it is
   drawn as a desk surface with a live transcript feeding a drafting note.

   What is worth showing is not "AI writes your note" — that is table stakes. It
   is that each drafted line stays ATTACHED to the utterance that produced it,
   so the clinician can check the source instead of trusting a summary. The two
   planes are wired together visually: the spoken line on the left carries the
   same accent as the sentence it produced on the right.

   Neumorphic rules per materials.css: light from directly above so every offset
   is Y-only, warm taupe shade, contrast in the 4-18% band, blur 2-3x the
   offset, real hairline on every surface.

   ══ THE CLIP ══════════════════════════════════════════════════════════════
   12.0s, five beats of 2.4s, narrated by the caption rail.

     beat 1   0.0s   room mic live, transcript empty, note empty
     beat 2   2.4s   the exchange lands, line by line
     beat 3   4.8s   the first clause is drafted from what was already said
     beat 4   7.2s   "worse when lying flat" writes itself, and the spoken line
                     it came from brightens at the same instant. That link is
                     the product; the clip is built around this beat.
     beat 5   9.6s   the note is ready for a human to read and sign
     11.5s           dissolve; 100% equals 0% so the loop has no seam
   */
import ClipCaption from './ClipCaption.astro';

const CAPTIONS = [
  'Talk to your patient. Nothing to open, nothing to click.',
  'The room transcribes itself as you go.',
  'The note drafts from what was actually said.',
  'Every clause stays wired to the moment it came from.',
  'You read it, you sign it. Never the other way round.',
];
---

<div class="scb" data-clip>
  <div class="scb__head">
    <span class="scb__live" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
    <span class="scb__title">Listening in the room</span>
    <span class="scb__time" aria-hidden="true">04:1<span class="scb__tick"><span class="scb__strip"><i>3</i><i>4</i><i>5</i><i>6</i><i>7</i><i>8</i></span></span></span>
  </div>

  <div class="scb__panes">
    <div class="scb__said">
      <p class="scb__label">What was said</p>
      <p class="scb__line scb__line--a"><b>Clinician</b>Does anything make it worse?</p>
      <p class="scb__line scb__line--src"><b>Patient</b>It gets worse when I lie down flat.</p>
      <p class="scb__line scb__line--c"><b>Clinician</b>Any fever or fainting?</p>
      <p class="scb__line scb__line--d"><b>Patient</b>No, neither.</p>
    </div>

    <div class="scb__note">
      <div class="scb__note-head">
        <span>Visit note</span>
        <span class="scb__state">Drafting</span>
      </div>
      <div class="scb__notebed">
        <p class="scb__idle" aria-hidden="true">
          Nothing to type. The note drafts from the room.
        </p>

        <div class="scb__drafted">
          <p class="scb__body"
            ><span class="scb__ph scb__ph--a">Substernal chest tightness with exertional dyspnoea, </span
            ><span class="scb__ph scb__ph--b"><span class="scb__cited">worse when lying flat</span>. </span
            ><span class="scb__ph scb__ph--c">No fever, no syncope.</span
          ></p>
          <p class="scb__attr">Every line traces back to the moment it came from.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="scb__tray">
    <span class="scb__forms"><b>24</b> letters and forms filled from the chart</span>
    <span class="scb__sign">Sign &amp; send</span>
  </div>

  <ClipCaption steps={CAPTIONS} />
</div>

<style>
  .scb {
    --clip-dur: 5.8s;
    inline-size: 100%;
    display: flex;
    flex-direction: column;
    gap: 3.4cqw;
    padding: 5.5cqw;
    border-radius: var(--radius-6x);
    background: linear-gradient(180deg, var(--neutral-5) 0%, var(--neutral-10) 100%);
    border: 1px solid rgb(from var(--neutral-40) r g b / 0.28);
    box-shadow:
      inset 0 1px 0 rgb(from var(--white) r g b / 0.9),
      0 1px 2px rgb(from var(--neutral-40) r g b / 0.14),
      0 10px 24px rgb(from var(--neutral-40) r g b / 0.16);
    color: var(--neutral-100);
  }

  .scb__head { display: flex; align-items: center; gap: 2.6cqw; }
  /* A room-level readout: thin bars, height-modulated. */
  .scb__live { display: flex; align-items: center; gap: 1cqw; block-size: 5.4cqw; flex: none; }
  .scb__live i {
    /* Thin. At 0.9cqw against a 5cqw well the short bars were nearly square and
       started reading as a row of dots, which is the one thing this must not
       look like. */
    inline-size: 0.6cqw; border-radius: 0.3cqw;
    background-color: var(--solace-60);
    block-size: var(--h);
  }
  .scb__live i:nth-child(1) { --h: 36%; --l: 78% } .scb__live i:nth-child(2) { --h: 72%; --l: 30% }
  .scb__live i:nth-child(3) { --h: 96%; --l: 42% } .scb__live i:nth-child(4) { --h: 54%; --l: 88% }
  .scb__live i:nth-child(5) { --h: 84%; --l: 34% } .scb__live i:nth-child(6) { --h: 42%; --l: 80% }
  .scb__live i:nth-child(7) { --h: 68%; --l: 26% } .scb__live i:nth-child(8) { --h: 30%; --l: 66% }
  .scb__title { font-size: 3.4cqw; font-weight: var(--font-weight-medium); }
  /* line-height 1 on all three of these is load-bearing. An overflow-hidden
     inline-block takes its baseline from its bottom margin edge, so the window
     only sits on the text baseline if its box and the surrounding line box are
     the same height. Any mismatch drops the rolling digit below its neighbours,
     which is exactly what it did at 1.3em inside a 1.5 line box. */
  .scb__time {
    margin-inline-start: auto;
    font-size: 3.1cqw;
    line-height: 1;
    color: var(--neutral-60);
    font-variant-numeric: tabular-nums;
  }
  .scb__tick { display: inline-block; block-size: 1em; overflow: hidden; vertical-align: bottom; }
  .scb__strip { display: block; translate: 0 -83.333%; }
  .scb__strip i { display: block; block-size: 1em; line-height: 1; font-style: normal; }

  .scb__panes { display: grid; gap: 3cqw; }
  @container (min-width: 420px) { .scb__panes { grid-template-columns: 0.85fr 1fr; align-items: start; } }

  /* Pressed in: the transcript is incoming, not authored. */
  .scb__said {
    display: flex; flex-direction: column; gap: 2cqw;
    padding: 3.6cqw 3.8cqw;
    border-radius: var(--radius-3x);
    background-color: var(--neutral-10);
    border: 1px solid rgb(from var(--neutral-40) r g b / 0.18);
    box-shadow:
      inset 0 2px 4px rgb(from var(--neutral-40) r g b / 0.20),
      inset 0 -1px 0 rgb(from var(--white) r g b / 0.7);
  }
  .scb__label { font-size: 3cqw; color: var(--neutral-80); }
  .scb__line { font-size: 3.1cqw; line-height: 1.4; color: var(--neutral-90); }
  .scb__line b {
    display: block;
    font-size: 2.8cqw;
    font-weight: var(--font-weight-medium);
    color: var(--neutral-80);
  }
  /* Shares the accent with the sentence it produced, which is the whole link. */
  .scb__line--src {
    margin-inline: -1.6cqw;
    padding: 1.6cqw;
    border-radius: var(--radius-2x);
    border-inline-start: 0.8cqw solid var(--solace-40);
    background-color: var(--white);
    color: var(--neutral-100);
    box-shadow: 0 1px 2px rgb(from var(--neutral-40) r g b / 0.10);
  }

  /* Raised: the note is the artefact being made. */
  .scb__note {
    display: flex; flex-direction: column; gap: 2.6cqw;
    padding: 4cqw 4.2cqw;
    border-radius: var(--radius-3x);
    background-color: var(--white);
    border: 1px solid rgb(from var(--neutral-40) r g b / 0.20);
    box-shadow:
      0 1px 2px rgb(from var(--neutral-40) r g b / 0.10),
      0 8px 20px rgb(from var(--neutral-40) r g b / 0.14);
  }
  .scb__note-head { display: flex; align-items: center; gap: 2.4cqw; font-size: 3.3cqw; font-weight: var(--font-weight-medium); }
  .scb__state {
    margin-inline-start: auto;
    padding: 0.9cqw 2.4cqw;
    border-radius: 100px;
    background-color: var(--white);
    border: 1px solid rgb(from var(--neutral-40) r g b / 0.22);
    color: var(--solace-80);
    font-size: 2.7cqw;
  }
  /* The empty note and the drafted note share one cell, so the pane is never a
     reserved white rectangle waiting two seconds for its first word. */
  .scb__notebed { display: grid; flex: 1; }
  .scb__notebed > * { grid-area: 1 / 1; }
  .scb__drafted { display: flex; flex-direction: column; gap: 2.6cqw; }
  .scb__idle {
    align-self: center;
    justify-self: center;
    max-inline-size: 26ch;
    text-align: center;
    font-size: 3.1cqw;
    line-height: 1.5;
    color: var(--neutral-60);
    opacity: 0;
  }

  .scb__body { font-size: 3.3cqw; line-height: 1.58; color: var(--neutral-90); }
  /* .scb__ph carries no styling of its own on purpose. The phrases stay in
     flow while hidden, so the paragraph never reflows as it fills — the note
     grows by inking in, not by pushing lines around. */
  /* Cited text is marked the way a person marks text: a rule under it. A
     filled block behind the words is the tell of a template. */
  .scb__cited {
    border-block-end: 0.55cqw solid var(--solace-50);
    padding-block-end: 0.3cqw;
    font-weight: var(--font-weight-medium);
  }
  .scb__attr { font-size: 3cqw; color: var(--neutral-80); }

  .scb__tray {
    display: flex; align-items: center; gap: 3cqw;
    padding-block-start: 3.2cqw;
    border-block-start: 1px solid rgb(from var(--neutral-40) r g b / 0.22);
    font-size: 3.1cqw;
    color: var(--neutral-80);
  }
  .scb__forms b { color: var(--solace-80); font-weight: var(--font-weight-semibold); font-size: 4cqw; }
  .scb__sign {
    margin-inline-start: auto;
    padding: 2.2cqw 3.6cqw;
    border-radius: var(--radius-2x);
    background: linear-gradient(180deg, var(--solace-60) 0%, var(--solace-80) 100%);
    border: 1px solid var(--solace-90);
    color: var(--white);
    font-size: 3cqw;
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgb(from var(--white) r g b / 0.28),
      0 2px 5px rgb(from var(--solace-100) r g b / 0.24);
  }

  /* ══ CLIP ═══════════════════════════════════════════════════════════════
     Five beats of 2.4s on the shared grid. The pivot is beat 4: the spoken line
     and the clause it produced light up TOGETHER, which is the only way to show
     a link rather than assert one. */
  @keyframes scribe-said-a {
    0%, 21%  { opacity: 0; translate: 0 1.4cqw; }
    26%, 96% { opacity: 1; translate: 0 0; }
    100%     { opacity: 0; translate: 0 1.4cqw; }
  }
  /* Arrives in beat 2, then brightens again in beat 4 when its clause lands in
     the note. Two events, one element, one rail. */
  @keyframes scribe-said-src {
    0%, 26%  { opacity: 0; translate: 0 1.4cqw; border-inline-start-color: var(--neutral-20); }
    31%      { opacity: 1; translate: 0 0; border-inline-start-color: var(--neutral-20); }
    62%      { border-inline-start-color: var(--neutral-20); }
    67%, 96% { opacity: 1; translate: 0 0; border-inline-start-color: var(--solace-50); }
    100%     { opacity: 0; translate: 0 1.4cqw; border-inline-start-color: var(--neutral-20); }
  }
  @keyframes scribe-said-c {
    0%, 31%  { opacity: 0; translate: 0 1.4cqw; }
    36%, 96% { opacity: 1; translate: 0 0; }
    100%     { opacity: 0; translate: 0 1.4cqw; }
  }
  @keyframes scribe-said-d {
    0%, 35%  { opacity: 0; translate: 0 1.4cqw; }
    40%, 96% { opacity: 1; translate: 0 0; }
    100%     { opacity: 0; translate: 0 1.4cqw; }
  }
  @keyframes scribe-idle {
    0%, 40%  { opacity: 1; }
    44%, 96% { opacity: 0; animation-timing-function: steps(1, end); }
    100%     { opacity: 1; }
  }
  /* Beat 3 inks the note. Ink, not slide: a drafted clause appears where it
     belongs rather than flying in from somewhere. */
  @keyframes scribe-ink-a {
    0%, 43%  { opacity: 0; filter: blur(2px); }
    49%, 96% { opacity: 1; filter: blur(0); }
    100%     { opacity: 0; filter: blur(2px); }
  }
  @keyframes scribe-ink-b {
    0%, 62%  { opacity: 0; filter: blur(2px); }
    68%, 96% { opacity: 1; filter: blur(0); }
    100%     { opacity: 0; filter: blur(2px); }
  }
  @keyframes scribe-ink-c {
    0%, 52%  { opacity: 0; filter: blur(2px); }
    58%, 96% { opacity: 1; filter: blur(0); }
    100%     { opacity: 0; filter: blur(2px); }
  }
  @keyframes scribe-attr {
    0%, 70%  { opacity: 0; }
    76%, 96% { opacity: 1; }
    100%     { opacity: 0; }
  }
  /* Beat 5. The button settles into a ready state and stays there. It does not
     throb; a control that pulses forever is asking for attention it has not
     earned. */
  @keyframes scribe-ready {
    0%, 82%  { box-shadow: inset 0 1px 0 rgb(from var(--white) r g b / 0.28),
                           0 2px 5px rgb(from var(--solace-100) r g b / 0.24),
                           0 0 0 0 rgb(from var(--solace-40) r g b / 0); }
    89%, 96% { box-shadow: inset 0 1px 0 rgb(from var(--white) r g b / 0.28),
                           0 2px 5px rgb(from var(--solace-100) r g b / 0.24),
                           0 0 0 0.9cqw rgb(from var(--solace-40) r g b / 0.34); }
    100%     { box-shadow: inset 0 1px 0 rgb(from var(--white) r g b / 0.28),
                           0 2px 5px rgb(from var(--solace-100) r g b / 0.24),
                           0 0 0 0 rgb(from var(--solace-40) r g b / 0); }
  }
  @keyframes scribe-timer {
    from { translate: 0 0; }
    to   { translate: 0 -83.333%; }
  }
  /* Off the master timeline on purpose: speech is not on the beat, and a 12s
     waveform would read as decoration rather than as a level meter. */
  @keyframes scribe-level {
    0%, 100% { block-size: var(--h); }
    50%      { block-size: var(--l); }
  }

  .scb[data-play] .scb__line--a   { animation: scribe-said-a   var(--clip-dur) var(--ease-hero) infinite both; }
  .scb[data-play] .scb__line--src { animation: scribe-said-src var(--clip-dur) var(--ease-hero) infinite both; }
  .scb[data-play] .scb__line--c   { animation: scribe-said-c   var(--clip-dur) var(--ease-hero) infinite both; }
  .scb[data-play] .scb__line--d   { animation: scribe-said-d   var(--clip-dur) var(--ease-hero) infinite both; }
  .scb[data-play] .scb__idle      { animation: scribe-idle     var(--clip-dur) var(--ease-ui)   infinite both; }
  .scb[data-play] .scb__ph--a     { animation: scribe-ink-a    var(--clip-dur) var(--ease-ui)   infinite both; }
  .scb[data-play] .scb__ph--b     { animation: scribe-ink-b    var(--clip-dur) var(--ease-ui)   infinite both; }
  .scb[data-play] .scb__ph--c     { animation: scribe-ink-c    var(--clip-dur) var(--ease-ui)   infinite both; }
  .scb[data-play] .scb__attr      { animation: scribe-attr     var(--clip-dur) var(--ease-ui)   infinite both; }
  .scb[data-play] .scb__sign      { animation: scribe-ready    var(--clip-dur) var(--ease-ui)   infinite both; }
  .scb[data-play] .scb__strip     { animation: scribe-timer    var(--clip-dur) steps(6, jump-none) infinite both; }
  .scb[data-play] .scb__live i    { animation: scribe-level var(--_p) ease-in-out infinite alternate; }
  .scb[data-play] .scb__live i:nth-child(4n + 1) { --_p: 640ms; }
  .scb[data-play] .scb__live i:nth-child(4n + 2) { --_p: 820ms; }
  .scb[data-play] .scb__live i:nth-child(4n + 3) { --_p: 560ms; }
  .scb[data-play] .scb__live i:nth-child(4n + 4) { --_p: 720ms; }
</style>
