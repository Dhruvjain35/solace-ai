---
/* Triage, as a layered composition rather than a screenshot — and as a 6s film.

   Almost every triage model outputs a number. Two things here are not standard,
   and they are what the graphic is built around:

     1. The reasons travel WITH the score. The evidence is not buried behind a
        "why?" link — it is stacked directly behind the score card, physically.
     2. The safety rule is ASYMMETRIC. Bedside vitals can raise urgency and are
        structurally unable to lower it. That is a design property, not a
        promise, so it gets its own object in the frame.

   Layering is honest depth: each plane is a real element on the neumorphic
   plinth with its own contact shadow, not a drop-shadow on a flat picture.

   ══ THE CLIP ══════════════════════════════════════════════════════════════
   6.0s. The film exists to show the one thing a still frame cannot: the score
   CHANGING, and why. A static "2" is a claim. A 3 that becomes a 2 the moment a
   saturation reading lands is the mechanism.

     0.00s   the card reads 3 — Urgent, see within 30 minutes
     0.36s   contributing evidence fills in, strongest first
     1.20s   the reasons arrive one at a time, under the score
     2.52s   the saturation row flashes: this reading just came off the monitor
     3.00s   the safety gate rises into frame
     3.24s   3 flips to 2, amber to red, and the wait window halves
     3.90s   hold
     5.52s   dissolve back to the opening frame — 100% equals 0%, no seam */
---

<div class="gfx" data-clip>
  <div class="gfx__stack">
    <div class="gfx__evidence" aria-hidden="true">
      <span class="gfx__evidence-label">Contributing evidence</span>
      <span class="gfx__bar gfx__bar--a"><i style="--w:86%"></i></span>
      <span class="gfx__bar gfx__bar--b"><i style="--w:64%"></i></span>
      <span class="gfx__bar gfx__bar--c"><i style="--w:41%"></i></span>
    </div>

    <div class="gfx__card">
      <div class="gfx__card-head">
        <span class="gfx__card-title">Suggested priority</span>
        <span class="gfx__card-note">Reyes, M.</span>
      </div>

      <div class="gfx__level">
        <span class="gfx__level-n">
          <span class="gfx__level-strip"><i>3</i><i>2</i></span>
        </span>
        <span class="gfx__level-t">
          <span class="gfx__lv gfx__lv--now">
            <b>High</b>
            <i>Emergent &mdash; see within 10 minutes</i>
          </span>
          <span class="gfx__lv gfx__lv--was" aria-hidden="true">
            <b>Urgent</b>
            <i>See within 30 minutes</i>
          </span>
        </span>
      </div>

      <ul class="gfx__why">
        <li class="gfx__why--a"><span>Respiratory rate 24</span><em>Strong</em></li>
        <li class="gfx__why--b"><span>SpO&#8322; 93% on room air</span><em>Strong</em></li>
        <li class="gfx__why--c"><span>Two prior visits, same complaint</span><em>Moderate</em></li>
      </ul>
    </div>

    <div class="gfx__gate">
      <span class="gfx__gate-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none"><path d="M8 13V3.6M4.4 7.2 8 3.6l3.6 3.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="gfx__gate-text">
        <b>Raised 3 &rarr; 2</b>
        <i>Bedside vitals can raise urgency. The rule cannot lower it.</i>
      </span>
    </div>
  </div>
</div>

<style>
  .gfx {
    --clip-dur: 6s;
    inline-size: 100%;
    padding: 7cqw 6cqw 8cqw;
    border-radius: var(--radius-6x);
    /* Neumorphic plinth: light from directly above, warm taupe shade, hairline
       so the shape survives forced-colors. Per the rules in materials.css. */
    background: linear-gradient(180deg, var(--neutral-5) 0%, var(--neutral-10) 100%);
    border: 1px solid rgb(from var(--neutral-40) r g b / 0.28);
    box-shadow:
      inset 0 1px 0 rgb(from var(--white) r g b / 0.9),
      0 1px 2px rgb(from var(--neutral-40) r g b / 0.14),
      0 10px 24px rgb(from var(--neutral-40) r g b / 0.16);
  }

  .gfx__stack { position: relative; display: grid; }

  /* Plane 1 — evidence, sitting behind and above the score. */
  .gfx__evidence {
    position: relative;
    z-index: 1;
    inline-size: 74%;
    margin-inline-start: auto;
    display: flex; flex-direction: column; gap: 2cqw;
    padding: 4cqw 5cqw 6cqw;
    border-radius: var(--radius-4x) var(--radius-4x) 0 0;
    background-color: var(--white);
    border: 1px solid rgb(from var(--neutral-40) r g b / 0.20);
    border-block-end: none;
    box-shadow: 0 -1px 2px rgb(from var(--neutral-40) r g b / 0.08);
  }
  .gfx__evidence-label { font-size: 3.1cqw; color: var(--neutral-60); }
  .gfx__bar { display: block; block-size: 1.6cqw; border-radius: 100px; background-color: var(--neutral-10); }
  .gfx__bar i { display: block; block-size: 100%; inline-size: var(--w); border-radius: 100px; background-color: var(--red-30); }
  .gfx__bar--c i { background-color: var(--neutral-30); }

  /* Plane 2 — the score itself, lifted forward. */
  .gfx__card {
    position: relative;
    z-index: 2;
    margin-block-start: -3cqw;
    display: flex; flex-direction: column; gap: 4cqw;
    padding: 5cqw;
    border-radius: var(--radius-4x);
    background-color: var(--white);
    border: 1px solid rgb(from var(--neutral-40) r g b / 0.24);
    box-shadow:
      0 1px 2px rgb(from var(--neutral-40) r g b / 0.12),
      0 12px 28px rgb(from var(--neutral-40) r g b / 0.18);
  }
  .gfx__card-head { display: flex; align-items: baseline; gap: 3cqw; }
  .gfx__card-title { font-size: 3.6cqw; font-weight: var(--font-weight-medium); color: var(--neutral-90); }
  .gfx__card-note { margin-inline-start: auto; font-size: 3.2cqw; color: var(--neutral-60); }

  .gfx__level { display: flex; align-items: center; gap: 4cqw; }
  .gfx__level-n {
    position: relative;
    overflow: hidden;
    inline-size: 13cqw; block-size: 13cqw;
    flex: none;
    border-radius: var(--radius-3x);
    /* ESI 2 is high acuity. Green read as "all clear", which is the opposite of
       what this number means. */
    background: linear-gradient(180deg, var(--red-40) 0%, var(--red-80) 100%);
    color: var(--white);
    box-shadow: inset 0 1px 0 rgb(from var(--white) r g b / 0.32);
  }
  /* The amber the tile wore as a 3, crossfaded out rather than interpolated —
     two gradients cannot tween, but their opacities can. */
  .gfx__level-n::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--orange-30) 0%, var(--orange-80) 100%);
    opacity: 0;
  }
  .gfx__level-strip {
    position: relative;
    display: block;
    translate: 0 -50%;
  }
  .gfx__level-strip i {
    display: grid;
    place-items: center;
    block-size: 13cqw;
    font-style: normal;
    font-size: 7cqw;
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.04em;
  }

  .gfx__level-t { display: grid; }
  .gfx__lv { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 0.6cqw; }
  .gfx__lv b { font-size: 5.2cqw; font-weight: var(--font-weight-semibold); letter-spacing: -0.03em; }
  .gfx__lv i { font-style: normal; font-size: 3.3cqw; color: var(--neutral-60); }
  .gfx__lv--was { opacity: 0; }

  .gfx__why { margin: 0; padding: 0; list-style: none; display: grid; gap: 0; }
  .gfx__why li {
    display: flex; align-items: center; gap: 3cqw;
    padding-block: 2.4cqw;
    padding-inline: 2cqw;
    margin-inline: -2cqw;
    border-radius: var(--radius-2x);
    border-block-start: 1px solid var(--neutral-10);
    font-size: 3.4cqw;
    color: var(--neutral-90);
  }
  .gfx__why em {
    margin-inline-start: auto;
    font-style: normal;
    font-size: 3cqw;
    color: var(--neutral-60);
  }
  .gfx__why--a em, .gfx__why--b em { color: var(--red-60); }

  /* Plane 3 — the asymmetric safety rule, offset forward and left so it reads
     as a separate mechanism rather than another row of the card. */
  .gfx__gate {
    position: relative;
    z-index: 3;
    inline-size: 84%;
    margin-block-start: -2.5cqw;
    display: flex; align-items: center; gap: 3cqw;
    padding: 3.6cqw 4.4cqw;
    border-radius: var(--radius-3x);
    background: linear-gradient(180deg, var(--solace-100) 0%, #052a21 100%);
    color: var(--white);
    box-shadow:
      inset 0 1px 0 rgb(from var(--white) r g b / 0.14),
      0 10px 22px rgb(from var(--solace-100) r g b / 0.30);
  }
  .gfx__gate-icon {
    display: grid; place-items: center;
    inline-size: 7cqw; block-size: 7cqw; flex: none;
    border-radius: 100px;
    background-color: rgb(from var(--solace-30) r g b / 0.22);
    color: var(--solace-20);
  }
  .gfx__gate-icon svg { inline-size: 4cqw; block-size: 4cqw; }
  .gfx__gate-text { display: flex; flex-direction: column; gap: 0.4cqw; }
  .gfx__gate-text b { font-size: 3.5cqw; font-weight: var(--font-weight-medium); }
  .gfx__gate-text i { font-style: normal; font-size: 3cqw; color: rgb(from var(--white) r g b / 0.68); }

  /* ══ CLIP ═══════════════════════════════════════════════════════════════
     One 6s timeline shared by every rule, so the percentages below are the
     beat sheet at the top of this file. */
  /* Three near-identical blocks rather than one parameterised by a custom
     property: keyframe selectors are literal offsets and cannot take var(),
     so the stagger has to be written out. */
  @keyframes triage-fill-a {
    0%, 5%   { inline-size: 0%; }
    17%, 92% { inline-size: var(--w); }
    100%     { inline-size: 0%; }
  }
  @keyframes triage-fill-b {
    0%, 9%   { inline-size: 0%; }
    21%, 92% { inline-size: var(--w); }
    100%     { inline-size: 0%; }
  }
  @keyframes triage-fill-c {
    0%, 13%  { inline-size: 0%; }
    25%, 92% { inline-size: var(--w); }
    100%     { inline-size: 0%; }
  }
  /* The rows come in while the bars are still filling. Held any later and the
     card sits on a second of empty white, which reads as a rendering fault
     rather than as a pause. */
  @keyframes triage-row {
    0%, 12%  { opacity: 0; translate: 0 1.6cqw; }
    18%, 92% { opacity: 1; translate: 0 0; }
    100%     { opacity: 0; translate: 0 1.6cqw; }
  }
  @keyframes triage-row-b {
    0%, 18%  { opacity: 0; translate: 0 1.6cqw; background-color: transparent; }
    26%      { opacity: 1; translate: 0 0; background-color: transparent; }
    /* The reading lands. A single wash, not a repeating pulse. */
    40%      { background-color: var(--red-0); }
    48%, 92% { opacity: 1; translate: 0 0; background-color: transparent; }
    100%     { opacity: 0; translate: 0 1.6cqw; background-color: transparent; }
  }
  @keyframes triage-row-c {
    0%, 24%  { opacity: 0; translate: 0 1.6cqw; }
    30%, 92% { opacity: 1; translate: 0 0; }
    100%     { opacity: 0; translate: 0 1.6cqw; }
  }
  /* 3 -> 2. The strip's resting place is the second digit, so the from-frame
     has to be written out or it would copy the end and never travel. */
  @keyframes triage-flip {
    0%, 52%  { translate: 0 0; }
    58%, 93% { translate: 0 -50%; animation-timing-function: steps(1, end); }
    100%     { translate: 0 0; }
  }
  @keyframes triage-amber {
    0%, 52%  { opacity: 1; }
    58%, 93% { opacity: 0; animation-timing-function: steps(1, end); }
    100%     { opacity: 1; }
  }
  /* Sequential, never overlapping. Crossfading two different words stacked on
     one another gives you a third word that is neither — "Urgent" ghosting
     through "High" — which is exactly what this looked like before. The old
     label is fully gone before the new one starts. */
  @keyframes triage-was {
    0%, 52%  { opacity: 1; }
    55%, 93% { opacity: 0; animation-timing-function: steps(1, end); }
    100%     { opacity: 1; }
  }
  @keyframes triage-now {
    0%, 55%  { opacity: 0; }
    58%, 93% { opacity: 1; animation-timing-function: steps(1, end); }
    100%     { opacity: 0; }
  }
  @keyframes triage-gate {
    0%, 48%  { opacity: 0; translate: 0 3cqw; }
    56%, 92% { opacity: 1; translate: 0 0; }
    100%     { opacity: 0; translate: 0 3cqw; }
  }

  /* Each bar owns its in-point, so the evidence resolves strongest-first
     instead of three bars growing in lockstep. */
  .gfx[data-play] .gfx__bar--a i { animation: triage-fill-a var(--clip-dur) var(--ease-hero) infinite both; }
  .gfx[data-play] .gfx__bar--b i { animation: triage-fill-b var(--clip-dur) var(--ease-hero) infinite both; }
  .gfx[data-play] .gfx__bar--c i { animation: triage-fill-c var(--clip-dur) var(--ease-hero) infinite both; }

  .gfx[data-play] .gfx__why--a { animation: triage-row var(--clip-dur) var(--ease-hero) infinite both; }
  .gfx[data-play] .gfx__why--b { animation: triage-row-b var(--clip-dur) var(--ease-hero) infinite both; }
  .gfx[data-play] .gfx__why--c { animation: triage-row-c var(--clip-dur) var(--ease-hero) infinite both; }

  .gfx[data-play] .gfx__level-strip { animation: triage-flip var(--clip-dur) var(--ease-hero) infinite both; }
  .gfx[data-play] .gfx__level-n::before { animation: triage-amber var(--clip-dur) var(--ease-ui) infinite both; }
  .gfx[data-play] .gfx__lv--now { animation: triage-now var(--clip-dur) var(--ease-ui) infinite both; }
  .gfx[data-play] .gfx__lv--was { animation: triage-was var(--clip-dur) var(--ease-ui) infinite both; }
  .gfx[data-play] .gfx__gate { animation: triage-gate var(--clip-dur) var(--ease-hero) infinite both; }
</style>
