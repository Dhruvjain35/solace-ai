---
/* The small animated mark that sits inline at the end of a headline.

   It does the job the bullet list used to do. Four bullets under every heading
   was four more things to read before you got to the figure that was already
   explaining itself; the mark says which feature this is in the time it takes
   to glance at it, and then gets out of the way.

   Each one animates the single motion its graphic is built around — the level
   flipping, the queue re-sorting, the pen writing, the arrow landing. That is
   why they are worth having: a generic icon set would be decoration, but a mark
   that performs the same gesture as the figure beside it is a preview.

   Sized in em so it scales with whatever heading it lands in, and shifted onto
   the baseline rather than sitting on the line box, which is what stops it
   floating above the text.

   It carries data-clip, so the observer in Base.astro starts it on entry and
   drops it on exit like every other clip on the site. Nothing runs off screen.
*/
interface Props {
  kind:
    | 'intake' | 'triage' | 'queue' | 'workflow' | 'scribe'
    | 'atlas' | 'letters' | 'chart' | 'prebrief' | 'authority' | 'shift'
    | 'language' | 'confidence' | 'evidence' | 'hooks';
}
const { kind } = Astro.props;

/* Tone per mark. Red for the two that are about acuity, slate for the ones
   about records, brand green for everything else. */
const TONE: Record<string, string> = {
  triage: 'red', prebrief: 'red', confidence: 'red',
  chart: 'slate', atlas: 'slate', letters: 'slate', evidence: 'slate',
};
const tone = TONE[kind] ?? 'brand';
---

<span class:list={['gly', `gly--${tone}`, `gly--${kind}`]} data-clip aria-hidden="true">
  {kind === 'intake' && (
    <span class="gly__wave"><i></i><i></i><i></i><i></i><i></i></span>
  )}

  {(kind === 'triage' || kind === 'confidence') && (
    <span class="gly__win"><span class="gly__strip"><b>3</b><b>2</b></span></span>
  )}

  {(kind === 'queue' || kind === 'prebrief') && (
    <span class="gly__rows"><i class="gly__r1"></i><i class="gly__r2"></i><i class="gly__r3"></i></span>
  )}

  {(kind === 'workflow' || kind === 'hooks') && (
    <svg class="gly__svg gly__bolt" viewBox="0 0 24 24" fill="none">
      <path d="M13.4 2.6 5.6 13.4h5.2l-.6 8 7.8-10.8h-5.2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    </svg>
  )}

  {(kind === 'scribe' || kind === 'letters') && (
    <svg class="gly__svg" viewBox="0 0 24 24" fill="none">
      <path class="gly__ink" pathLength="1" d="M4 17.6c3.4-6 5.2-9 5.6-9 .6 0 .2 6.4.8 6.4.5 0 1.8-4.2 2.6-4.2.7 0 .3 4.6 1 4.6.6 0 2.2-3.2 4-5.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}

  {(kind === 'atlas' || kind === 'evidence') && (
    <svg class="gly__svg" viewBox="0 0 24 24" fill="none">
      <circle cx="10.6" cy="10.6" r="6.4" stroke="currentColor" stroke-width="2" />
      <path class="gly__reach" d="m15.4 15.4 4.4 4.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  )}

  {(kind === 'chart' || kind === 'shift') && (
    <svg class="gly__svg" viewBox="0 0 24 24" fill="none">
      <rect x="3.4" y="6" width="17.2" height="14.6" rx="3" stroke="currentColor" stroke-width="2" />
      <path class="gly__drop" d="M12 2.6v7.6m-3-3 3 3 3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}

  {(kind === 'authority' || kind === 'language') && (
    <svg class="gly__svg" viewBox="0 0 24 24" fill="none">
      <path class="gly__tick" pathLength="1" d="M4.4 12.6 9.6 18 19.6 6.4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
</span>

<style>
  .gly {
    display: inline-grid;
    place-items: center;
    inline-size: 0.92em;
    block-size: 0.92em;
    margin-inline-start: 0.24em;
    vertical-align: -0.1em;
    border-radius: 0.26em;
    color: var(--white);
    box-shadow:
      inset 0 1px 0 rgb(from var(--white) r g b / 0.26),
      0 1px 2px hsl(210 24% 34% / 14%),
      0 4px 10px hsl(210 24% 34% / 12%);
  }
  .gly--brand { background: linear-gradient(180deg, var(--solace-60) 0%, var(--solace-90) 100%); }
  .gly--red   { background: linear-gradient(180deg, var(--red-40) 0%, var(--red-80) 100%); }
  .gly--slate { background: linear-gradient(180deg, var(--slate-60) 0%, var(--slate-100) 100%); }

  .gly__svg { inline-size: 0.56em; block-size: 0.56em; }

  /* ── Intake: a level meter. Thin bars, never dots. ─────────────────────── */
  .gly__wave { display: flex; align-items: center; gap: 0.06em; block-size: 0.46em; }
  .gly__wave i { inline-size: 0.055em; border-radius: 0.03em; background-color: currentColor; block-size: var(--h); }
  .gly__wave i:nth-child(1) { --h: 40%; --l: 90%; }
  .gly__wave i:nth-child(2) { --h: 74%; --l: 34%; }
  .gly__wave i:nth-child(3) { --h: 96%; --l: 52%; }
  .gly__wave i:nth-child(4) { --h: 58%; --l: 92%; }
  .gly__wave i:nth-child(5) { --h: 34%; --l: 66%; }

  /* ── Triage: the digit flips, exactly as the figure does. ──────────────── */
  .gly__win { display: block; block-size: 0.6em; overflow: hidden; }
  .gly__strip { display: block; translate: 0 -50%; }
  .gly__strip b {
    display: grid;
    place-items: center;
    block-size: 0.6em;
    font-size: 0.52em;
    line-height: 1;
    font-weight: var(--font-weight-semibold);
  }

  /* ── Queue: three rows, and the bottom one travels to the top. ─────────── */
  .gly__rows { display: flex; flex-direction: column; gap: 0.08em; inline-size: 0.52em; }
  .gly__rows i { display: block; block-size: 0.09em; border-radius: 0.05em; background-color: currentColor; }
  .gly__r2 { opacity: 0.66; }
  .gly__r3 { opacity: 0.4; }

  /* ══ MOTION ═════════════════════════════════════════════════════════════
     Each mark performs the gesture of the figure it introduces. Slow, once per
     cycle, and never a pulse. */
  @keyframes gly-level { 0%, 100% { block-size: var(--h); } 50% { block-size: var(--l); } }
  @keyframes gly-flip  { 0%, 44% { translate: 0 0; } 56%, 96% { translate: 0 -50%; animation-timing-function: steps(1, end); } 100% { translate: 0 0; } }
  @keyframes gly-lift  { 0%, 40% { translate: 0 0; opacity: 0.4; } 58%, 96% { translate: 0 -0.34em; opacity: 1; animation-timing-function: steps(1, end); } 100% { translate: 0 0; opacity: 0.4; } }
  @keyframes gly-sink  { 0%, 40% { translate: 0 0; } 58%, 96% { translate: 0 0.17em; animation-timing-function: steps(1, end); } 100% { translate: 0 0; } }
  @keyframes gly-draw  { 0%, 12% { stroke-dashoffset: 1; } 62%, 92% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 1; } }
  @keyframes gly-reach { 0%, 30% { translate: 0 0; } 50% { translate: 0.1em 0.1em; } 72%, 100% { translate: 0 0; } }
  @keyframes gly-drop  { 0%, 24% { translate: 0 -0.12em; opacity: 0.5; } 46%, 88% { translate: 0 0; opacity: 1; } 100% { translate: 0 -0.12em; opacity: 0.5; } }
  @keyframes gly-tilt  { 0%, 100% { rotate: 0deg; } 46% { rotate: -7deg; } }

  .gly[data-play] .gly__wave i { animation: gly-level var(--_p) ease-in-out infinite alternate; }
  .gly[data-play] .gly__wave i:nth-child(1) { --_p: 620ms; }
  .gly[data-play] .gly__wave i:nth-child(2) { --_p: 780ms; }
  .gly[data-play] .gly__wave i:nth-child(3) { --_p: 540ms; }
  .gly[data-play] .gly__wave i:nth-child(4) { --_p: 700ms; }
  .gly[data-play] .gly__wave i:nth-child(5) { --_p: 860ms; }

  .gly[data-play] .gly__strip { animation: gly-flip 3.4s var(--ease-hero) infinite; }
  .gly[data-play] .gly__r3    { animation: gly-lift 3.4s var(--ease-hero) infinite; }
  .gly[data-play] .gly__r1,
  .gly[data-play] .gly__r2    { animation: gly-sink 3.4s var(--ease-hero) infinite; }
  .gly[data-play] .gly__ink   { stroke-dasharray: 1; animation: gly-draw 3.6s var(--ease-ui) infinite; }
  .gly[data-play] .gly__tick  { stroke-dasharray: 1; animation: gly-draw 3.2s var(--ease-ui) infinite; }
  .gly[data-play] .gly__reach { animation: gly-reach 3.4s var(--ease-hero) infinite; }
  .gly[data-play] .gly__drop  { animation: gly-drop 3.2s var(--ease-hero) infinite; }
  .gly[data-play].gly--workflow .gly__bolt,
  .gly[data-play].gly--hooks .gly__bolt { animation: gly-tilt 3s var(--ease-hero) infinite; }
</style>
