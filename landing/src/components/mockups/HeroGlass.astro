---
/* The hero composition. Light glass: a tinted panel with white cards on it.

   Rebuilt to the Superhuman/Aave idiom. The previous version was dark glass
   fragments scattered over two blurred squares, and the squares were the
   problem — a soft rounded blob behind a card is decoration pretending to be
   depth, and it goes muddy the moment anything overlaps it.

   This has no blobs. The panel is the field, the cards are white and opaque,
   and the depth is a real drop shadow. The list runs off the top and bottom
   edges behind ghosted rows, which is what tells you it is a window onto
   something longer rather than five items somebody arranged.

   Motion: the stack advances by one row on a slow cycle, so the composition is
   doing the thing the product does rather than floating for its own sake.
   Nothing fades in on load — every element is present in the first frame.
*/
interface Props {
  /** Which set of rows to show. The two share nothing, because no figure on
      this site appears twice. */
  variant?: 'board' | 'intake';
}
const { variant = 'board' } = Astro.props;

const SETS = {
  board: {
    lead: 'Waiting now',
    rows: [
      { key: 'Bell, R.', mark: '4', tone: 'calm', meta: '31m', ghost: true, lift: false },
      { key: 'Vance, T.', mark: '3', tone: 'amber', meta: '14m', ghost: false, lift: false },
      { key: 'Okonkwo, D.', mark: '2', tone: 'red', meta: '22m', ghost: false, lift: true },
      { key: 'Reyes, M.', mark: '2', tone: 'red', meta: '6m', ghost: false, lift: false },
      { key: 'Sato, K.', mark: '3', tone: 'amber', meta: '9m', ghost: true, lift: false },
    ],
    flag: 'Raised to 2. A new reading just landed.',
  },
  intake: {
    lead: 'Checking in now',
    rows: [
      { key: 'Kreyòl', mark: 'HT', tone: 'lang', meta: '7s', ghost: true, lift: false },
      { key: 'Español', mark: 'ES', tone: 'lang', meta: '6s', ghost: false, lift: false },
      { key: 'Tagalog', mark: 'TL', tone: 'lang', meta: '7s', ghost: false, lift: true },
      { key: 'Tiếng Việt', mark: 'VI', tone: 'lang', meta: '7s', ghost: false, lift: false },
      { key: '中文', mark: 'ZH', tone: 'lang', meta: '8s', ghost: true, lift: false },
    ],
    flag: 'Answered out loud, in the language they think in',
  },
};

const set = SETS[variant];
---

<div class="hg lglass" aria-hidden="true">
  <p class="hg__lead">{set.lead}</p>

  <div class="hg__stack">
    {set.rows.map((r) => (
      <div class:list={['hg__row', 'lglass-card', r.ghost && 'lglass-card--ghost', r.lift && 'hg__row--lift']}>
        <span class:list={['hg__mark', `hg__mark--${r.tone}`]}>{r.mark}</span>
        <span class="hg__key">{r.key}</span>
        <span class="hg__meta">{r.meta}</span>
      </div>
    ))}
  </div>

  <div class="hg__flag lglass-card lglass-card--pill">
    <span class="hg__flag-icon">
      <svg viewBox="0 0 16 16" fill="none"><path d="M8 12.8V3.8M4.6 7.2 8 3.8l3.4 3.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <span>{set.flag}</span>
  </div>
</div>

<style>
  .hg {
    inline-size: 100%;
    max-inline-size: 480px;
    padding: 6cqw 5cqw 13cqw;
    container-type: inline-size;
  }

  .hg__lead {
    padding-inline: 2cqw;
    padding-block-end: 3.4cqw;
    font-size: 3.2cqw;
    font-weight: var(--font-weight-medium);
    color: var(--neutral-80);
  }

  /* Clipped top and bottom, so it reads as a window onto something longer. */
  .hg__stack {
    display: flex;
    flex-direction: column;
    gap: 2.4cqw;
    mask-image: linear-gradient(180deg, transparent 2%, #000 20%, #000 82%, transparent 99%);
  }

  .hg__row { display: flex; align-items: center; gap: 3.2cqw; padding: 3.2cqw 3.6cqw; }
  /* One row is pulled forward — the one the flag is about. */
  .hg__row--lift {
    box-shadow:
      0 2px 4px hsl(210 24% 34% / 10%),
      0 14px 32px hsl(210 24% 34% / 14%);
  }

  .hg__mark {
    display: grid;
    place-items: center;
    inline-size: 8cqw;
    block-size: 8cqw;
    flex: none;
    border-radius: var(--radius-2x);
    font-size: 3.8cqw;
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.02em;
    color: var(--white);
  }
  .hg__mark--red   { background: linear-gradient(180deg, var(--red-40), var(--red-80)); }
  .hg__mark--amber { background: linear-gradient(180deg, var(--orange-30), var(--orange-80)); }
  .hg__mark--calm  { background: linear-gradient(180deg, var(--neutral-30), var(--neutral-60)); }
  .hg__mark--lang  { background: linear-gradient(180deg, var(--solace-60), var(--solace-90)); font-size: 3.1cqw; }

  .hg__key { font-size: 3.4cqw; font-weight: var(--font-weight-medium); color: var(--neutral-100); }
  .hg__meta {
    margin-inline-start: auto;
    font-size: 3cqw;
    color: var(--neutral-60);
    font-variant-numeric: tabular-nums;
  }

  /* The one element that overhangs the panel edge, which is what makes the
     panel read as a plane rather than as a box. */
  .hg__flag {
    position: absolute;
    inset-block-end: 4cqw;
    inset-inline: 7cqw;
    display: flex;
    align-items: center;
    gap: 2.6cqw;
    padding: 3.2cqw 4cqw;
    font-size: 3cqw;
    line-height: 1.3;
    color: var(--neutral-100);
    box-shadow:
      0 2px 6px hsl(210 24% 34% / 12%),
      0 18px 36px hsl(210 24% 34% / 16%);
  }
  .hg__flag-icon {
    display: grid;
    place-items: center;
    inline-size: 5.6cqw;
    block-size: 5.6cqw;
    flex: none;
    border-radius: var(--radius-full);
    background-color: var(--solace-80);
    color: var(--white);
  }
  .hg__flag-icon svg { inline-size: 3.4cqw; block-size: 3.4cqw; }

  /* ══ MOTION ═════════════════════════════════════════════════════════════
     The stack advances by one row and settles. The ghosts at either end are
     what keep the ends from popping as it moves. */
  @keyframes hg-advance {
    0%, 46%   { translate: 0 0; }
    56%, 100% { translate: 0 12.6cqw; }
  }
  @keyframes hg-flag {
    0%, 42%   { opacity: 1; translate: 0 0; }
    48%, 54%  { opacity: 0; translate: 0 1.6cqw; }
    62%, 100% { opacity: 1; translate: 0 0; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hg__stack { animation: hg-advance 7s var(--ease-hero) infinite; }
    .hg__flag  { animation: hg-flag 7s var(--ease-ui) infinite; }
  }
</style>
