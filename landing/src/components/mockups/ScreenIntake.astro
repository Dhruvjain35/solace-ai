---
/* Patient intake, as live DOM inside the phone aperture — and as a 6s film.

   What this has to communicate is the thing that is actually hard to copy:
   the patient tells their story ONCE, on their OWN phone, in their OWN
   language, with no app and no account — which is what removes the interpreter
   bottleneck from the front door. So the language control is the loudest thing
   on the screen and "No app. No account." is stated outright.

   Language names appear in their own script because that is how every real
   language picker on earth labels them; all interface chrome is English.

   Everything is sized in cqw against the aperture, so the whole screen scales
   with the device rather than needing a second layout per breakpoint.

   The status row straddles the Dynamic Island (3.5..12.3cqw down, 42.9%..73.6%
   across) exactly as iOS does, rather than starting beneath it — the screen now
   runs behind the island instead of reading as a rectangle parked under it.

   ══ THE CLIP ══════════════════════════════════════════════════════════════
   12.0s, five beats of 2.4s. The caption rail lives on the stage OUTSIDE the
   phone, because it narrates the act rather than being part of the app — which
   is also why this screen no longer carries data-clip itself and reads the
   attribute off whatever wraps it.

   The markup below IS the finished frame; the keyframes rewind it to the
   opening state and play forward. So no-JS, reduced-motion and print all get a
   complete screen.

     beat 1   0.0s   at rest. English selected, one question asked, nothing said.
     beat 2   2.4s   a thumb lands on Tagalog. The whole visit is now in their
                     language.
     beat 3   4.8s   they hold to speak; the meter is live, the timer runs, and
                     their answer arrives in their own words
     beat 4   7.2s   Solace reads it and asks the ONE follow-up that fits
     beat 5   9.6s   it reaches the care team before the patient does
     11.5s           everything transient dissolves and the pills revert, so
                     100% is pixel-identical to 0% and the loop has no seam
   */
import MarkPaths from '../brand/MarkPaths.astro';
import WordPaths from '../brand/WordPaths.astro';
---

<div class="scr">
  <div class="scr__bar">
    <span>9:41</span>
    <span class="scr__bar-right" aria-hidden="true">
      <svg viewBox="0 0 18 12" fill="none"><rect x="0" y="7" width="3" height="5" rx="1" fill="currentColor"/><rect x="5" y="5" width="3" height="7" rx="1" fill="currentColor"/><rect x="10" y="2.5" width="3" height="9.5" rx="1" fill="currentColor"/><rect x="15" y="0" width="3" height="12" rx="1" fill="currentColor" opacity=".35"/></svg>
      <svg viewBox="0 0 24 12" fill="none"><rect x="0.6" y="1.2" width="19" height="9.6" rx="3" stroke="currentColor" stroke-width="1.1"/><rect x="2.2" y="2.8" width="13" height="6.4" rx="1.6" fill="currentColor"/><path d="M21.4 4.6v2.8a2 2 0 0 0 0-2.8Z" fill="currentColor"/></svg>
    </span>
  </div>

  <div class="scr__head">
    <svg class="scr__mark" viewBox="0 0 800 990" fill="currentColor" aria-hidden="true"><MarkPaths /></svg>
    <svg class="scr__word" viewBox="0 0 1648 560" fill="currentColor" role="img" aria-label="Solace"><WordPaths /></svg>
    <span class="scr__step">Step 1 of 3</span>
  </div>

  <p class="scr__ask">Answer in whichever language is easiest.</p>

  <div class="scr__langs">
    <span class="scr__lang scr__lang--alt">English</span>
    <span class="scr__lang scr__lang--on">Tagalog</span>
    <span class="scr__lang">Español</span>
    <span class="scr__lang scr__lang--more">+17</span>
  </div>

  <div class="scr__thread">
    <p class="scr__q">What brought you in today?</p>
    <p class="scr__a">A tight chest since this morning, and it&rsquo;s hard to breathe.</p>
    <p class="scr__q scr__q--next">Does the tightness spread to your arm or jaw?</p>
    <p class="scr__follow">Follow-ups adapt to the answer. Usually two or three.</p>
  </div>

  <div class="scr__rec">
    <span class="scr__meter" aria-hidden="true">
      <i style="--h:34%"></i><i style="--h:70%"></i><i style="--h:96%"></i><i style="--h:52%"></i>
      <i style="--h:78%"></i><i style="--h:44%"></i><i style="--h:88%"></i><i style="--h:30%"></i>
      <i style="--h:62%"></i><i style="--h:40%"></i><i style="--h:74%"></i><i style="--h:26%"></i>
    </span>
    <span class="scr__time" aria-hidden="true">0:0<span class="scr__tick"><span class="scr__strip"><i>4</i><i>5</i><i>6</i><i>7</i><i>8</i><i>9</i></span></span></span>
  </div>

  <p class="scr__sent">
    <span class="scr__sent-tick" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none"><path d="M3 8.4 6.4 12 13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    Sent to your care team
  </p>

  <p class="scr__hint">Hold to speak, or type instead</p>

  <div class="scr__foot">
    <span>No app. No account.</span>
    <span>Nothing to install</span>
  </div>
</div>

<style>
  .scr {
    --clip-dur: 6.2s;
    inline-size: 100%;
    block-size: 100%;
    display: flex;
    flex-direction: column;
    gap: 3.2cqw;
    padding: 0 6cqw 5cqw;
    background: linear-gradient(180deg, var(--neutral-0) 0%, var(--neutral-5) 100%);
    color: var(--neutral-100);
    font-size: 5.4cqw;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  /* Straddles the island: 12.3cqw tall so its baseline centres on the island,
     with the time and indicators sitting either side of it. */
  .scr__bar {
    display: flex; align-items: center; justify-content: space-between;
    block-size: 12.3cqw;
    flex: none;
    font-size: 4.6cqw; font-weight: var(--font-weight-semibold);
  }
  .scr__bar-right { display: flex; align-items: center; gap: 1.6cqw; }
  .scr__bar-right svg { block-size: 3.6cqw; inline-size: auto; }

  .scr__head { display: flex; align-items: center; gap: 1.8cqw; margin-block-start: 1.4cqw; }
  /* Real brand artwork, not an approximation of it. */
  .scr__mark { block-size: 5.6cqw; inline-size: auto; color: var(--solace-80); }
  .scr__word { block-size: 3.6cqw; inline-size: auto; color: var(--neutral-100); }
  .scr__step { margin-inline-start: auto; font-size: 4.4cqw; color: var(--neutral-60); }

  .scr__ask { font-size: 7cqw; font-weight: var(--font-weight-medium); line-height: 1.25; letter-spacing: -0.02em; }

  /* The language control is the loudest element because it is the feature. */
  /* Sized so all four sit on one line at the narrowest device width the page
     renders. Wrapped, "+17" landed alone on a second row and read as a bug. */
  .scr__langs { display: flex; flex-wrap: wrap; gap: 1.6cqw; }
  .scr__lang {
    position: relative;
    padding: 1.7cqw 2.7cqw;
    border-radius: 100px;
    border: 0.5cqw solid var(--neutral-20);
    font-size: 4.1cqw;
    color: var(--neutral-80);
    background-color: var(--white);
  }
  .scr__lang--on {
    background-color: var(--solace-80);
    border-color: var(--solace-80);
    color: var(--white);
    font-weight: var(--font-weight-medium);
  }
  /* --alt is English: the selection the patient starts from. It carries no
     styling of its own, only an animation hook, because in the finished frame
     the tap has already happened and Tagalog owns the selection. */
  .scr__lang--more { color: var(--neutral-60); }

  .scr__thread { display: flex; flex-direction: column; gap: 2.4cqw; margin-block-start: 1cqw; }
  .scr__q { font-size: 5cqw; color: var(--neutral-60); }
  .scr__follow { font-size: 4cqw; color: var(--neutral-40); }
  .scr__a {
    align-self: flex-start;
    padding: 3cqw 3.6cqw;
    border-radius: 4cqw 4cqw 4cqw 1.2cqw;
    background-color: var(--white);
    border: 1px solid rgb(from var(--neutral-40) r g b / 0.2);
    color: var(--neutral-100);
    font-size: 5cqw;
    line-height: 1.42;
    box-shadow: 0 1px 2px rgb(from var(--neutral-100) r g b / 0.05);
  }

  /* A live level meter: thin bars, height-modulated. Never a row of dots —
     they are 1.1cqw wide against an 8cqw well, so they cannot read as one. */
  .scr__rec {
    display: flex; align-items: center; gap: 3cqw;
    padding: 3.2cqw 4cqw;
    border-radius: 4cqw;
    background-color: var(--white);
    box-shadow: 0 1px 2px rgb(from var(--neutral-100) r g b / 0.06),
                0 6px 14px rgb(from var(--neutral-100) r g b / 0.06);
  }
  .scr__meter { display: flex; align-items: flex-end; gap: 1.6cqw; block-size: 8cqw; flex: 1; }
  .scr__meter i {
    inline-size: 1.1cqw;
    block-size: var(--h);
    border-radius: 0.55cqw;
    background-color: var(--solace-50);
  }
  .scr__time { font-size: 4.6cqw; line-height: 1; color: var(--neutral-60); font-variant-numeric: tabular-nums; }

  /* Six digits behind a one-digit window. Two things are load-bearing here.
     The STRIP translates, not the digits — a percentage translate resolves
     against the element's own box, so moving each <i> would shift it by a
     fraction of itself and never advance the window. And every line-height is
     1: an overflow-hidden inline-block takes its baseline from its bottom
     margin edge, so the window only sits on the text baseline when its box and
     the surrounding line box match exactly.
     At rest the strip sits on its last frame: 0:09. */
  .scr__tick {
    display: inline-block;
    block-size: 1em;
    overflow: hidden;
    vertical-align: bottom;
  }
  .scr__strip { display: block; translate: 0 -83.333%; }
  .scr__strip i { display: block; block-size: 1em; line-height: 1; font-style: normal; }

  /* Beat 5. The one thing a patient actually wants confirmed: that telling the
     story went somewhere. */
  .scr__sent {
    display: flex; align-items: center; justify-content: center; gap: 2cqw;
    padding: 2.4cqw;
    border-radius: 3cqw;
    background-color: var(--white);
    border: 1px solid rgb(from var(--neutral-40) r g b / 0.2);
    color: var(--neutral-90);
    font-size: 4.2cqw;
    font-weight: var(--font-weight-medium);
    opacity: 0;
  }
  .scr__sent-tick {
    display: grid; place-items: center;
    inline-size: 5cqw; block-size: 5cqw; flex: none;
    border-radius: 100px;
    background-color: var(--solace-80);
    color: var(--white);
  }
  .scr__sent-tick svg { inline-size: 3cqw; block-size: 3cqw; }

  .scr__hint { text-align: center; font-size: 4.4cqw; color: var(--neutral-60); }

  .scr__foot {
    /* The slack collects here, at the bottom edge, rather than as a hole in the
       middle of the screen. */
    margin-block-start: auto;
    display: flex; align-items: center; justify-content: space-between;
    padding-block-start: 3cqw;
    border-block-start: 0.5cqw solid var(--neutral-20);
    font-size: 4.2cqw;
    color: var(--neutral-60);
  }
  .scr__foot span:first-child { color: var(--neutral-90); font-weight: var(--font-weight-medium); }

  /* ══ CLIP ═══════════════════════════════════════════════════════════════
     Five beats of 2.4s on the shared grid, so the percentages ARE the beat
     sheet above. Nothing uses animation-delay: delays drift against each other
     and make a five-part sequence impossible to reason about. */
  @keyframes intake-tap {
    0%, 21%   { opacity: 0; scale: 0.35; }
    23%       { opacity: 0.5; }
    29%, 100% { opacity: 0; scale: 1.9; }
  }
  @keyframes intake-select {
    0%, 24% {
      background-color: var(--white);
      border-color: var(--neutral-20);
      color: var(--neutral-80);
    }
    27%, 96% {
      background-color: var(--solace-80);
      border-color: var(--solace-80);
      color: var(--white); animation-timing-function: steps(1, end);
    }
    100% {
      background-color: var(--white);
      border-color: var(--neutral-20);
      color: var(--neutral-80);
    }
  }
  @keyframes intake-deselect {
    0%, 24% {
      background-color: var(--solace-80);
      border-color: var(--solace-80);
      color: var(--white);
    }
    27%, 96% {
      background-color: var(--white);
      border-color: var(--neutral-20);
      color: var(--neutral-80); animation-timing-function: steps(1, end);
    }
    100% {
      background-color: var(--solace-80);
      border-color: var(--solace-80);
      color: var(--white);
    }
  }
  /* One shape for every line that arrives: rise, unblur, settle. The two stops
     that differ per line are the in-point and the dissolve. */
  @keyframes intake-answer {
    0%, 42%  { opacity: 0; translate: 0 2.2cqw; filter: blur(3px); }
    49%, 96% { opacity: 1; translate: 0 0; filter: blur(0); }
    100%     { opacity: 0; translate: 0 2.2cqw; filter: blur(3px); }
  }
  @keyframes intake-followup {
    0%, 61%  { opacity: 0; translate: 0 2.2cqw; filter: blur(3px); }
    68%, 96% { opacity: 1; translate: 0 0; filter: blur(0); }
    100%     { opacity: 0; translate: 0 2.2cqw; filter: blur(3px); }
  }
  @keyframes intake-note {
    0%, 69%  { opacity: 0; }
    75%, 96% { opacity: 1; }
    100%     { opacity: 0; }
  }
  @keyframes intake-sent {
    0%, 82%  { opacity: 0; translate: 0 2cqw; }
    88%, 96% { opacity: 1; translate: 0 0; }
    100%     { opacity: 0; translate: 0 2cqw; }
  }
  @keyframes intake-timer {
    from { translate: 0 0; }
    to   { translate: 0 -83.333%; }
  }
  /* The meter runs on its own short cycle rather than the master timeline —
     speech is not on the beat, and a 12s waveform would read as decoration. */
  @keyframes intake-level {
    0%, 100% { block-size: var(--h); }
    50%      { block-size: var(--l); }
  }

  /* ease-ui, not steps: a selection toggle in a real interface transitions over
     a couple of hundred milliseconds, and 24%->27% of 12s is exactly that. */
  :global([data-play]) .scr__lang--on {
    animation: intake-select var(--clip-dur) var(--ease-ui) infinite both;
  }
  :global([data-play]) .scr__lang--alt {
    animation: intake-deselect var(--clip-dur) var(--ease-ui) infinite both;
  }
  :global([data-play]) .scr__lang--on::after {
    content: '';
    position: absolute;
    inset: -1.6cqw;
    border-radius: 100px;
    border: 0.6cqw solid var(--solace-50);
    animation: intake-tap var(--clip-dur) var(--ease-hero) infinite both;
    pointer-events: none;
  }
  :global([data-play]) .scr__a       { animation: intake-answer var(--clip-dur) var(--ease-hero) infinite both; }
  :global([data-play]) .scr__q--next { animation: intake-followup var(--clip-dur) var(--ease-hero) infinite both; }
  :global([data-play]) .scr__follow  { animation: intake-note var(--clip-dur) var(--ease-ui) infinite both; }
  :global([data-play]) .scr__sent    { animation: intake-sent var(--clip-dur) var(--ease-hero) infinite both; }
  :global([data-play]) .scr__strip   { animation: intake-timer var(--clip-dur) steps(6, jump-none) infinite both; }
  :global([data-play]) .scr__meter i {
    /* Each bar gets a second height and a slightly different period, which is
       what stops twelve bars from breathing in unison like an equaliser toy. */
    animation: intake-level var(--_p) ease-in-out infinite alternate;
  }
  :global([data-play]) .scr__meter i:nth-child(6n + 1) { --l: 82%; --_p: 620ms; }
  :global([data-play]) .scr__meter i:nth-child(6n + 2) { --l: 28%; --_p: 780ms; }
  :global([data-play]) .scr__meter i:nth-child(6n + 3) { --l: 44%; --_p: 540ms; }
  :global([data-play]) .scr__meter i:nth-child(6n + 4) { --l: 90%; --_p: 700ms; }
  :global([data-play]) .scr__meter i:nth-child(6n + 5) { --l: 36%; --_p: 860ms; }
  :global([data-play]) .scr__meter i:nth-child(6n + 6) { --l: 76%; --_p: 600ms; }
</style>
