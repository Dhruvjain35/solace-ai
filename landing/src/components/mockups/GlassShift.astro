---
/* The shift, as hours. Glass, on dark, and a 12s film.

   The only number a clinician actually cares about is how late they leave, and
   it is the one number this category almost never puts on a page. So the
   graphic is a ledger: where a ten-hour shift currently goes, and which block
   moves.

   The honest part is the third bar. Patient-facing time does not go up much —
   claiming it doubles would be a lie anybody who has worked a shift can see
   through. What changes is the documentation block and the hour that currently
   happens at home after the shift ends, which is the hour nobody is paid for.

   Material: glass on dark. Never mixed with the neumorphism on /product.

   ══ THE CLIP ══════════════════════════════════════════════════════════════
   12.0s, five beats of 2.4s, narrated by the caption rail.

     beat 1   0.0s   the shift as it is now, drawn to scale
     beat 2   2.4s   the documentation block shrinks
     beat 3   4.8s   the paperwork block nearly disappears
     beat 4   7.2s   what that returns to the patients in front of you
     beat 5   9.6s   and the block that was never on the roster at all
     11.5s           dissolve; 100% equals 0% so the loop has no seam */
import ClipCaption from './ClipCaption.astro';

const CAPTIONS = [
  'A ten-hour shift, drawn to scale.',
  'Documentation is the block that moves first.',
  'Then the letters and the forms.',
  'Patient time goes up — a little. Anything more would be a lie.',
  'And the hour at the kitchen table stops being part of the job.',
];
---

<div class="sh glass" data-clip>
  <div class="sh__head">
    <span class="sh__title">Where a shift goes</span>
    <span class="sh__meta">Ten hours, to scale</span>
  </div>

  <ul class="sh__rows">
    <li class="sh__row">
      <span class="sh__k">With patients</span>
      <span class="sh__track"><i class="sh__bar sh__bar--care" style="--from:38%; --to:52%"></i></span>
      <span class="sh__v sh__v--care">
        <span class="sh__tick"><span class="sh__strip"><i>3.8</i><i>3.8</i><i>3.8</i><i>4.6</i><i>5.2</i><i>5.2</i></span></span>h
      </span>
    </li>
    <li class="sh__row">
      <span class="sh__k">Writing notes</span>
      <span class="sh__track"><i class="sh__bar sh__bar--notes" style="--from:34%; --to:12%"></i></span>
      <span class="sh__v">
        <span class="sh__tick"><span class="sh__strip"><i>3.4</i><i>1.9</i><i>1.2</i><i>1.2</i><i>1.2</i><i>1.2</i></span></span>h
      </span>
    </li>
    <li class="sh__row">
      <span class="sh__k">Letters and forms</span>
      <span class="sh__track"><i class="sh__bar sh__bar--forms" style="--from:18%; --to:5%"></i></span>
      <span class="sh__v">
        <span class="sh__tick"><span class="sh__strip"><i>1.8</i><i>1.8</i><i>0.9</i><i>0.5</i><i>0.5</i><i>0.5</i></span></span>h
      </span>
    </li>
    <li class="sh__row sh__row--after">
      <span class="sh__k">At home, after</span>
      <span class="sh__track"><i class="sh__bar sh__bar--after" style="--from:10%; --to:0%"></i></span>
      <span class="sh__v sh__v--after">
        <span class="sh__tick"><span class="sh__strip"><i>1.0</i><i>1.0</i><i>1.0</i><i>0.6</i><i>0.1</i><i>0.1</i></span></span>h
      </span>
    </li>
  </ul>

  <p class="sh__note">
    <span class="sh__note-pre" aria-hidden="true">Typical emergency shift, before Solace</span>
    <span class="sh__note-post">The hour nobody rosters, and nobody is paid for.</span>
  </p>

  <ClipCaption steps={CAPTIONS} />
</div>

<style>
  .sh {
    --clip-dur: 9.5s;
    --_tint: var(--solace-100);
    inline-size: 100%;
    display: flex;
    flex-direction: column;
    gap: 3.6cqw;
    padding: 5.5cqw;
    border-radius: var(--radius-6x);
    color: var(--white);
  }

  .sh__head { display: flex; align-items: baseline; gap: 3cqw; }
  .sh__title { font-size: 4cqw; font-weight: var(--font-weight-semibold); letter-spacing: -0.02em; }
  .sh__meta { margin-inline-start: auto; font-size: 3cqw; color: rgb(from var(--white) r g b / 0.72); }

  .sh__rows { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 3cqw; }
  .sh__row { display: flex; align-items: center; gap: 3cqw; }
  .sh__k { inline-size: 26cqw; flex: none; font-size: 3.1cqw; color: rgb(from var(--white) r g b / 0.8); }

  .sh__track {
    flex: 1;
    min-inline-size: 0;
    block-size: 4.6cqw;
    border-radius: 100px;
    background-color: rgb(from var(--white) r g b / 0.1);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.24);
    overflow: hidden;
  }
  /* The resting width is the AFTER figure, so a still frame shows the outcome
     and the clip rewinds to the before. */
  .sh__bar { display: block; block-size: 100%; inline-size: var(--to); border-radius: 100px; }
  .sh__bar--care  { background: linear-gradient(90deg, var(--solace-60) 0%, var(--solace-40) 100%); }
  .sh__bar--notes { background: linear-gradient(90deg, rgb(from var(--white) r g b / 0.5) 0%, rgb(from var(--white) r g b / 0.32) 100%); }
  .sh__bar--forms { background: linear-gradient(90deg, rgb(from var(--white) r g b / 0.42) 0%, rgb(from var(--white) r g b / 0.26) 100%); }
  .sh__bar--after { background: linear-gradient(90deg, var(--orange-40) 0%, var(--orange-30) 100%); }

  .sh__v {
    inline-size: 14cqw;
    flex: none;
    display: flex; align-items: baseline; justify-content: flex-end; gap: 0.4cqw;
    font-size: 2.9cqw;
    line-height: 1;
    color: rgb(from var(--white) r g b / 0.72);
    font-variant-numeric: tabular-nums;
  }
  .sh__v--care  { color: var(--solace-20); }
  .sh__v--after { color: var(--orange-20); }
  /* Type size on the WINDOW, not the digits: block-size:1em resolves against
     the element's own font-size, so a small window holding large digits is
     shorter than its contents and overflow:hidden shaves the glyphs. */
  .sh__tick {
    display: inline-block;
    font-size: 4.2cqw;
    line-height: 1;
    font-weight: var(--font-weight-semibold);
    block-size: 1em;
    overflow: hidden;
  }
  .sh__strip { display: block; translate: 0 -83.333%; }
  .sh__strip i { display: block; block-size: 1em; line-height: 1; font-style: normal; }

  .sh__note {
    display: grid;
    padding-block-start: 3cqw;
    border-block-start: 1px solid rgb(from var(--white) r g b / 0.16);
    font-size: 2.9cqw;
  }
  .sh__note > * { grid-area: 1 / 1; }
  .sh__note-pre  { color: rgb(from var(--white) r g b / 0.66); opacity: 0; }
  .sh__note-post { color: var(--orange-20); }

  /* ══ CLIP ═══════════════════════════════════════════════════════════════
     Five beats of 2.4s on the shared grid. Each bar moves in the beat its
     caption names, so the eye is never asked to watch four things at once. */
  @keyframes sh-notes {
    0%, 21%  { inline-size: var(--from); }
    34%, 96% { inline-size: var(--to); }
    100%     { inline-size: var(--from); }
  }
  @keyframes sh-forms {
    0%, 41%  { inline-size: var(--from); }
    54%, 96% { inline-size: var(--to); }
    100%     { inline-size: var(--from); }
  }
  @keyframes sh-care {
    0%, 61%  { inline-size: var(--from); }
    74%, 96% { inline-size: var(--to); }
    100%     { inline-size: var(--from); }
  }
  @keyframes sh-after {
    0%, 81%  { inline-size: var(--from); }
    92%, 96% { inline-size: var(--to); }
    100%     { inline-size: var(--from); }
  }
  @keyframes sh-count {
    from { translate: 0 0; }
    to   { translate: 0 -83.333%; }
  }
  @keyframes sh-note-pre {
    0%, 81%  { opacity: 1; }
    86%, 96% { opacity: 0; animation-timing-function: steps(1, end); }
    100%     { opacity: 1; }
  }
  @keyframes sh-note-post {
    0%, 86%  { opacity: 0; }
    91%, 96% { opacity: 1; animation-timing-function: steps(1, end); }
    100%     { opacity: 0; }
  }

  .sh[data-play] .sh__bar--notes { animation: sh-notes var(--clip-dur) var(--ease-hero) infinite both; }
  .sh[data-play] .sh__bar--forms { animation: sh-forms var(--clip-dur) var(--ease-hero) infinite both; }
  .sh[data-play] .sh__bar--care  { animation: sh-care var(--clip-dur) var(--ease-hero) infinite both; }
  .sh[data-play] .sh__bar--after { animation: sh-after var(--clip-dur) var(--ease-hero) infinite both; }
  .sh[data-play] .sh__strip      { animation: sh-count var(--clip-dur) steps(6, jump-none) infinite both; }
  .sh[data-play] .sh__note-pre   { animation: sh-note-pre var(--clip-dur) var(--ease-ui) infinite both; }
  .sh[data-play] .sh__note-post  { animation: sh-note-post var(--clip-dur) var(--ease-ui) infinite both; }
</style>
