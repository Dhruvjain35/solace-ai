---
import Logo from './Logo.astro';

/* The product menu. This replaces a four-column wall of forty short lines on
   /product that nobody was going to read — a list that long stops being
   information and becomes texture. A menu is the right shape for it: you scan
   nine things, pick the one you came for, and land on the part of the page that
   explains it properly.

   CSS-only. It opens on hover and on focus-within, so a keyboard tab into the
   Product link opens it and the next tab lands on the first item. No JS, and
   nothing to go wrong on a slow connection. */
/* The nav and product-menu data used to live here. Both are gone rather than
   left unused: every entry pointed into src/pages-parked/, and a dropdown of
   404s is worse than no dropdown. Restoring them means restoring the pages —
   see src/pages-parked/README.md. */
---

<header class="site-header" data-global-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Solace home">
      <Logo />
    </a>

    {/* No nav. There are four pages on this site and three of them are the
        landing page, the waitlist and the legal pair — a menu bar would be
        pointing at 404s. The pill is the only thing to do here, so it is the
        only thing offered. The full nav is still in git history and comes back
        with the pages in src/pages-parked/. */}

    <div class="site-header__actions">
      <a href="/demo" class="site-header__pill">Book a demo</a>
    </div>
  </div>
</header>

<style>
  /* ══ PRODUCT MENU ═══════════════════════════════════════════════════════ */
  .menu { position: relative; display: flex; align-items: center; }
  .menu__trigger { display: inline-flex; align-items: center; gap: var(--space-1_5x); }
  .menu__chev {
    inline-size: 10px;
    transition: rotate var(--motion-duration-base) var(--ease-ui);
  }
  .menu:hover .menu__chev,
  .menu:focus-within .menu__chev { rotate: 180deg; }

  .menu__panel {
    position: absolute;
    inset-block-start: calc(100% + var(--space-4x));
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: min(92vw, 680px);
    padding: var(--space-4x);
    border-radius: var(--radius-5x);
    /* Glass, on its own: the menu opens over both the light pages and the dark
       one, so it carries enough of its own surface to be legible on either. */
    background:
      linear-gradient(210deg, rgb(from var(--white) r g b / 0.9) 0, transparent 38%),
      linear-gradient(180deg, rgb(from var(--white) r g b / 0.97) 0, rgb(from var(--neutral-5) r g b / 0.95) 100%);
    border: 1px solid rgb(from var(--neutral-40) r g b / 0.24);
    box-shadow:
      0 1px 2px rgb(from var(--neutral-40) r g b / 0.14),
      0 24px 56px rgb(from var(--neutral-40) r g b / 0.26);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: var(--neutral-100);

    /* Closed. visibility is what keeps the links out of the tab order while
       shut — opacity alone would leave nine focusable items in a panel nobody
       can see. */
    opacity: 0;
    visibility: hidden;
    translate: -50% var(--space-2x);
    transition:
      opacity var(--motion-duration-base) var(--ease-ui),
      translate var(--motion-duration-base) var(--ease-ui),
      visibility 0s linear var(--motion-duration-base);
  }
  .menu:hover .menu__panel,
  .menu:focus-within .menu__panel {
    opacity: 1;
    visibility: visible;
    translate: -50% 0;
    transition-delay: 0s;
  }
  /* The gap between trigger and panel would drop the hover on the way down. */
  .menu::after {
    content: '';
    position: absolute;
    inset-block-start: 100%;
    inset-inline: -20%;
    block-size: var(--space-5x);
  }

  .menu__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-1x); }
  @media (max-width: 720px) { .menu__grid { grid-template-columns: 1fr; } }

  .menu__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-0_5x);
    padding: var(--space-3x) var(--space-4x);
    border-radius: var(--radius-3x);
    transition: background-color var(--motion-duration-fast) var(--ease-ui);
  }
  .menu__item:hover { background-color: rgb(from var(--neutral-40) r g b / 0.12); }
  .menu__label { font-size: var(--font-size-16); font-weight: var(--font-weight-medium); color: var(--neutral-100); }
  .menu__sub { font-size: var(--font-size-14); line-height: var(--line-height-open); color: rgb(from var(--neutral-100) r g b / 0.66); }

  @media (prefers-reduced-motion: reduce) {
    .menu__panel, .menu__chev, .menu__item { transition: none; }
  }

  /* The header reads the hero's own scroll progress through a named view
     timeline. No scroll listener, no IntersectionObserver, no JS at all.
     Both animated properties are registered, so they interpolate. */
  @property --header-opacity { syntax: "<number>"; initial-value: 0; inherits: false; }
  @property --header-ink     { syntax: "<color>";  initial-value: #ffffff; inherits: true; }

  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    block-size: var(--page-header-height);
    display: flex;
    align-items: center;
    color: var(--header-ink);
    background-color: rgb(from var(--white) r g b / var(--header-opacity));
    border-block-end: 1px solid
      rgb(from var(--color-border-sub) r g b / calc(alpha * var(--header-opacity)));

    /* The variable-as-switch trick: `initial` is guaranteed-invalid inside a
       var() substitution, which kills the whole declaration and removes the
       blur. A single space substitutes to nothing, leaving `blur(12px)`. */
    --header-has-blur: ;
    backdrop-filter: var(--header-has-blur) blur(12px);
    -webkit-backdrop-filter: var(--header-has-blur) blur(12px);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .site-header {
        animation:
          header-fade-in linear forwards,
          header-blur-off step-end forwards;
        animation-timeline: --homepage-hero-section;
        /* Superhuman uses `exit-crossing` with header-height offsets, but their
           hero sits below an announcement bar. Ours is at document top, where
           exit-crossing resolves as already-passed and the header renders
           permanently solid. Verified empirically across six candidate ranges;
           plain `exit` is the one that holds transparent over the hero. */
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes header-fade-in {
    to { --header-opacity: 1; --header-ink: #292827; }
  }
  /* Once the header is opaque there is nothing behind it worth blurring,
     so drop the filter and give the compositor its layer back. */
  @keyframes header-blur-off {
    to { --header-has-blur: initial; }
  }

  /* Browsers without view timelines get a permanently solid header. Slightly
     less pretty over the hero, but readable, which matters more. */
  @supports not (animation-timeline: view()) {
    .site-header {
      background-color: var(--color-bg-primary);
      color: var(--color-text-base);
      border-block-end: 1px solid var(--color-border-sub);
    }
  }

  .site-header__inner {
    inline-size: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-8x);
  }

  .site-header__brand { display: flex; align-items: center; }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: var(--space-6x);
    font-size: var(--font-size-text-small);
    font-weight: var(--font-weight-medium);
  }
  @media (min-width: 1080.02px) { .site-header__nav { display: flex; } }

  .site-header__nav a { opacity: 0.86; transition: opacity var(--motion-duration-base) var(--ease-ui); }
  .site-header__nav a:hover { opacity: 1; }

  .site-header__actions {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: var(--space-5x);
    font-size: var(--font-size-text-small);
    font-weight: var(--font-weight-medium);
  }

  .site-header__link { display: none; opacity: 0.86; transition: opacity var(--motion-duration-base) var(--ease-ui); }
  .site-header__link:hover { opacity: 1; }
  @media (min-width: 640.02px) { .site-header__link { display: inline-flex; } }

  .site-header__pill {
    padding: var(--space-2x) var(--space-4x);
    border-radius: var(--radius-full);
    background-color: var(--solace-20);
    color: var(--neutral-90);
    letter-spacing: normal;
    transition: background-color var(--motion-duration-base) var(--ease-ui);
  }
  .site-header__pill:hover { background-color: var(--solace-30); }
</style>
