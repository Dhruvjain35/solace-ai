---
import CtaPrimary from './CtaPrimary.astro';

/* Background is three graded sky plates parallaxing at different speeds and
   directions, so the motion reads as atmosphere with depth rather than one
   image sliding. The mid and near plates are premultiplied against black and
   composited with mix-blend-mode: screen — black goes transparent under screen,
   which reproduces an alpha cutout without storing an alpha channel. That is
   what keeps all three layers at 107KB combined.

   The clinician is a 2000x3000 source, matted, de-branded, graded and light
   wrapped so she belongs to the plate. See public/assets/hero/CREDITS.md. */
---

<section class="hero" data-color-scheme="dark" id="main">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__layer hero__layer--far"></div>
    <div class="hero__layer hero__layer--mid"></div>
    <div class="hero__layer hero__layer--near"></div>
    <div class="hero__veil"></div>
  </div>

  <div class="container hero__inner">
    <h1 class="hero__title display-large">Triage that starts at the door</h1>

    <p class="hero__sub text-large">
      Patients speak in any language. Clinicians get the acuity pre-brief before the room is ready.
    </p>

    <div class="hero__cta">
      <CtaPrimary href="/demo" label="Book a demo" />
    </div>

    <div class="hero__stage">
      <div class="glass glass--lg hero__card hero__card--intake">
        <div class="hero__card-head">
          <span class="hero__pill">Voice intake</span>
          <span class="mono hero__card-meta">Tagalog</span>
        </div>
        <p class="hero__quote">&ldquo;Nahihirapan akong huminga simula kaninang umaga.&rdquo;</p>
        <div class="hero__wave" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <p class="mono hero__card-note">Shortness of breath, onset ~6h</p>
      </div>

      <div class="glass glass--lg hero__card hero__card--brief">
        <div class="hero__card-head">
          <span class="hero__pill">Clinician pre-brief</span>
          <span class="hero__esi">Provisional ESI 2</span>
        </div>
        <p class="hero__name">M. Reyes, 47</p>
        <dl class="hero__rows">
          <div><dt>Respiratory rate</dt><dd class="mono">24</dd></div>
          <div><dt>SpO&#8322;</dt><dd class="mono">93%</dd></div>
          <div><dt>Heart rate</dt><dd class="mono">112</dd></div>
          <div><dt>EHR match</dt><dd class="mono">Epic &middot; 2 priors</dd></div>
        </dl>
      </div>

      <div class="glass glass--lg hero__card hero__card--queue">
        <div class="hero__card-head">
          <span class="hero__pill">Live queue</span>
          <span class="mono hero__card-meta">4 waiting</span>
        </div>
        <dl class="hero__rows">
          <div><dt>Reyes, M.</dt><dd class="mono">ESI 2 &middot; 0:41</dd></div>
          <div><dt>Osei, K.</dt><dd class="mono">ESI 3 &middot; 4:12</dd></div>
          <div><dt>Duarte, L.</dt><dd class="mono">ESI 4 &middot; 9:03</dd></div>
        </dl>
      </div>

      <picture class="hero__figure">
        <source srcset="/assets/hero/clinician.webp 1x, /assets/hero/clinician@2x.webp 2x" type="image/webp" />
        <img src="/assets/hero/clinician.webp" alt="" width="505" height="900" fetchpriority="high" decoding="async" />
      </picture>
    </div>
  </div>

  <p class="hero__disclosure">Solace suggests; the clinician always makes the final call.</p>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-block-start: calc(-1 * var(--page-header-height));
    padding-block-start: var(--page-header-height);
    view-timeline-name: --homepage-hero-section;
    view-timeline-axis: block;
    color: var(--white);
    background-color: var(--slate-black);
  }

  .hero__bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; }

  /* Oversized so drift never exposes an edge. */
  .hero__layer {
    position: absolute;
    inset: -10%;
    background-size: cover;
    background-position: 50% 55%;
    will-change: transform;
  }
  .hero__layer--far  { background-image: url('/assets/hero/sky-far.webp'); }
  .hero__layer--mid  { background-image: url('/assets/hero/sky-mid.webp');  mix-blend-mode: screen; opacity: 0.92; }
  .hero__layer--near { background-image: url('/assets/hero/sky-near.webp'); mix-blend-mode: screen; opacity: 0.55; }

  @media (prefers-reduced-motion: no-preference) {
    .hero__layer--far  { animation: drift-far  92s linear infinite alternate; }
    .hero__layer--mid  { animation: drift-mid  64s linear infinite alternate; }
    .hero__layer--near { animation: drift-near 41s linear infinite alternate; }
  }
  /* Opposed directions and different scales are what make it read as depth
     rather than one picture panning. */
  @keyframes drift-far  { from { transform: translate3d(-1.5%, 0.6%, 0) scale(1.06); }
                          to   { transform: translate3d( 1.5%,-0.6%, 0) scale(1.12); } }
  @keyframes drift-mid  { from { transform: translate3d( 3.2%,-1.0%, 0) scale(1.08); }
                          to   { transform: translate3d(-3.2%, 1.0%, 0) scale(1.15); } }
  @keyframes drift-near { from { transform: translate3d(-5.5%, 1.6%, 0) scale(1.14); }
                          to   { transform: translate3d( 5.5%,-1.6%, 0) scale(1.22); } }

  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg,
        rgb(from var(--slate-black) r g b / 0.66) 0,
        rgb(from var(--slate-black) r g b / 0.20) 30%,
        rgb(from var(--slate-black) r g b / 0.02) 52%,
        rgb(from var(--slate-black) r g b / 0.42) 90%,
        rgb(from var(--slate-black) r g b / 0.86) 100%),
      radial-gradient(ellipse 76% 54% at 50% 6%,
        rgb(from var(--slate-black) r g b / 0.36) 0, transparent 72%);
  }

  .hero__inner { position: relative; z-index: var(--z-raised); }

  .hero__title {
    margin-block-start: var(--space-14x);
    text-align: center;
    max-inline-size: 15ch;
    margin-inline: auto;
    text-shadow: 0 2px 28px rgb(from var(--slate-black) r g b / 0.5);
  }
  .hero__sub {
    margin-block-start: var(--space-5x);
    margin-inline: auto;
    max-inline-size: 46ch;
    text-align: center;
    color: rgb(from var(--white) r g b / 0.80);
    text-shadow: 0 1px 18px rgb(from var(--slate-black) r g b / 0.55);
  }
  .hero__cta { display: flex; justify-content: center; margin-block-start: var(--space-8x); }

  .hero__stage {
    position: relative;
    margin-block-start: var(--space-8x);
    block-size: clamp(330px, 64vw, 420px);
  }
  @media (min-width: 640.02px) { .hero__stage { block-size: clamp(420px, 46vw, 700px); } }

  /* Bigger figure. She is the subject, not set dressing. */
  .hero__figure {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-end: calc(-1 * var(--space-40x));
    translate: -50% 0;
    z-index: var(--z-raised);
  }
  @media (min-width: 640.02px) { .hero__figure { translate: -12% 0; } }
  .hero__figure img { block-size: clamp(460px, 56vw, 820px); inline-size: auto; }

  .hero__card { position: absolute; z-index: 2; display: none; gap: var(--space-3x); }

  .hero__card--intake { inset-inline-start: 0; inset-block-start: var(--space-4x); }
  .hero__card--brief  { inset-inline-end: 0;   inset-block-start: 0; }
  .hero__card--queue  { inset-inline-start: var(--space-12x); inset-block-start: 64%; inline-size: 310px; }

  @media (min-width: 640.02px) {
    .hero__card--intake { display: grid; inline-size: 300px; }
  }
  @media (min-width: 1080.02px) {
    .hero__card--brief { display: grid; inline-size: 340px; }
    .hero__card--intake { inline-size: 320px; }
  }
  @media (min-width: 1280.02px) {
    .hero__card--queue { display: grid; }
    .hero__card--intake { inline-size: 340px; }
    .hero__card--brief  { inline-size: 372px; }
  }

  .hero__card-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3x); }
  .hero__card-meta { color: rgb(from var(--white) r g b / 0.55); }

  .hero__pill {
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(from var(--white) r g b / 0.70);
  }

  .hero__quote { font-size: var(--font-size-text-medium); line-height: 1.45; }
  .hero__name  { font-size: var(--font-size-20); font-weight: var(--font-weight-medium); }
  .hero__card-note { color: rgb(from var(--white) r g b / 0.65); }

  /* A level meter, not decoration: ten fixed bars showing a captured waveform.
     Nothing pulses. */
  .hero__wave { display: flex; align-items: flex-end; gap: 4px; block-size: 26px; }
  .hero__wave span {
    inline-size: 3px;
    border-radius: 1.5px;
    background-color: rgb(from var(--solace-20) r g b / 0.6);
  }
  .hero__wave span:nth-child(1) { block-size: 30% } .hero__wave span:nth-child(2) { block-size: 62% }
  .hero__wave span:nth-child(3) { block-size: 96% } .hero__wave span:nth-child(4) { block-size: 74% }
  .hero__wave span:nth-child(5) { block-size: 44% } .hero__wave span:nth-child(6) { block-size: 82% }
  .hero__wave span:nth-child(7) { block-size: 58% } .hero__wave span:nth-child(8) { block-size: 34% }
  .hero__wave span:nth-child(9) { block-size: 68% } .hero__wave span:nth-child(10){ block-size: 26% }

  .hero__esi {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1_5x);
    padding: var(--space-0_5x) var(--space-2_5x);
    border-radius: var(--radius-full);
    background-color: rgb(from var(--solace-20) r g b / 0.16);
    border: 1px solid rgb(from var(--solace-20) r g b / 0.32);
    color: var(--solace-20);
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-medium);
    letter-spacing: normal;
    white-space: nowrap;
  }
  .hero__esi::before {
    content: "";
    inline-size: 6px; block-size: 6px;
    border-radius: var(--radius-full);
    background-color: currentColor;
  }

  .hero__rows { margin: 0; display: grid; font-size: var(--font-size-14); }
  .hero__rows > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4x);
    padding-block: var(--space-2x);
    border-block-end: 1px solid rgb(from var(--white) r g b / 0.10);
  }
  .hero__rows > div:last-child { border-block-end: none; }
  .hero__rows dt { color: rgb(from var(--white) r g b / 0.88); }
  .hero__rows dd { margin: 0; color: rgb(from var(--white) r g b / 0.72); }

  .hero__disclosure {
    position: relative;
    z-index: 3;
    margin-block-start: var(--space-16x);
    padding-block: var(--space-8x) var(--space-6x);
    padding-inline: var(--viewport-padding);
    text-align: center;
    font-size: var(--font-size-12);
    color: rgb(from var(--white) r g b / 0.62);
  }
  @media (min-width: 640.02px) {
    .hero__disclosure {
      margin-block-start: var(--space-24x);
      padding-block: 0 var(--space-6x);
      max-inline-size: 40ch;
      text-align: start;
      color: rgb(from var(--white) r g b / 0.55);
    }
  }
</style>
