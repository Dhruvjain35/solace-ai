---
import CtaPrimary from './CtaPrimary.astro';
---

<section class="hero" data-color-scheme="dark" id="main">
  <div class="container hero__inner">
    <h1 class="hero__title display-large">Triage that starts at the door</h1>

    <p class="hero__sub text-large">
      Patients speak in any language. Clinicians get the acuity pre-brief before the room is ready.
    </p>

    <div class="hero__cta">
      <CtaPrimary href="/demo" label="Book a demo" />
    </div>

    <div class="hero__stage">
      <div class="glass hero__card hero__card--intake">
        <p class="eyebrow">Voice intake &middot; Tagalog</p>
        <p class="text-small">&ldquo;Nahihirapan akong huminga simula kaninang umaga.&rdquo;</p>
        <p class="mono hero__card-note">Shortness of breath, onset ~6h</p>
      </div>

      <div class="glass hero__card hero__card--brief">
        <p class="eyebrow">Clinician pre-brief</p>
        <div class="hero__brief-head">
          <strong class="weight-medium">M. Reyes, 47</strong>
          <span class="hero__esi">Provisional ESI 2</span>
        </div>
        <dl class="hero__rows">
          <div><dt>Respiratory rate</dt><dd class="mono">24</dd></div>
          <div><dt>SpO&#8322;</dt><dd class="mono">93%</dd></div>
          <div><dt>EHR match</dt><dd class="mono">Epic &middot; 2 priors</dd></div>
        </dl>
      </div>

      <div class="glass hero__card hero__card--queue">
        <p class="eyebrow">Live queue</p>
        <dl class="hero__rows">
          <div><dt>Reyes, M.</dt><dd class="mono">ESI 2 &middot; 0:41</dd></div>
          <div><dt>Osei, K.</dt><dd class="mono">ESI 3 &middot; 4:12</dd></div>
          <div><dt>Duarte, L.</dt><dd class="mono">ESI 4 &middot; 9:03</dd></div>
        </dl>
      </div>

      <picture class="hero__figure">
        <source
          srcset="/assets/clinician-hero.webp 1x, /assets/clinician-hero@2x.webp 2x"
          type="image/webp"
        />
        <img src="/assets/clinician-hero.png" alt="" width="376" height="610" fetchpriority="high" />
      </picture>
    </div>
  </div>

  <p class="hero__disclosure">Screens are illustrative. Solace suggests; the clinician always makes the final call.</p>
</section>

<style>
  /* Names the timeline the sticky header reads. Nothing else uses it. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-block-start: calc(-1 * var(--page-header-height));
    padding-block-start: var(--page-header-height);
    view-timeline-name: --homepage-hero-section;
    view-timeline-axis: block;
    color: var(--white);
    background:
      linear-gradient(rgb(255 255 255 / 0.10) 0, rgb(255 255 255 / 0) 100%),
      radial-gradient(circle at 68% 46%, rgb(from var(--solace-40) r g b / 0.55) 0, rgb(0 0 0 / 0) 50%),
      radial-gradient(circle at 50% 98%, rgb(from var(--solace-20) r g b / 0.45) 0, rgb(0 0 0 / 0) 55%),
      radial-gradient(circle at 18% 22%, rgb(12 66 67 / 0.85) 0, rgb(0 0 0 / 0) 60%),
      linear-gradient(180deg, #12312a 0, #0a1f1b 55%, var(--slate-black) 100%);
  }

  .hero__inner { position: relative; z-index: var(--z-raised); }

  .hero__title {
    margin-block-start: var(--space-16x);
    text-align: center;
    max-inline-size: 15ch;
    margin-inline: auto;
  }

  .hero__sub {
    margin-block-start: var(--space-5x);
    margin-inline: auto;
    max-inline-size: 46ch;
    text-align: center;
    color: rgb(from var(--white) r g b / 0.72);
  }

  .hero__cta { display: flex; justify-content: center; margin-block-start: var(--space-8x); }

  /* One grid cell holds every floating element. Placement is align-self /
     justify-self, never position:absolute, so the collage reflows on its own. */
  .hero__stage {
    position: relative;
    margin-block-start: var(--space-9x);
    block-size: clamp(340px, 34vw, 500px);
  }

  .hero__figure {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-end: calc(-1 * var(--space-32x));
    translate: -16% 0;
    z-index: var(--z-raised);
    filter: drop-shadow(0 40px 70px rgb(0 0 0 / 0.62));
  }
  .hero__figure img { block-size: clamp(400px, 42vw, 560px); inline-size: auto; }

  .hero__card { position: absolute; z-index: 2; display: grid; gap: var(--space-2x); }
  .hero__card-note { color: rgb(from var(--white) r g b / 0.70); }

  .hero__card--intake { inset-inline-start: 0; inset-block-start: var(--space-6x); inline-size: 300px; }
  .hero__card--brief  { inset-inline-end: 0;   inset-block-start: var(--space-2x); inline-size: 330px; }
  .hero__card--queue  { inset-inline-start: var(--space-20x); inset-block-start: 62%; inline-size: 272px; }

  /* Below 1080 the collage is unreadable at these sizes; drop to the figure. */
  @media (max-width: 1080px) {
    .hero__card--queue { display: none; }
    .hero__card--intake, .hero__card--brief { inline-size: 258px; }
  }
  @media (max-width: 640px) {
    .hero__card { display: none; }
    .hero__stage { block-size: clamp(280px, 60vw, 360px); }
    .hero__figure { translate: -50% 0; }
  }

  .hero__brief-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3x); }

  .hero__esi {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1_5x);
    padding: var(--space-0_5x) var(--space-2_5x);
    border-radius: var(--radius-full);
    background-color: rgb(from var(--solace-20) r g b / 0.16);
    border: 1px solid rgb(from var(--solace-20) r g b / 0.32);
    color: var(--solace-20);
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-medium);
    letter-spacing: normal;
    white-space: nowrap;
  }
  .hero__esi::before {
    content: "";
    inline-size: 6px; block-size: 6px;
    border-radius: var(--radius-full);
    background-color: currentColor;
  }

  .hero__rows { margin: 0; display: grid; font-size: var(--font-size-14); }
  .hero__rows > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4x);
    padding-block: var(--space-1_5x);
    border-block-end: 1px solid rgb(from var(--white) r g b / 0.10);
  }
  .hero__rows > div:last-child { border-block-end: none; }
  .hero__rows dt { color: rgb(from var(--white) r g b / 0.88); }
  .hero__rows dd { margin: 0; color: rgb(from var(--white) r g b / 0.70); }

  /* Sits in the hero's bottom-left dead space, clear of the figure. */
  .hero__disclosure {
    position: relative;
    z-index: 3;
    margin-block-start: var(--space-24x);
    padding-block-end: var(--space-6x);
    padding-inline: var(--viewport-padding);
    max-inline-size: 40ch;
    font-size: var(--font-size-12);
    color: rgb(from var(--white) r g b / 0.45);
  }
  @media (max-width: 640px) {
    .hero__disclosure { max-inline-size: none; text-align: center; }
  }
</style>
