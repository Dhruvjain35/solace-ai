---
import CtaPrimary from './CtaPrimary.astro';

/* The background is a real photographed sky, colour-graded to the Solace
   emerald ramp, not a CSS gradient. The clinician is composited into it with a
   light wrap and a bottom fade so she belongs to the plate rather than sitting
   on top of it. See public/assets/hero/CREDITS.md.

   Motion is a slow ken-burns drift on the sky, which is why the plate is
   rendered oversized: it can move without ever exposing an edge. */
---

<section class="hero" data-color-scheme="dark" id="main">
  <div class="hero__sky" aria-hidden="true"></div>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container hero__inner">
    <h1 class="hero__title display-large">Triage that starts at the door</h1>

    <p class="hero__sub text-large">
      Patients speak in any language. Clinicians get the acuity pre-brief before the room is ready.
    </p>

    <div class="hero__cta">
      <CtaPrimary href="/demo" label="Book a demo" />
    </div>

    <div class="hero__stage">
      <div class="glass hero__card hero__card--intake">
        <p class="eyebrow">Voice intake &middot; Tagalog</p>
        <p class="text-small">&ldquo;Nahihirapan akong huminga simula kaninang umaga.&rdquo;</p>
        <p class="mono hero__card-note">Shortness of breath, onset ~6h</p>
      </div>

      <div class="glass hero__card hero__card--brief">
        <p class="eyebrow">Clinician pre-brief</p>
        <div class="hero__brief-head">
          <strong class="weight-medium">M. Reyes, 47</strong>
          <span class="hero__esi">Provisional ESI 2</span>
        </div>
        <dl class="hero__rows">
          <div><dt>Respiratory rate</dt><dd class="mono">24</dd></div>
          <div><dt>SpO&#8322;</dt><dd class="mono">93%</dd></div>
          <div><dt>EHR match</dt><dd class="mono">Epic &middot; 2 priors</dd></div>
        </dl>
      </div>

      <div class="glass hero__card hero__card--queue">
        <p class="eyebrow">Live queue</p>
        <dl class="hero__rows">
          <div><dt>Reyes, M.</dt><dd class="mono">ESI 2 &middot; 0:41</dd></div>
          <div><dt>Osei, K.</dt><dd class="mono">ESI 3 &middot; 4:12</dd></div>
          <div><dt>Duarte, L.</dt><dd class="mono">ESI 4 &middot; 9:03</dd></div>
        </dl>
      </div>

      <picture class="hero__figure">
        <source srcset="/assets/hero/clinician.webp 1x, /assets/hero/clinician@2x.webp 2x" type="image/webp" />
        <img src="/assets/hero/clinician.webp" alt="" width="406" height="660" fetchpriority="high" decoding="async" />
      </picture>
    </div>
  </div>

  <p class="hero__disclosure">Solace suggests; the clinician always makes the final call.</p>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-block-start: calc(-1 * var(--page-header-height));
    padding-block-start: var(--page-header-height);
    view-timeline-name: --homepage-hero-section;
    view-timeline-axis: block;
    color: var(--white);
    background-color: var(--slate-black);
  }

  /* Oversized on purpose so the drift never reveals an edge. */
  .hero__sky {
    position: absolute;
    inset: -6% -6% -6% -6%;
    z-index: -2;
    background-image: image-set(
      url('/assets/hero/sky.webp') 1x,
      url('/assets/hero/sky@2x.webp') 2x
    );
    background-size: cover;
    background-position: 50% 58%;
    transform-origin: 58% 60%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__sky { animation: sky-drift 78s var(--ease-ui) infinite alternate; }
  }
  @keyframes sky-drift {
    from { transform: scale(1) translate3d(0, 0, 0); }
    to   { transform: scale(1.09) translate3d(-1.6%, -1.1%, 0); }
  }

  /* Darkens the top so the nav and headline sit on near-black, and seals the
     bottom edge into the section boundary. */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg,
        rgb(from var(--slate-black) r g b / 0.62) 0,
        rgb(from var(--slate-black) r g b / 0.18) 30%,
        rgb(from var(--slate-black) r g b / 0.02) 52%,
        rgb(from var(--slate-black) r g b / 0.45) 92%,
        rgb(from var(--slate-black) r g b / 0.82) 100%),
      radial-gradient(ellipse 74% 52% at 50% 6%,
        rgb(from var(--slate-black) r g b / 0.34) 0, transparent 72%);
  }

  .hero__inner { position: relative; z-index: var(--z-raised); }

  .hero__title {
    margin-block-start: var(--space-16x);
    text-align: center;
    max-inline-size: 15ch;
    margin-inline: auto;
    text-shadow: 0 2px 24px rgb(from var(--slate-black) r g b / 0.45);
  }

  .hero__sub {
    margin-block-start: var(--space-5x);
    margin-inline: auto;
    max-inline-size: 46ch;
    text-align: center;
    color: rgb(from var(--white) r g b / 0.78);
    text-shadow: 0 1px 16px rgb(from var(--slate-black) r g b / 0.5);
  }

  .hero__cta { display: flex; justify-content: center; margin-block-start: var(--space-8x); }

  .hero__stage {
    position: relative;
    margin-block-start: var(--space-9x);
    block-size: clamp(280px, 60vw, 360px);
  }
  @media (min-width: 640.02px) {
    .hero__stage { block-size: clamp(340px, 34vw, 500px); }
  }

  .hero__figure {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-end: calc(-1 * var(--space-24x));
    translate: -50% 0;
    z-index: var(--z-raised);
  }
  @media (min-width: 640.02px) {
    .hero__figure { translate: -14% 0; }
  }
  .hero__figure img { block-size: clamp(420px, 44vw, 620px); inline-size: auto; }

  .hero__card { position: absolute; z-index: 2; display: none; gap: var(--space-2x); }
  .hero__card-note { color: rgb(from var(--white) r g b / 0.70); }

  .hero__card--intake { inset-inline-start: 0; inset-block-start: var(--space-6x); }
  .hero__card--brief  { inset-inline-end: 0;   inset-block-start: var(--space-2x); }
  .hero__card--queue  { inset-inline-start: var(--space-20x); inset-block-start: 62%; inline-size: 272px; }

  /* Cards arrive as the row can actually hold them; two cards plus the figure
     need ~760px, so showing both at 640 put one over her face. */
  @media (min-width: 640.02px) {
    .hero__card--intake { display: grid; inline-size: 258px; }
  }
  @media (min-width: 1080.02px) {
    .hero__card--brief { display: grid; inline-size: 300px; }
    .hero__card--intake { inline-size: 280px; }
  }
  @media (min-width: 1280.02px) {
    .hero__card--queue { display: grid; }
    .hero__card--intake { inline-size: 300px; }
    .hero__card--brief  { inline-size: 330px; }
  }

  .hero__brief-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3x); }

  .hero__esi {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1_5x);
    padding: var(--space-0_5x) var(--space-2_5x);
    border-radius: var(--radius-full);
    background-color: rgb(from var(--solace-20) r g b / 0.16);
    border: 1px solid rgb(from var(--solace-20) r g b / 0.32);
    color: var(--solace-20);
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-medium);
    letter-spacing: normal;
    white-space: nowrap;
  }
  .hero__esi::before {
    content: "";
    inline-size: 6px; block-size: 6px;
    border-radius: var(--radius-full);
    background-color: currentColor;
  }

  .hero__rows { margin: 0; display: grid; font-size: var(--font-size-14); }
  .hero__rows > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4x);
    padding-block: var(--space-1_5x);
    border-block-end: 1px solid rgb(from var(--white) r g b / 0.10);
  }
  .hero__rows > div:last-child { border-block-end: none; }
  .hero__rows dt { color: rgb(from var(--white) r g b / 0.88); }
  .hero__rows dd { margin: 0; color: rgb(from var(--white) r g b / 0.70); }

  .hero__disclosure {
    position: relative;
    z-index: 3;
    margin-block-start: var(--space-16x);
    padding-block: var(--space-8x) var(--space-6x);
    padding-inline: var(--viewport-padding);
    text-align: center;
    font-size: var(--font-size-12);
    color: rgb(from var(--white) r g b / 0.62);
  }
  @media (min-width: 640.02px) {
    .hero__disclosure {
      margin-block-start: var(--space-24x);
      padding-block: 0 var(--space-6x);
      max-inline-size: 40ch;
      text-align: start;
      color: rgb(from var(--white) r g b / 0.55);
    }
  }
</style>
