---
/* The integrations, as a moving gallery rather than a logo grid.

   What this replaces was a ten-cell bordered grid: correct, honest, and the
   single most generic block on the page. Every B2B site has one and they all
   look like the same component with different PNGs in it.

   Two rails, always running, in opposite directions and at different speeds.
   That does three things a static grid cannot: the list runs off both edges so
   ten vendors imply more than ten, the counter-motion keeps the eye finding
   new pairings rather than settling on a shape, and the section has something
   to do while you are reading the heading.

   No JavaScript.

   Heading is "Connects to", NOT "Trusted by" — these are integration targets,
   not customers. */
const vendors = [
  { name: 'Epic',           src: '/assets/logos/epic.png' },
  { name: 'Oracle Cerner',  src: '/assets/logos/cerner.png' },
  { name: 'athenahealth',   src: '/assets/logos/athenahealth.png' },
  { name: 'MEDITECH',       src: '/assets/logos/meditech.png' },
  { name: 'NextGen',        src: '/assets/logos/nextgen.png' },
  { name: 'eClinicalWorks', src: '/assets/logos/eclinicalworks.png' },
  { name: 'Veradigm',       src: '/assets/logos/veradigm.png' },
  { name: 'AdvancedMD',     src: '/assets/logos/advancedmd.png' },
  { name: 'DrChrono',       src: '/assets/logos/drchrono.png' },
  { name: 'Elation Health', src: '/assets/logos/elation.png' },
];

/* Each rail is ONE unit repeated three times, and the units have to be
   byte-identical or the loop cannot be seamless — the animation resets by
   translating exactly one third of the rail's width, which only lands on a
   matching frame if the thirds match. An earlier version interleaved a
   different protocol chip into each copy, which changed both the content and
   the width of every third and would have stuttered once per cycle. */

/* The protocols are the actual claim; the vendor marks only say who it has
   been pointed at. These ride the second rail so the section says something
   rather than just listing brands.

   Real marks, in their own colours. They were brand-green text chips, which
   made the two standards look like Solace features rather than the open
   specifications they are — and green on green read as decoration. The HL7
   FHIR lockup is the official one from hl7.org; the flame alone is HL7's own
   emblem and carries the v2 chip. */
const protocols = [
  { name: 'HL7 v2', src: '/assets/logos/hl7.png', proto: true },
  { name: '', src: '/assets/logos/fhir.png', proto: true },
];

const unitA = [...vendors.slice(0, 5), protocols[1]];
const unitB = [...vendors.slice(5), protocols[0]];
const railA = [...unitA, ...unitA, ...unitA];
const railB = [...unitB, ...unitB, ...unitB];
---

<section class="wall" data-background-color="secondary-default" aria-labelledby="wall-heading">
  <div class="container wall__head">
    <h2 id="wall-heading" class="wall__lede">Connects to the EHR you already run</h2>
  </div>

  <div class="wall__rails" aria-hidden="true">
    <div class="wall__rail wall__rail--a">
      {railA.map((v) => (
        <span class:list={['wall__chip', v.proto && 'wall__chip--proto']}>
          <img src={v.src} alt="" loading="lazy" decoding="async" />
          {v.name}
        </span>
      ))}
    </div>

    <div class="wall__rail wall__rail--b">
      {railB.map((v) => (
        <span class:list={['wall__chip', v.proto && 'wall__chip--proto']}>
          <img src={v.src} alt="" loading="lazy" decoding="async" />
          {v.name}
        </span>
      ))}
    </div>
  </div>

  {/* The rails are decorative duplicates, so the real list is stated once for
      anything that does not render CSS animations or read images. */}
  <p class="visually-hidden">
    Supported integrations: {vendors.map((v) => v.name).join(', ')}. Over HL7 v2, FHIR R4,
    SMART on FHIR and CDS Hooks.
  </p>

</section>

<style>
  .wall { overflow: hidden; padding-block: var(--space-16x); }
  @media (min-width: 640.02px) { .wall { padding-block: var(--space-20x); } }

  .wall__head { padding-block-end: var(--space-10x); }
  .wall__lede {
    text-align: center;
    font-size: var(--font-size-heading-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-text-base);
  }

  .wall__rails { display: flex; flex-direction: column; gap: var(--space-4x); }

  /* Each rail is wider than the viewport on purpose and the section clips it,
     so vendors enter and leave rather than sitting in a box. The mask stops
     them appearing out of a hard edge at the sides. */
  .wall__rail {
    display: flex;
    align-items: center;
    gap: var(--space-4x);
    inline-size: max-content;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 9%, #000 91%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0%, #000 9%, #000 91%, transparent 100%);
  }

  .wall__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2_5x);
    flex: none;
    padding: var(--space-4x) var(--space-6x);
    border-radius: var(--radius-full);
    background-color: var(--white);
    border: 1px solid rgb(from var(--neutral-40) r g b / 22%);
    box-shadow: 0 1px 2px hsl(210 24% 34% / 6%), 0 6px 16px hsl(210 24% 34% / 6%);
    font-size: var(--font-size-text-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-base);
    color: var(--color-text-base);
    white-space: nowrap;
  }
  .wall__chip img { inline-size: 24px; block-size: 24px; flex: none; object-fit: contain; }

  /* Protocol chips sit on the same white as the vendors and carry their own
     marks. A brand-green fill made the two open standards look like Solace
     features, and green on green read as decoration. */
  .wall__chip--proto img { block-size: 20px; inline-size: auto; }

  /* ══ MARQUEE ════════════════════════════════════════════════════════════
     Always moving, in opposite directions, at different speeds.

     The loop is seamless because each rail holds the same set three times and
     travels exactly one third of its own width. At -33.333% the second copy is
     sitting precisely where the first started, so the jump back to 0 lands on
     an identical frame and there is nothing to see. Any other distance shows a
     stutter once per cycle.

     Different periods on the two rails means the pairing of what is above what
     never repeats within a visit. */
  @keyframes wall-left  { from { translate: 0 0; }        to { translate: -33.3333% 0; } }
  @keyframes wall-right { from { translate: -33.3333% 0; } to { translate: 0 0; } }

  @media (prefers-reduced-motion: no-preference) {
    .wall__rail--a { animation: wall-left 46s linear infinite; }
    .wall__rail--b { animation: wall-right 61s linear infinite; }
  }
</style>
