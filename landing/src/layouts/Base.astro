---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/materials.css';

export interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/pricing". Joined against the configured site. */
  canonical?: string;
  ogImage?: string;
}

const { title, description, canonical = Astro.url.pathname, ogImage = '/assets/og-default.png' } = Astro.props;
const canonicalURL = new URL(canonical, Astro.site);
const ogURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" href="/assets/favicon-mark.png" />

    <!-- Self-hosted. Preload only the upright; italic is rare enough to lazy-load. -->
    <link
      rel="preload"
      href="/fonts/InstrumentSans-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogURL} />
  </head>

  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <slot />

    <script>
      /* CLIP RUNNER — the only JavaScript the product graphics need.

         Every animated mockup is a short looping film. The whole timeline lives
         in CSS keyframes declared under `[data-clip][data-play]`, so removing
         the attribute DROPS the animations rather than pausing them. That is
         deliberate and does two jobs at once:

           1. Off-screen clips cost nothing. No compositing, no raf, no battery.
           2. Re-entry replays from frame zero. A clip whose point is "the
              cursor clicks, then the answer appears" is meaningless if you join
              it three seconds in, which is exactly what pausing would give you.

         Without JS, or under reduced motion, the graphic is simply its finished
         state — which is the state every one of them is authored in. */
      const clips = document.querySelectorAll('[data-clip]');
      if (clips.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) entry.target.setAttribute('data-play', '');
              else entry.target.removeAttribute('data-play');
            }
          },
          /* The inset means a clip starts once it is properly on screen rather
             than the instant one pixel clears the fold, so the opening beat is
             never missed. */
          { rootMargin: '-12% 0px -12% 0px', threshold: 0 },
        );
        clips.forEach((clip) => io.observe(clip));
      }
    </script>
  </body>
</html>
