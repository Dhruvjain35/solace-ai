---
import Page from '../layouts/Page.astro';
import PageHeader from '../components/PageHeader.astro';

/* Ported from legacy/src/pages/Hipaa.tsx, plus the shell it used to sit in
   (legacy/src/components/legal/LegalLayout.tsx + Reading.tsx) and the two
   diagrams from legacy/src/components/legal/HipaaVisuals.tsx.

   Copy is carried across verbatim. What changed is the shell: the Framer
   reveals are gone, the reading-progress bar is a CSS scroll-driven animation
   with no JS, and the only script left is the scroll spy, which is state, not
   animation. The legacy table of contents linked to hand-written ids while the
   headings were slugified from their titles, so none of the links resolved.
   The hand-written ids are canonical here and the anchors match them. */

const sections = [
  { id: 'our-role', title: 'Our role: Business Associate' },
  { id: 'privacy-rule', title: 'The Privacy Rule' },
  { id: 'security-rule', title: 'The Security Rule' },
  { id: 'administrative-safeguards', title: 'Administrative safeguards' },
  { id: 'technical-safeguards', title: 'Technical safeguards' },
  { id: 'physical-safeguards', title: 'Physical safeguards' },
  { id: 'phi-isolation', title: 'PHI isolation & minimum necessary' },
  { id: 'breach-notification', title: 'Breach notification' },
  { id: 'what-you-get', title: 'What a covered entity gets' },
  { id: 'requests', title: 'Compliance requests' },
];

const num = (i: number) => String(i + 1).padStart(2, '0');

/* The Security Rule's three safeguard categories mapped to the specific
   controls Solace actually ships. */
const safeguards = [
  {
    cite: '§164.308',
    label: 'Administrative',
    rows: [
      'Role-scoped admin, least-privilege defaults',
      'Tenant-isolation check on every workspace query',
      'Append-only audit log of reads, AI calls, write-backs',
      '749 tests per release; PHI / tenant / consent suites block the build',
    ],
  },
  {
    cite: '§164.312',
    label: 'Technical',
    rows: [
      'Passwordless magic-link sign-in, short-lived JWTs',
      'Customer-managed KMS encryption, in transit and at rest',
      'CloudFront + WAF edge, TLS-only, SSRF guards',
      'Confirm-gated writes: no chart change without a clinician',
    ],
  },
  {
    cite: '§164.310',
    label: 'Physical',
    rows: [
      'Inherited from HIPAA-eligible AWS under AWS’s BAA',
      'Audited data-center, facility and media controls',
      'PHI stored and processed only in covered AWS regions',
      'Solace adds the application-layer controls alongside',
    ],
  },
];

/* The Business-Associate chain, so the obligation flow is obvious. */
const chain = [
  { tag: 'CE', label: 'Covered entity', sub: 'Hospital · ED · urgent care', tone: 'plain' },
  { tag: 'BAA', label: 'BAA', sub: 'Signed before any PHI', tone: 'accent' },
  { tag: 'BA', label: 'Solace', sub: 'Business Associate', tone: 'dark' },
  { tag: 'SUB', label: 'AWS · Bedrock', sub: 'Subprocessors under BAA', tone: 'plain' },
];
---

<Page
  title="HIPAA at Solace: handled as a Business Associate"
  description="How Solace meets the HIPAA Privacy, Security and Breach Notification Rules as a Business Associate, the safeguards behind each one, and what a covered entity gets when you bring us in."
>
  <div class="reading-progress" aria-hidden="true"></div>

  <PageHeader
    title="HIPAA, handled as a Business Associate."
    lede="How Solace meets the Privacy, Security and Breach Notification Rules, and exactly what your organization gets when you bring us in."
    compact
  >
    <p class="stamp tnum">Last updated June 2026</p>
  </PageHeader>

  <section data-background-color="primary-default">
    <div class="container page-section doc-layout">
      <div class="doc">
        {/* Mobile section nav. A <details> needs no script to open. */}
        <details class="doc-nav-m">
          <summary>
            <span class="doc-nav-m__current">
              <span class="tnum doc-nav-m__num" data-current-num>01</span>
              <span data-current-title>Our role: Business Associate</span>
            </span>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <nav aria-label="On this page, compact">
            <ul>
              {sections.map((s, i) => (
                <li>
                  <a href={`#${s.id}`} data-toc-link={s.id}>
                    <span class="tnum doc-nav-m__num">{num(i)}</span>
                    <span>{s.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>

        <article class="doc__article">
          <section id="our-role" class="doc__section" aria-labelledby="our-role-h">
            <div class="doc__head">
              <span class="doc__num tnum" aria-hidden="true">01</span>
              <h2 id="our-role-h" class="doc__title">Our role: Business Associate</h2>
              <a class="doc__anchor tnum" href="#our-role" aria-label="Link to Our role: Business Associate">#</a>
            </div>
            <div class="doc__body">
              <p>
                Solace is a <strong>Business Associate (BA)</strong> under HIPAA, not a Covered
                Entity. We process protected health information (PHI) on behalf of covered entities,
                such as hospitals, emergency departments and urgent care groups, strictly to deliver
                the services you contract us for. We are not the treating provider and we do not
                bill payers; the covered entity remains the steward of the patient relationship.
              </p>
              <p>
                Before any PHI is processed, Solace executes a
                <strong>Business Associate Agreement (BAA)</strong> with the covered entity. Our
                infrastructure runs on HIPAA-eligible AWS services under AWS’s BAA, and model
                inference runs through AWS Bedrock in covered regions, so the obligations flow all
                the way down our subprocessor chain.
              </p>
              <p class="callout">
                We are deliberate about scope. Framing Solace as a BA, not a CE, is the honest
                description of what we do, and it shapes every commitment on this page.
              </p>

              <ol class="chain" aria-label="Business Associate chain">
                {chain.map((node, i) => (
                  <>
                    <li
                      class:list={['chain__node', `chain__node--${node.tone}`]}
                      data-color-scheme={node.tone === 'dark' ? 'dark' : undefined}
                    >
                      <span class="chain__tag tnum">{node.tag}</span>
                      <span class="chain__text">
                        <span class="chain__label">{node.label}</span>
                        <span class="chain__sub">{node.sub}</span>
                      </span>
                    </li>
                    {i < chain.length - 1 && (
                      <li class="chain__link" aria-hidden="true">
                        <svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
                          <path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                      </li>
                    )}
                  </>
                ))}
              </ol>
            </div>
          </section>

          <section id="privacy-rule" class="doc__section" aria-labelledby="privacy-rule-h">
            <div class="doc__head">
              <span class="doc__num tnum" aria-hidden="true">02</span>
              <h2 id="privacy-rule-h" class="doc__title">The Privacy Rule</h2>
              <a class="doc__anchor tnum" href="#privacy-rule" aria-label="Link to The Privacy Rule">#</a>
            </div>
            <div class="doc__body">
              <p>
                As a BA, Solace uses and discloses PHI only as permitted by the BAA and the Privacy
                Rule. We honor the <strong>minimum-necessary</strong> standard, requesting and
                processing only the data a given task requires. We do not sell PHI, we do not use
                PHI for our own marketing, and we never use PHI to train or fine-tune models.
              </p>
              <ul class="bullets">
                <li>Uses and disclosures limited to what the BAA permits.</li>
                <li>Minimum-necessary applied to data access and interop scopes.</li>
                <li>We support the covered entity in meeting individual rights requests.</li>
              </ul>
            </div>
          </section>

          <section id="security-rule" class="doc__section" aria-labelledby="security-rule-h">
            <div class="doc__head">
              <span class="doc__num tnum" aria-hidden="true">03</span>
              <h2 id="security-rule-h" class="doc__title">The Security Rule</h2>
              <a class="doc__anchor tnum" href="#security-rule" aria-label="Link to The Security Rule">#</a>
            </div>
            <div class="doc__body">
              <p>
                The Security Rule requires administrative, technical and physical safeguards for
                electronic PHI. Solace implements all three. Here is the map at a glance; the
                sections below give the detail.
              </p>

              <ul class="matrix">
                {safeguards.map((col) => (
                  <li class="matrix__card">
                    <div class="matrix__top">
                      <h3 class="matrix__label">
                        {col.label} <span class="text-sub">safeguards</span>
                      </h3>
                      <span class="matrix__cite tnum">{col.cite}</span>
                    </div>
                    <ul class="bullets bullets--tight">
                      {col.rows.map((r) => <li>{r}</li>)}
                    </ul>
                  </li>
                ))}
              </ul>
            </div>
          </section>

          <section id="administrative-safeguards" class="doc__section" aria-labelledby="administrative-safeguards-h">
            <div class="doc__head">
              <span class="doc__num tnum" aria-hidden="true">04</span>
              <h2 id="administrative-safeguards-h" class="doc__title">Administrative safeguards</h2>
              <a class="doc__anchor tnum" href="#administrative-safeguards" aria-label="Link to Administrative safeguards">#</a>
            </div>
            <div class="doc__body">
              <ul class="bullets">
                <li>
                  <strong>Access management.</strong> Role-scoped admin, least-privilege defaults,
                  and a tenant-isolation check enforced on every workspace query so staff only ever
                  reach the data they are entitled to.
                </li>
                <li>
                  <strong>Audit controls.</strong> An append-only audit log records chart reads, AI
                  requests, write-backs, sign-ins and admin changes.
                </li>
                <li>
                  <strong>Workforce &amp; change discipline.</strong> 749 automated tests run every
                  release, including dedicated PHI-isolation, tenant-isolation and consent-gate
                  suites that block the build on failure.
                </li>
                <li>
                  <strong>Risk posture.</strong> Our SOC 2 program is in progress; current status,
                  scope and testing summaries are available on request.
                </li>
              </ul>
            </div>
          </section>

          <section id="technical-safeguards" class="doc__section" aria-labelledby="technical-safeguards-h">
            <div class="doc__head">
              <span class="doc__num tnum" aria-hidden="true">05</span>
              <h2 id="technical-safeguards-h" class="doc__title">Technical safeguards</h2>
              <a class="doc__anchor tnum" href="#technical-safeguards" aria-label="Link to Technical safeguards">#</a>
            </div>
            <div class="doc__body">
              <ul class="bullets">
                <li>
                  <strong>Access control.</strong> Passwordless magic-link sign-in, short-lived JWT
                  sessions, and single-use link tokens stored only as hashes.
                </li>
                <li>
                  <strong>Encryption.</strong> Customer-managed AWS KMS keys protect data in transit
                  and at rest; secrets live in AWS Secrets Manager, never inline.
                </li>
                <li>
                  <strong>Transmission security.</strong> TLS-only storage and transport, a
                  CloudFront + WAF edge (IP reputation, OWASP managed rules, rate limiting), and
                  SSRF guards on outbound EHR calls.
                </li>
                <li>
                  <strong>Integrity.</strong> Confirm-gated writes mean nothing reaches the chart
                  without a clinician’s explicit approval.
                </li>
              </ul>
            </div>
          </section>

          <section id="physical-safeguards" class="doc__section" aria-labelledby="physical-safeguards-h">
            <div class="doc__head">
              <span class="doc__num tnum" aria-hidden="true">06</span>
              <h2 id="physical-safeguards-h" class="doc__title">Physical safeguards</h2>
              <a class="doc__anchor tnum" href="#physical-safeguards" aria-label="Link to Physical safeguards">#</a>
            </div>
            <div class="doc__body">
              <p>
                Solace runs on HIPAA-eligible AWS infrastructure. The physical safeguards for the
                data centers, facility access, media controls and device hardening are inherited
                from AWS’s audited environment under AWS’s BAA, which is where electronic PHI is
                stored and processed. Solace adds the application-layer controls described above.
              </p>
            </div>
          </section>

          <section id="phi-isolation" class="doc__section" aria-labelledby="phi-isolation-h">
            <div class="doc__head">
              <span class="doc__num tnum" aria-hidden="true">07</span>
              <h2 id="phi-isolation-h" class="doc__title">PHI isolation &amp; minimum necessary</h2>
              <a class="doc__anchor tnum" href="#phi-isolation" aria-label="Link to PHI isolation and minimum necessary">#</a>
            </div>
            <div class="doc__body">
              <p>
                Our AI is engineered so the model never sees raw PHI. Solace plans and narrates over
                coded, de-identified metadata and <strong>{'{slot}'}</strong> tokens; names, MRNs,
                dates of birth and free-text notes are stripped before any prompt is built. An
                automated leak-gate test fails the build if real PHI could reach a prompt.
              </p>
              <p>
                A recorded-consent chokepoint sits in front of every AI request. With no consent on
                file, the request is refused at the boundary and logged. And because we connect over
                SMART on FHIR v2 with minimum-necessary scopes (HIPAA §164.502(b)), we never hold
                standing access beyond the active workflow.
              </p>
            </div>
          </section>

          <section id="breach-notification" class="doc__section" aria-labelledby="breach-notification-h">
            <div class="doc__head">
              <span class="doc__num tnum" aria-hidden="true">08</span>
              <h2 id="breach-notification-h" class="doc__title">Breach notification</h2>
              <a class="doc__anchor tnum" href="#breach-notification" aria-label="Link to Breach notification">#</a>
            </div>
            <div class="doc__body">
              <p>
                As a BA, Solace will notify the affected covered entity of a breach of unsecured PHI
                without unreasonable delay and within the timeframe set by the Breach Notification
                Rule and our BAA. Our notice includes the information a covered entity needs to meet
                its own downstream obligations: what happened, the PHI involved, and the steps taken
                to mitigate and remediate.
              </p>
              <ul class="bullets">
                <li>Prompt notification to the covered entity per the BAA.</li>
                <li>Documented incident response and remediation.</li>
                <li>Cooperation with the covered entity’s investigation and reporting.</li>
              </ul>
            </div>
          </section>

          <section id="what-you-get" class="doc__section" aria-labelledby="what-you-get-h">
            <div class="doc__head">
              <span class="doc__num tnum" aria-hidden="true">09</span>
              <h2 id="what-you-get-h" class="doc__title">What a covered entity gets</h2>
              <a class="doc__anchor tnum" href="#what-you-get" aria-label="Link to What a covered entity gets">#</a>
            </div>
            <div class="doc__body">
              <ul class="bullets">
                <li>A signed BAA before any PHI is processed.</li>
                <li>Access to the audit trail for reads, AI requests and write-backs.</li>
                <li>A breach incident-response commitment with defined notice timing.</li>
                <li>Our security documentation and SOC 2 status on request, under NDA.</li>
              </ul>
            </div>
          </section>

          <section id="requests" class="doc__section" aria-labelledby="requests-h">
            <div class="doc__head">
              <span class="doc__num tnum" aria-hidden="true">10</span>
              <h2 id="requests-h" class="doc__title">Compliance requests</h2>
              <a class="doc__anchor tnum" href="#requests" aria-label="Link to Compliance requests">#</a>
            </div>
            <div class="doc__body">
              <p>
                For a BAA, security documentation, or our current SOC 2 status, contact
                <strong>security@solace.health</strong>. We respond within one business day.
              </p>
              <p class="callout">
                This page describes Solace’s practices and is provided for information only; it is
                not legal advice and does not replace the terms of an executed BAA. Have your
                privacy officer and counsel review the BAA before launch.
              </p>
            </div>
          </section>
        </article>

        <p class="doc__foot">
          <a class="back-to-top" href="#main">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 13V3M4 7l4-4 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>Back to top</span>
          </a>
        </p>
      </div>

      <aside class="doc-toc">
        <div class="doc-toc__inner">
          <p class="eyebrow">On this page</p>
          <nav aria-label="On this page">
            <ul>
              {sections.map((s, i) => (
                <li>
                  <a href={`#${s.id}`} data-toc-link={s.id}>
                    <span class="tnum doc-toc__num">{num(i)}</span>
                    <span>{s.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    </div>
  </section>
</Page>

<script>
  // State, not animation: the table of contents reflects whichever section owns
  // the viewport. Everything that moves is CSS.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const docSections = Array.from(document.querySelectorAll<HTMLElement>('.doc__section'));

  if (links.length > 0 && docSections.length > 0) {
    const order = docSections.map((s) => s.id);
    const ratios = new Map<string, number>();
    const currentNum = document.querySelector<HTMLElement>('[data-current-num]');
    const currentTitle = document.querySelector<HTMLElement>('[data-current-title]');

    const setActive = (id: string) => {
      links.forEach((a) => {
        const on = a.dataset.tocLink === id;
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      const index = order.indexOf(id);
      if (index < 0) return;
      const heading = docSections[index].querySelector('.doc__title');
      if (currentNum) currentNum.textContent = String(index + 1).padStart(2, '0');
      if (currentTitle && heading) currentTitle.textContent = heading.textContent ?? '';
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          ratios.set((entry.target as HTMLElement).id, entry.intersectionRatio);
        }
        let best = '';
        let bestRatio = 0;
        for (const id of order) {
          const ratio = ratios.get(id) ?? 0;
          if (ratio > bestRatio) {
            best = id;
            bestRatio = ratio;
          }
        }
        if (best) setActive(best);
      },
      { rootMargin: '-20% 0px -65% 0px', threshold: [0, 0.25, 0.5, 1] },
    );

    docSections.forEach((s) => io.observe(s));

    // Close the mobile disclosure once a jump has been chosen.
    const disclosure = document.querySelector<HTMLDetailsElement>('.doc-nav-m');
    disclosure?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) disclosure.open = false;
    });
  }
</script>

<style>
  /* ── Reading progress. Scroll-driven, no JS. Browsers without scroll
     timelines keep the bar at scale 0, so it simply never appears. ────────── */
  .reading-progress {
    position: fixed;
    inset-inline: 0;
    inset-block-start: var(--page-header-height);
    z-index: calc(var(--z-header) - 1);
    block-size: var(--space-0_5x);
    scale: 0 1;
    transform-origin: 0 50%;
    background-image: linear-gradient(90deg, var(--solace-80), var(--solace-50), var(--solace-30));
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    .reading-progress {
      animation: reading-progress linear forwards;
      animation-timeline: scroll(root block);
    }
  }
  @keyframes reading-progress { to { scale: 1 1; } }

  .stamp {
    margin-block-start: var(--space-2x);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-sub);
  }

  /* ── Body layout: prose column, table of contents at 1080.02. ──────────── */
  .doc-layout { display: grid; gap: var(--space-12x); align-items: start; }
  @media (min-width: 1080.02px) {
    .doc-layout { grid-template-columns: minmax(0, 1fr) 240px; gap: var(--space-16x); }
  }

  .doc { min-inline-size: 0; }

  /* ── Document sections ────────────────────────────────────────────────── */
  .doc__section {
    padding-block: var(--space-12x);
    border-block-start: 1px solid var(--color-border-sub);
    scroll-margin-block-start: calc(var(--page-header-height) + var(--space-8x));
  }
  .doc__section:first-child { padding-block-start: 0; border-block-start: none; }

  .doc__head { display: flex; align-items: baseline; gap: var(--space-4x); }

  .doc__num {
    flex: none;
    font-weight: var(--font-weight-medium);
    color: var(--solace-80);  /* solace-50 is 2.35:1 on white; 80 is 6.54:1 */
  }

  .doc__title {
    font-size: var(--font-size-heading-small);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
  }

  .doc__anchor {
    flex: none;
    align-self: center;
    color: var(--color-text-soft);
    opacity: 0;
    transition: opacity var(--motion-duration-base) var(--ease-ui),
                color var(--motion-duration-base) var(--ease-ui);
  }
  .doc__head:hover .doc__anchor,
  .doc__anchor:focus-visible { opacity: 1; }
  .doc__anchor:hover { color: var(--color-action-primary); }

  .doc__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4x);
    margin-block-start: var(--space-5x);
    font-size: var(--font-size-text-small);
  }
  @media (min-width: 640.02px) {
    .doc__body { font-size: var(--font-size-text-medium); margin-inline-start: var(--space-9x); }
  }

  .doc__body p { max-inline-size: 68ch; color: var(--color-text-sub); }
  .doc__body p + p { margin-block-start: 0; }
  .doc__body strong { font-weight: var(--font-weight-semibold); color: var(--color-text-base); }

  /* ── Bullets. Hollow circles, never filled dots. ──────────────────────── */
  .bullets {
    display: grid;
    gap: var(--space-3x);
    max-inline-size: 68ch;
    color: var(--color-text-sub);
  }
  .bullets li { position: relative; padding-inline-start: var(--space-7x); }
  .bullets li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.45em;
    inline-size: 12px;
    block-size: 12px;
    border: 1.5px solid var(--color-icon-soft);
    border-radius: 50%;
  }
  .bullets--tight { gap: var(--space-2_5x); font-size: var(--font-size-text-small); }

  /* ── Callout. A quiet aside for the counsel-review notices. ───────────── */
  .callout {
    padding: var(--space-4x) var(--space-5x);
    border-radius: var(--radius-2x);
    border: 1px solid rgb(from var(--solace-50) r g b / 18%);
    border-inline-start: var(--space-0_5x) solid var(--solace-50);
    background-color: var(--color-bg-accent-subdued);
  }

  /* ── Trust chain ──────────────────────────────────────────────────────── */
  .chain {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3x);
    margin-block-start: var(--space-2x);
  }
  @media (min-width: 1080.02px) {
    .chain { flex-direction: row; align-items: stretch; }
  }

  .chain__node {
    display: flex;
    align-items: center;
    gap: var(--space-3x);
    padding: var(--space-5x);
    border-radius: var(--radius-4x);
  }
  @media (min-width: 1080.02px) {
    .chain__node {
      flex: 1 1 0;
      min-inline-size: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4x);
    }
  }

  .chain__node--plain {
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border-sub);
    box-shadow: var(--elevation-xsmall);
  }
  .chain__node--accent {
    background-color: var(--color-action-primary);
    color: var(--color-text-inverse);
  }
  /* Opts into the dark scheme rather than hardcoding white type, so the tokens
