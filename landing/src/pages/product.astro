---
import Page from '../layouts/Page.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaPrimary from '../components/CtaPrimary.astro';
import PhoneFrame from '../components/mockups/PhoneFrame.astro';
import ScreenIntake from '../components/mockups/ScreenIntake.astro';
import GraphicTriage from '../components/mockups/GraphicTriage.astro';
import GraphicQueue from '../components/mockups/GraphicQueue.astro';
import GraphicWorkflows from '../components/mockups/GraphicWorkflows.astro';
import GraphicScribe from '../components/mockups/GraphicScribe.astro';
import GraphicAtlas from '../components/mockups/GraphicAtlas.astro';
import GraphicLetters from '../components/mockups/GraphicLetters.astro';
import GraphicChart from '../components/mockups/GraphicChart.astro';
import ClipCaption from '../components/mockups/ClipCaption.astro';
import ActGlyph from '../components/mockups/ActGlyph.astro';
import HeroGlass from '../components/mockups/HeroGlass.astro';

/* Rebuilt as seven acts.

   The page this replaces was a column of numbered rows with screenshots of the
   demo video dropped between them. Eleven steps in a single stack, each one a
   line of text, and the pictures were captures — fixed resolution, locked to
   whatever copy happened to be on screen the day they were taken.

   The structure here is Superhuman's product idiom: one idea per act, copy on
   one side, the product on the other, sides alternating so the eye crosses the
   page instead of running down a gutter. Every figure is live DOM and every one
   of them is a short looping film, so each act shows the thing WORKING rather
   than a still of it having worked.

   Motion, in two layers and no framework:

     - The clips are CSS keyframes on a shared per-graphic timeline, started and
       restarted by the observer in Base.astro. This is the layer framer-motion
       would normally own; it is keyframes because a scripted animation library
       cannot beat CSS at a six-second loop that has to run in twelve places on
       one page without dropping frames.
     - The reveals are scroll-driven `animation-timeline: view()`, which is what
       framer-motion's whileInView does, natively and with nothing to download.

   Both are inside prefers-reduced-motion guards, and the static frame of every
   graphic is its finished state — so with motion off the page is complete, not
   empty. */

type Act = {
  id?: string;
  index: string;
  chapter: string;
  heading: string;
  sub: string;
  glyph: string;
  bed: 'paper' | 'slate' | 'ink';
  mock: 'intake' | 'triage' | 'queue' | 'workflows' | 'scribe' | 'atlas' | 'letters' | 'chart';
};

const acts: Act[] = [
  {
    id: 'patient-side',
    index: '01',
    chapter: 'In the waiting room',
    heading: 'Check in from the waiting room chair',
    glyph: 'intake',
    sub: 'A QR code on the wall opens Solace on their own phone. They tell their story once, in their own language, while they wait.',
    bed: 'paper',
    mock: 'intake',
  },
  {
    index: '02',
    chapter: 'In the waiting room',
    heading: 'Urgency you can check',
    glyph: 'triage',
    sub: 'A suggested level lands the moment intake ends, with the evidence that produced it sitting right beside it.',
    bed: 'slate',
    mock: 'triage',
  },
  {
    id: 'clinician-side',
    index: '03',
    chapter: 'At the board',
    heading: 'The queue sorts itself',
    glyph: 'queue',
    sub: 'Everyone waiting, in one view, ordered by who needs help first. It re-sorts the second a new reading changes something.',
    bed: 'ink',
    mock: 'queue',
  },
  {
    id: 'workflows',
    index: '04',
    chapter: 'Behind the board',
    heading: 'Write the rule once',
    glyph: 'workflow',
    sub: 'Nine real events, branching conditions, fourteen actions, no code. No identifier ever leaves with the payload.',
    bed: 'slate',
    mock: 'workflows',
  },
  {
    index: '05',
    chapter: 'In the room',
    heading: 'The note writes itself',
    glyph: 'scribe',
    sub: 'Have the conversation. The draft builds as you go, and every clause stays attached to the moment it came from.',
    bed: 'paper',
    mock: 'scribe',
  },
  {
    index: '06',
    chapter: 'In the room',
    heading: 'Ask the chart anything',
    glyph: 'atlas',
    sub: 'Most of a real history is unstructured and belongs to somebody else. Atlas reads the faxes too, then cites them.',
    bed: 'slate',
    mock: 'atlas',
  },
  {
    index: '07',
    chapter: 'After the visit',
    heading: 'The paperwork is already done',
    glyph: 'letters',
    sub: 'Work notes, school notes, FMLA, return to play. Two dozen forms that fill themselves in from the visit.',
    bed: 'paper',
    mock: 'letters',
  },
  {
    index: '08',
    chapter: 'Into the chart',
    heading: 'It lands in the chart, coded',
    glyph: 'chart',
    sub: 'Through the same interfaces your hospital already runs. As real fields, not a PDF stapled to the side.',
    bed: 'ink',
    mock: 'chart',
  },
];

const INTAKE_CAPTIONS = [
  'Scan the code on the wall. No app, no account.',
  'Choose from twenty languages.',
  'Answer out loud, in your own words.',
  'Follow-ups adapt to what you just said.',
  'It reaches the care team before the patient does.',
];

const megaText =
  'Calm, understandable emergency care has never been easier. And when everyone can see the line, the waiting room finally makes sense, to the people running it and the people sitting in it.';

const faqs = [
  {
    q: 'Where does Solace run?',
    a: 'Patients check in on their own phone from a QR code in your waiting room. There is nothing to install. Clinicians see the summary on their dashboard or inside the tools they already use.',
  },
  {
    q: 'Does Solace replace triage nurses?',
    a: 'No. Solace handles the paperwork side. It drafts a suggested urgency level and a clean history so your nurses start informed, and a clinician always makes the call.',
  },
  {
    q: 'What languages are supported?',
    a: '20 at launch, voice and text. The patient speaks in their own language, and the care team reads it in theirs.',
  },
  {
    q: 'How does it connect to our EHR?',
    a: 'Through the standard hospital interfaces, HL7 and FHIR. The summary lands in the patient chart as real fields, not a PDF.',
  },
  {
    q: 'Can patients check in by phone?',
    a: 'Yes. The phone agent takes the same story by voice, in the same 20 languages. If anything sounds like an emergency, the caller is told to dial 911 right away and your team is alerted.',
  },
];
---

<Page
  title="How Solace works: from the front door to the chart"
  description="The complete Solace journey. Every step a patient takes on their own phone, and everything the care team sees before the room is ready."
>
  <PageHeader
    title="From the front door to the chart."
    lede="Eight moments, in the order they happen. Every screen below is the real interface, running."
  >
    <div class="page-hero-figure">
      <HeroGlass variant="intake" />
    </div>
  </PageHeader>

  <!-- ══ THE SEVEN ACTS ═══════════════════════════════════════════════════ -->
  {acts.map((act, i) => (
    <section
      id={act.id ?? `act-${act.index}`}
      class:list={['act', i % 2 === 1 && 'act--flip']}
      data-background-color={i % 2 === 1 ? 'secondary-default' : 'primary-default'}
      aria-labelledby={`act-${act.index}`}
    >
      <div class="container act__inner">
        <div class="act__copy reveal">
          <p class="act__chapter">
            <span class="act__index">{act.index}</span>
            <span class="act__rule" aria-hidden="true"></span>
            <span>{act.chapter}</span>
          </p>
          <h2 id={`act-${act.index}`} class="heading-medium act__heading">{act.heading}<ActGlyph kind={act.glyph} /></h2>
          <p class="text-medium text-sub act__sub">{act.sub}</p>
        </div>

        <figure class:list={['act__stage', 'reveal', `act__stage--${act.bed}`]}>
          <span class="act__ghost" aria-hidden="true">{act.index}</span>

          {/* On the phone act, data-clip sits on the WRAPPER rather than on the
              screen inside the aperture, so one observer drives the device and
              the caption narrating it. Two observers could start a frame apart
              and the caption would describe the wrong beat. */}
          {act.mock === 'intake' ? (
            <div class="act__device" data-clip>
              <PhoneFrame width="clamp(216px, 24vw, 280px)"><ScreenIntake /></PhoneFrame>
              <ClipCaption steps={INTAKE_CAPTIONS} />
            </div>
          ) : (
            <div class="act__mock">
              {act.mock === 'triage'  && <GraphicTriage />}
              {act.mock === 'workflows' && <GraphicWorkflows />}
              {act.mock === 'queue'   && <GraphicQueue />}
              {act.mock === 'scribe'  && <GraphicScribe />}
              {act.mock === 'atlas'   && <GraphicAtlas />}
              {act.mock === 'letters' && <GraphicLetters />}
              {act.mock === 'chart'   && <GraphicChart />}
            </div>
          )}
        </figure>
      </div>
    </section>
  ))}

  <!-- ══ Mega statement ═══════════════════════════════════════════════════ -->
  <section data-background-color="primary-default">
    <div class="container page-section">
      <p class="statement">
        <span class="visually-hidden">{megaText}</span>
        <span aria-hidden="true">
          {megaText.split(' ').map((word, i, all) => (
            <>
              <span class="scrub"><span class="scrub__ink">{word}</span></span>
              {i < all.length - 1 ? ' ' : ''}
            </>
          ))}
        </span>
      </p>
    </div>
  </section>

  <!-- ══ The phone agent ══════════════════════════════════════════════════ -->
  <section id="phone" data-background-color="secondary-default" aria-labelledby="phone-heading">
    <div class="container page-section phone">
      <div class="phone__lead reveal">
        <p class="eyebrow">Phone agent</p>
        <div class="dashed" aria-hidden="true"></div>
        <h2 id="phone-heading" class="heading-medium">Not everyone arrives holding a phone they can use.</h2>
      </div>
      <div class="phone__body reveal">
        <p class="text-large">
          So the same intake runs on a phone call. The agent takes the same story by voice, in the
          same 20 languages. If anything sounds like an emergency, the caller is told to dial 911
          right away and your team is alerted.
        </p>
        <a class="arrow-link" href="/demo">
          <span>Hear it on a demo call</span>
          <svg viewBox="0 0 20 14.17" fill="none" aria-hidden="true">
            <circle cx="2" cy="7.08" r="1.6" fill="currentColor" />
            <path
              d="M6.5 7.08h11M13.4 2.2l4.9 4.88-4.9 4.89"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ══ Closing band ═════════════════════════════════════════════════════ -->
  <section data-background-color="primary-default" aria-labelledby="closing-heading">
    <div class="container page-section">
      <div class="band">
        <div class="band__copy">
          <h2 id="closing-heading" class="band__heading reveal">
            Every patient knows where they stand.
          </h2>
          <p class="band__sub text-large reveal">
            A clear priority, an honest wait time and what happens next. On their own phone, in
            their own language.
          </p>
          <div class="band__actions reveal">
            <CtaPrimary href="/demo" label="Book a Demo" />
            <a class="cta-secondary" href="/demo">Try the Patient Flow</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══ FAQ ══════════════════════════════════════════════════════════════ -->
  <section id="faq" data-background-color="secondary-default" aria-labelledby="faq-heading">
    <div class="container page-section faq">
      <h2 id="faq-heading" class="heading-medium">Solace FAQs</h2>

      <ul class="faq__list">
        {faqs.map((faq) => (
          <li>
            <details class="faq__item">
              <summary class="faq__q">
                <span>{faq.q}</span>
                <svg class="faq__chev" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M4 6.25 8 10.25l4-4"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <div class="faq__a">
                <p class="text-medium text-sub">{faq.a}</p>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Page>

<style>
  .page-hero-figure {
    margin-block-start: var(--space-8x);
    inline-size: 100%;
    display: flex;
    justify-content: center;
  }

  /* ══ ACTS ═══════════════════════════════════════════════════════════════ */
  .act__inner {
    display: grid;
    gap: var(--space-10x);
    align-items: center;
    padding-block: var(--space-16x);
  }
  @media (min-width: 640.02px) {
    .act__inner { padding-block: var(--space-20x); }
  }
  @media (min-width: 1080.02px) {
    .act__inner {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
      gap: var(--space-16x);
      padding-block: var(--space-24x);
    }
    /* Sides alternate so the eye crosses the page instead of running down one
       gutter for seven screens. The DOM order never changes — only the visual
       column — so the reading order stays copy-then-figure throughout. */
    .act--flip .act__copy  { order: 2; }
    .act--flip .act__stage { order: 1; }
  }

  .act__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4x);
  }

  .act__chapter {
    display: flex;
    align-items: center;
    gap: var(--space-3x);
    font-size: var(--font-size-text-small);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-sub);
  }
  .act__index {
    color: var(--color-primary-base);
    font-variant-numeric: tabular-nums;
  }
  .act__rule {
    inline-size: var(--space-8x);
    block-size: 1px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--color-border-sub) 0, var(--color-border-sub) 4px,
      transparent 4px, transparent 8px
    );
  }

  .act__heading { max-inline-size: 15ch; font-size: var(--font-size-heading-large); }
  .act__sub { max-inline-size: 42ch; font-size: var(--font-size-text-large); }


  /* ── The stage ───────────────────────────────────────────────────────────
     A tinted bed with the product floating on it. The specular sweep across
     the top-left is what stops a flat two-stop gradient from reading as a
     coloured rectangle. */
  .act__stage {
    position: relative;
    overflow: hidden;
    margin: 0;
    display: grid;
    place-items: center;
    /* The top padding is not breathing room, it is a band: the act number
       lives there. Sat over the figure it was covered on every act but the
       first, which is the whole reason it now gets its own strip. */
    padding: var(--space-20x) var(--space-5x) var(--space-10x);
    border-radius: var(--radius-8x);
    border: 1px solid rgb(from var(--neutral-40) r g b / 18%);
  }
  @media (min-width: 640.02px) {
    .act__stage { padding: var(--space-24x) var(--space-8x) var(--space-12x); }
  }

  /* Three beds, none of them tinted with the brand colour. The mint stage was
     the single biggest source of the light-green-shape look, and a product
     figure does not need its background to be on-brand — the figure is. */
  .act__stage--paper {
    background-image:
      radial-gradient(ellipse 62% 48% at 26% 10%, rgb(from var(--white) r g b / 72%), transparent 72%),
      linear-gradient(158deg, var(--neutral-5) 0%, var(--neutral-10) 50%, var(--neutral-20) 100%);
  }
  .act__stage--slate {
    background-image:
      radial-gradient(ellipse 62% 48% at 26% 10%, rgb(from var(--white) r g b / 52%), transparent 72%),
      linear-gradient(158deg, var(--slate-10) 0%, var(--slate-20) 58%, #9db4bd 100%);
  }
  .act__stage--ink {
    background-image:
      radial-gradient(ellipse 58% 46% at 24% 8%, rgb(from var(--slate-40) r g b / 32%), transparent 74%),
      linear-gradient(158deg, var(--slate-90) 0%, var(--slate-100) 52%, var(--slate-black) 100%);
    border-color: rgb(from var(--slate-black) r g b / 55%);
  }

  /* The act number, set large and low-contrast in the corner. Editorial
     furniture: it gives the bed a second plane without adding an object. */
  /* Sized to the band it sits in, never taller than it. Each bed gets its own
     ink: white reads on teal, mist and deep but disappears into sand, where a
     warm taupe is the only thing with anything to push against. */
  .act__ghost {
    position: absolute;
    inset-block-start: var(--space-5x);
    inset-inline-end: var(--space-7x);
    font-size: clamp(44px, 5.4vw, 78px);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    letter-spacing: var(--letter-spacing-display);
    font-variant-numeric: tabular-nums;
    color: rgb(from var(--white) r g b / 88%);
    pointer-events: none;
  }
  .act__stage--paper .act__ghost { color: rgb(from var(--neutral-40) r g b / 50%); }
  .act__stage--ink .act__ghost { color: rgb(from var(--white) r g b / 20%); }

  /* The graphics measure themselves in cqw, and an element cannot be its own
     query container — so the container has to be this wrapper, sized to the
     graphic rather than to the padded stage. */
  .act__mock {
    position: relative;
    container-type: inline-size;
    inline-size: 100%;
    max-inline-size: 600px;
  }
  /* The phone act's caption sits under the device on the stage rather than
     inside the screen — it narrates the act, it is not app chrome. */
  .act__device {
    /* The clip root for this act, so it owns the tempo the caption reads. */
    --clip-dur: 10s;
    position: relative;
    inline-size: 100%;
    max-inline-size: 420px;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6x);
  }

  /* ══ Scrubbed statement ═════════════════════════════════════════════════ */
  .statement {
    font-size: var(--font-size-display-small);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
    max-inline-size: 24ch;
  }
  .scrub { display: inline-block; opacity: 1; }
  /* background-clip has to sit on the word, because the opacity that scrubs
     lives on its parent and would not fade a gradient painted by an ancestor.
     Per-word clipping restarts the ramp inside every word, which reads as
     candy stripes; anchoring the background to the viewport instead makes all
     the words sample one continuous ramp. */
  .scrub__ink {
    -webkit-background-clip: text;
    background-clip: text;
    background-attachment: fixed;
    color: transparent;
    background-image: linear-gradient(
      123.97deg,
      var(--solace-60) 10.62%,
      #5e9da8 49.7%,
      var(--slate-60) 89.61%
    );
  }

  /* ══ Phone agent ════════════════════════════════════════════════════════ */
  .phone { display: grid; gap: var(--space-8x); }
  @media (min-width: 1080.02px) {
    .phone { grid-template-columns: 1fr minmax(0, 480px); column-gap: var(--space-16x); }
  }
  .phone__lead { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4x); }
  .phone__lead h2 { max-inline-size: 18ch; }
  .phone__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-6x); }
  .phone__body p { color: var(--color-text-sub); }

  .dashed {
    inline-size: min(100%, 320px);
    block-size: 1px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--color-border-sub) 0, var(--color-border-sub) 4px,
      transparent 4px, transparent 8px
    );
  }

  /* ══ Closing band ═══════════════════════════════════════════════════════ */
  .band {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-6x);
    padding-inline: var(--space-6x);
    padding-block: var(--space-16x);
    text-align: center;
    background-image: linear-gradient(
      160deg,
      var(--solace-10) 0%,
      var(--solace-20) 50%,
      #a0d7c4 100%
    );
    color: var(--neutral-90);
  }
  @media (min-width: 640.02px) {
    .band { padding-inline: var(--space-10x); padding-block: var(--space-24x); }
  }

  .band__copy { display: flex; flex-direction: column; align-items: center; }
  .band__heading {
    font-size: var(--font-size-display-small);
    font-weight: var(--font-weight-medium);
    line-height: 96%;
    letter-spacing: var(--letter-spacing-display);
    max-inline-size: 18ch;
  }
  .band__sub { margin-block-start: var(--space-6x); max-inline-size: 44ch; color: var(--neutral-80); }
  .band__actions {
    margin-block-start: var(--space-9x);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3x);
  }

  /* ══ FAQ ════════════════════════════════════════════════════════════════ */
  .faq { display: grid; gap: var(--space-10x); }
  @media (min-width: 1080.02px) {
    .faq { grid-template-columns: repeat(2, 1fr); column-gap: var(--space-6x); }
  }

  .faq__list {
    inline-size: 100%;
    max-inline-size: 36rem;
    interpolate-size: allow-keywords;
  }
  @media (min-width: 1080.02px) {
    .faq__list { margin-inline-start: auto; }
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6x);
    padding-block: var(--space-6x);
    border-block-end: 1px solid var(--color-border-sub);
    font-size: var(--font-size-text-medium);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    list-style: none;
  }
  .faq__q::-webkit-details-marker { display: none; }

  .faq__chev {
    flex: none;
    inline-size: 20px;
    color: var(--color-icon-sub);
    transition: rotate var(--motion-duration-slow) var(--ease-ui);
  }
  .faq__item[open] .faq__chev { rotate: 180deg; }

  .faq__a { padding-block: var(--space-6x); border-block-end: 1px solid var(--color-border-sub); }

  /* Native disclosure animation. Falls back to an instant open where
     ::details-content is not supported, which is the correct degradation. */
  .faq__item::details-content {
    block-size: 0;
    overflow: hidden;
    transition-property: block-size, content-visibility;
    transition-duration: var(--motion-duration-slow);
    transition-timing-function: var(--ease-ui);
    transition-behavior: allow-discrete;
  }
  .faq__item[open]::details-content { block-size: auto; }

  /* ══ SCROLL MOTION ══════════════════════════════════════════════════════
     Scroll-driven CSS, no JavaScript. Everything is behind a reduced-motion
     guard and a support query, so the page is fully legible without either. */
  /* Not a fade. Content is revealed by a wipe — a clip edge travelling up the
     block while it rises the last few pixels into place — so the words are
     opaque the whole way and the motion reads as material moving rather than as
     a page still loading. A scroll-triggered opacity fade is the single most
     over-used effect on the web and it makes everything it touches feel
     identical; this costs the same and does not. */
  @keyframes hiw-reveal {
    from { clip-path: inset(18% 0 0 0); translate: 0 var(--space-5x); }
    to   { clip-path: inset(0 0 0 0);   translate: 0 0; }
  }
  @keyframes hiw-scrub {
    from { opacity: 0.16; }
    to   { opacity: 1; }
  }
  @keyframes hiw-band-rise {
    from { translate: 0 24vh; }
    to   { translate: 0 var(--space-8x); }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .reveal {
        animation: hiw-reveal linear both;
        animation-timeline: view();
