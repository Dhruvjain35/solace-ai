---
import Page from '../layouts/Page.astro';
import PageHeader from '../components/PageHeader.astro';

/* Long-form legal reading layout. The document is data so the numbering, the
   sticky table of contents and the mobile jump list can never drift out of
   sync with the prose. Copy is carried across verbatim from the legacy
   Privacy.tsx; only the em-dash-free house style and real links are new. */

type Block =
  | { kind: 'p'; html: string }
  | { kind: 'list'; items: string[] }
  | { kind: 'note'; html: string };

interface Clause {
  id: string;
  title: string;
  blocks: Block[];
}

const clauses: Clause[] = [
  {
    id: 'overview',
    title: 'Overview',
    blocks: [
      {
        kind: 'note',
        html: 'This is a template policy provided for information only. It is not legal advice and must be reviewed and adapted by qualified counsel before launch.',
      },
      {
        kind: 'p',
        html: 'This Privacy Policy explains how Solace AI, Inc. (“Solace,” “we,” “us”) handles information in connection with our patient-intake and clinical-triage services (the “Services”). Solace serves healthcare organizations. Most patient health information we touch is handled as a <strong>Business Associate</strong> on behalf of a covered entity, and is governed first by the Business Associate Agreement (BAA) and HIPAA, not by this consumer-facing policy.',
      },
    ],
  },
  {
    id: 'information-we-collect',
    title: 'Information we collect',
    blocks: [
      {
        kind: 'list',
        items: [
          '<strong>Clinician &amp; account data.</strong> Name, work email, organization, role and authentication metadata for the people who use Solace at a customer site.',
          '<strong>Patient PHI processed for covered entities.</strong> Intake responses, demographics, insurance details and related clinical data submitted during a visit, processed under the BAA. See the next section.',
          '<strong>Usage &amp; telemetry.</strong> Log data, device and browser details, and aggregate performance and reliability metrics, used to operate and improve the Services.',
          '<strong>Cookies &amp; similar technologies.</strong> Strictly necessary and analytics cookies as described below.',
        ],
      },
    ],
  },
  {
    id: 'patient-phi',
    title: 'Patient PHI & the BA relationship',
    blocks: [
      {
        kind: 'p',
        html: 'When Solace processes patient PHI, it does so as a <strong>Business Associate</strong> of the covered entity, strictly to deliver the Services and only as the BAA permits. The covered entity, not Solace, is the steward of the patient relationship and the primary point of contact for patient privacy rights.',
      },
      {
        kind: 'list',
        items: [
          'We do not sell patient PHI.',
          'We never use patient PHI to train or fine-tune AI models.',
          'Our AI plans and narrates over coded, de-identified metadata and slot tokens; raw identifiers are stripped before any model prompt, enforced by an automated leak-gate test in the build.',
        ],
      },
    ],
  },
  {
    id: 'how-we-use-it',
    title: 'How we use information',
    blocks: [
      {
        kind: 'list',
        items: [
          'To provide, secure, maintain and improve the Services.',
          'To authenticate users and protect against fraud and abuse.',
          'To communicate about your account, the Services and support.',
          'To meet legal, regulatory and contractual obligations, including those under the BAA.',
        ],
      },
      {
        kind: 'p',
        html: 'We do not use patient PHI for advertising, and we do not use it to train models. Aggregate, de-identified usage metrics that contain no PHI may be used to improve the Services.',
      },
    ],
  },
  {
    id: 'how-we-share-it',
    title: 'How we share information',
    blocks: [
      {
        kind: 'list',
        items: [
          '<strong>With the covered entity.</strong> Patient PHI is returned to and shared with the covered entity that owns the patient relationship.',
          '<strong>With subprocessors.</strong> Vetted vendors that help us run the Services under contract and, where PHI is involved, under a BAA.',
          '<strong>For legal reasons.</strong> When required by law or to protect rights, safety and the integrity of the Services.',
          '<strong>In a business transfer.</strong> Subject to this policy and the BAA, in connection with a merger, acquisition or sale of assets.',
        ],
      },
      { kind: 'p', html: 'We do not sell personal information or patient PHI.' },
    ],
  },
  {
    id: 'subprocessors',
    title: 'Subprocessors',
    blocks: [
      {
        kind: 'p',
        html: 'We rely on a small set of infrastructure subprocessors, each bound by contract and, where PHI is involved, by a BAA:',
      },
      {
        kind: 'list',
        items: [
          '<strong>Amazon Web Services (AWS).</strong> HIPAA-eligible cloud hosting, storage and key management, under AWS’s BAA.',
          '<strong>Anthropic, via AWS Bedrock.</strong> Model inference runs through Bedrock in covered regions under BAA; prompts contain only coded, de-identified metadata, never raw PHI.',
        ],
      },
      {
        kind: 'p',
        html: 'A current list of subprocessors is available to customers on request.',
      },
    ],
  },
  {
    id: 'retention-ttl',
    title: 'Retention & TTL',
    blocks: [
      {
        kind: 'p',
        html: 'We practice data minimization. Intake sessions are short-lived, and patient records and media carry an <strong>automatic TTL</strong> that expires them on schedule. Magic-link tokens are single-use and stored only as hashes. Account and contract data are retained for as long as your organization uses the Services and as required by law, then deleted or de-identified. PHI retention and disposal follow the terms of the BAA.',
      },
    ],
  },
  {
    id: 'security',
    title: 'Security',
    blocks: [
      {
        kind: 'p',
        html: 'We protect data with customer-managed AWS KMS encryption in transit and at rest, secrets held in AWS Secrets Manager, passwordless magic-link sign-in with short-lived JWT sessions, role-scoped access with tenant-isolation checks, a CloudFront + WAF edge, SSRF guards on outbound calls, and an append-only audit log.',
      },
    ],
  },
  {
    id: 'your-rights',
    title: 'Your rights',
    blocks: [
      {
        kind: 'p',
        html: 'Depending on your jurisdiction, you may have rights to access, correct, delete, port or restrict the processing of your personal information. For <strong>patient PHI</strong>, individual rights requests are directed to and fulfilled by the covered entity that owns the patient relationship; Solace supports the covered entity in meeting them. For clinician and account data, contact us using the details below.',
      },
    ],
  },
  {
    id: 'cookies',
    title: 'Cookies & telemetry',
    blocks: [
      {
        kind: 'p',
        html: 'We use strictly necessary cookies to run the Services and limited analytics to understand performance and reliability. Where required, we obtain consent for non-essential cookies, and you can control cookies through your browser settings.',
      },
    ],
  },
  {
    id: 'children',
    title: 'Children’s privacy',
    blocks: [
      {
        kind: 'p',
        html: 'The Services are intended for healthcare organizations and their staff, not for direct use by children. Any pediatric PHI processed during a visit is handled as PHI under the BAA and the covered entity’s direction, not collected by Solace for its own purposes.',
      },
    ],
  },
  {
    id: 'international',
    title: 'International users',
    blocks: [
      {
        kind: 'p',
        html: 'The Services are operated from, and data is processed in, the United States. If you access the Services from outside the United States, you understand that your information will be processed in the U.S., and where applicable we rely on appropriate safeguards for any cross-border transfer.',
      },
    ],
  },
  {
    id: 'changes',
    title: 'Changes to this policy',
    blocks: [
      {
        kind: 'p',
        html: 'We may update this policy from time to time. When we make material changes, we will update the “Last updated” date above and, where appropriate, provide additional notice. Your continued use of the Services after an update means you accept the revised policy.',
      },
    ],
  },
  {
    id: 'contact',
    title: 'Contact us',
    blocks: [
      {
        kind: 'p',
        html: 'Questions about this policy or our data practices? Email <a href="mailto:privacy@solace.health"><strong>privacy@solace.health</strong></a>. We respond within one business day.',
      },
      {
        kind: 'note',
        html: 'Reminder: this template requires review by counsel before launch to ensure it reflects your final practices and the laws that apply to your organization.',
      },
    ],
  },
];

const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Page
  title="Privacy policy | Solace"
  description="How Solace collects, uses, shares and protects information, including the protected health information we process on behalf of covered entities."
>
  <div class="legal-progress" aria-hidden="true"></div>

  <PageHeader
    title="Your data, treated like it matters."
    lede="How Solace collects, uses, shares and protects information, including the protected health information we process on behalf of covered entities."
    compact
  >
    <p class="tnum legal-stamp">Last updated June 2026</p>
  </PageHeader>

  <section data-background-color="primary-default" aria-label="Privacy policy document">
    <div class="container page-section legal">
      <div class="legal__main">
        <details class="legal__jump" data-legal-jump>
          <summary>
            <span class="eyebrow">On this page</span>
            <svg class="legal__jump-chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ol class="legal__jump-list">
            {clauses.map((c, i) => (
              <li>
                <a href={`#${c.id}`}>
                  <span class="tnum legal__jump-num">{num(i)}</span>
                  <span>{c.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </details>

        <article class="legal__doc">
          {clauses.map((c, i) => (
            <section class="legal__clause" id={c.id} aria-labelledby={`${c.id}-heading`} data-legal-clause>
              <div class="legal__head">
                <span class="tnum legal__num" aria-hidden="true">{num(i)}</span>
                <h2 id={`${c.id}-heading`} class="heading-small">{c.title}</h2>
                <a class="legal__anchor" href={`#${c.id}`} aria-label={`Link to section: ${c.title}`}>
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6.5 9.5a2.6 2.6 0 003.9.28l1.9-1.9a2.6 2.6 0 00-3.68-3.68l-1.1 1.09M9.5 6.5a2.6 2.6 0 00-3.9-.28l-1.9 1.9a2.6 2.6 0 003.68 3.68l1.09-1.09"
                      stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>

              <div class="legal__blocks">
                {c.blocks.map((b) =>
                  b.kind === 'p' ? (
                    <p class="legal__p" set:html={b.html} />
                  ) : b.kind === 'list' ? (
                    <ul class="legal__list">
                      {b.items.map((item) => <li set:html={item} />)}
                    </ul>
                  ) : (
                    <aside class="legal__note neu-well">
                      <p class="eyebrow">Notice</p>
                      <p class="legal__note-body" set:html={b.html} />
                    </aside>
                  ),
                )}
              </div>
            </section>
          ))}
        </article>

        <a class="legal__top neu-raised" href="#main">
          <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 11.5v-9M3 6.5L7 2.5l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Back to top
        </a>
      </div>

      <aside class="legal__aside">
        <div class="legal__toc">
          <p class="eyebrow">On this page</p>
          <nav aria-label="On this page">
            <ol class="legal__toc-list">
              {clauses.map((c, i) => (
                <li>
                  <a class="legal__toc-link" href={`#${c.id}`} data-toc-link={c.id}>
                    <span class="tnum legal__toc-num">{num(i)}</span>
                    <span>{c.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </aside>
    </div>
  </section>
</Page>

<script>
  // State, not animation: the rail marks whichever clause owns the viewport.
  // Everything that actually moves is CSS.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const clauses = Array.from(document.querySelectorAll<HTMLElement>('[data-legal-clause]'));

  if (links.length && clauses.length) {
    const ratios = new Map<string, number>(clauses.map((c) => [c.id, 0]));

    const mark = (id: string) => {
      for (const link of links) {
        if (link.dataset.tocLink === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          ratios.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
        }
        // Document order wins ties, so the rail settles on the upper clause.
        let best = '';
        let bestRatio = 0;
        for (const [id, ratio] of ratios) {
          if (ratio > bestRatio) {
            best = id;
            bestRatio = ratio;
          }
        }
        if (best) mark(best);
      },
      { rootMargin: '-20% 0px -65% 0px', threshold: [0, 0.25, 0.5, 1] },
    );

    for (const clause of clauses) io.observe(clause);
  }

  // A native <details> stays open after an in-page jump. Close it so the
  // reader lands on the heading rather than under the list they just used.
  const jump = document.querySelector<HTMLDetailsElement>('[data-legal-jump]');
  jump?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) jump.open = false;
  });
</script>

<style>
  /* ── Reading progress. Scroll-driven, no listener, no JS. ─────────────── */
  .legal-progress {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: var(--space-0_5x);
    z-index: calc(var(--z-header) + 1);
    transform-origin: 0 50%;
    scale: 0 1;
    pointer-events: none;
    background-image: linear-gradient(
      90deg,
      var(--solace-80) 0%,
      var(--solace-50) 55%,
      var(--solace-30) 100%
    );
  }
  @supports (animation-timeline: scroll()) {
    .legal-progress {
      animation: legal-progress-grow linear both;
      animation-timeline: scroll(root block);
    }
  }
  @supports not (animation-timeline: scroll()) {
    .legal-progress { display: none; }
  }
  @keyframes legal-progress-grow {
    from { scale: 0 1; }
    to   { scale: 1 1; }
  }

  .legal-stamp {
    margin-block-start: var(--space-2x);
    color: var(--color-text-sub);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── Shell: prose column, plus a rail from 1080.02 up. ────────────────── */
  /* No align-items here on purpose. The rail's sticky child can only travel
     as far as its own grid item is tall, so the aside has to keep the default
     `stretch` and span the full document row. */
  .legal {
    display: grid;
    gap: var(--space-12x);
  }
  @media (min-width: 1080.02px) {
    .legal { grid-template-columns: minmax(0, 1fr) 220px; gap: var(--space-16x); }
  }

  .legal__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-inline-size: 0;
  }

  /* ── Mobile jump list. Native disclosure, so it costs nothing. ────────── */
  .legal__jump {
    inline-size: 100%;
    margin-block-end: var(--space-10x);
    border: 1px solid var(--color-border-sub);
    border-radius: var(--radius-3x);
    overflow: hidden;
  }
  @media (min-width: 1080.02px) { .legal__jump { display: none; } }

  .legal__jump summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3x);
    padding: var(--space-3x) var(--space-4x);
    cursor: pointer;
    list-style: none;
  }
  .legal__jump summary::-webkit-details-marker { display: none; }

  .legal__jump-chevron {
    inline-size: 16px;
    flex: none;
    color: var(--color-icon-soft);
    transition: rotate var(--motion-duration-base) var(--ease-ui);
  }
  .legal__jump[open] .legal__jump-chevron { rotate: 180deg; }

  .legal__jump-list {
    max-block-size: 58vh;
    overflow-y: auto;
    padding-block: var(--space-2x);
    border-block-start: 1px solid var(--color-border-sub);
  }
  .legal__jump-list a {
    display: flex;
    gap: var(--space-2_5x);
    padding-block: var(--space-2x);
    padding-inline: var(--space-4x);
    font-size: var(--font-size-text-small);
    color: var(--color-text-sub);
    transition: color var(--motion-duration-base) var(--ease-ui);
  }
  .legal__jump-list a:hover { color: var(--color-text-base); }
  .legal__jump-num { color: var(--color-faded-base); }

  /* ── The document. 72ch measure, hairline between clauses. ───────────── */
  .legal__doc { inline-size: 100%; max-inline-size: 72ch; }

  .legal__clause {
    padding-block: var(--space-12x);
    border-block-start: 1px solid var(--color-border-sub);
    scroll-margin-block-start: var(--space-6x);
  }
  .legal__clause:first-child { padding-block-start: var(--space-0x); border-block-start: none; }
  .legal__clause:last-child  { padding-block-end: var(--space-0x); }

  .legal__head { display: flex; align-items: baseline; gap: var(--space-4x); }
  .legal__num {
    flex: none;
    color: var(--color-action-primary);
    font-weight: var(--font-weight-medium);
  }
  .legal__head h2 { min-inline-size: 0; }

  /* Icon-only permalink. Quiet until the clause is hovered or it is focused. */
  .legal__anchor {
    flex: none;
    align-self: center;
    display: inline-flex;
    opacity: 0;
    color: var(--color-icon-soft);
    transition: opacity var(--motion-duration-base) var(--ease-ui),
                color   var(--motion-duration-base) var(--ease-ui);
  }
  .legal__anchor svg { inline-size: 16px; block-size: 16px; }
  .legal__head:hover .legal__anchor,
  .legal__anchor:focus-visible { opacity: 1; }
  .legal__anchor:hover { color: var(--color-action-primary); }
  /* Touch never hovers, so the affordance has to stand on its own there. */
  @media (hover: none) { .legal__anchor { opacity: 1; } }

  .legal__blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-5x);
    margin-block-start: var(--space-5x);
  }
  @media (min-width: 640.02px) {
    .legal__blocks { padding-inline-start: var(--space-8x); }
  }

  .legal__p {
    font-size: var(--font-size-text-medium);
    line-height: var(--line-height-open);
    color: var(--color-text-sub);
  }

  /* :global because the emphasis and links live inside set:html strings, which
     never receive the scope attribute. */
  .legal__p :global(strong),
  .legal__list :global(strong),
  .legal__note-body :global(strong) {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-base);
  }
  .legal__p :global(a),
  .legal__note-body :global(a) {
    color: var(--color-action-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--motion-duration-base) var(--ease-ui);
  }
  .legal__p :global(a:hover),
  .legal__note-body :global(a:hover) { color: var(--color-action-primary-hover); }

  .legal__list { display: grid; gap: var(--space-3x); }
  .legal__list li {
    position: relative;
    padding-inline-start: var(--space-7x);
    font-size: var(--font-size-text-medium);
    line-height: var(--line-height-open);
    color: var(--color-text-sub);
  }
  /* Hollow circle, never a filled dot. */
  .legal__list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.55em;
    inline-size: 12px;
    block-size: 12px;
    border: 1.5px solid var(--color-icon-soft);
    border-radius: 50%;
  }

  /* ── Counsel notices. Carved into the page rather than stuck onto it. ─── */
  .legal__note {
    display: flex;
    flex-direction: column;
    gap: var(--space-2x);
    padding: var(--space-5x) var(--space-6x);
  }
  .legal__note-body {
    font-size: var(--font-size-text-small);
    line-height: var(--line-height-open);
    color: var(--color-text-sub);
  }

  .legal__top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2x);
    margin-block-start: var(--space-12x);
    padding: var(--space-2_5x) var(--space-5x);
    border-radius: var(--radius-full);
    font-size: var(--font-size-text-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: normal;
    color: var(--color-text-sub);
    transition: color var(--motion-duration-base) var(--ease-ui);
  }
  .legal__top:hover { color: var(--color-text-base); }
  .legal__top svg {
    inline-size: 14px;
    block-size: 14px;
    transition: translate var(--motion-duration-slow) var(--ease-ui);
  }
  .legal__top:hover svg { translate: 0 -2px; }

  /* ── The rail. ────────────────────────────────────────────────────────── */
  .legal__aside { display: none; }
  @media (min-width: 1080.02px) { .legal__aside { display: block; } }

  .legal__toc {
    position: sticky;
    inset-block-start: calc(var(--page-header-height) + var(--space-8x));
    display: flex;
    flex-direction: column;
    gap: var(--space-4x);
  }

  .legal__toc-list { display: flex; flex-direction: column; }
  .legal__toc-link {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2_5x);
    padding-block: var(--space-1_5x);
    padding-inline-start: var(--space-4x);
    border-inline-start: 2px solid var(--color-border-sub);
    font-size: var(--font-size-text-xsmall);
    line-height: var(--line-height-default);
    color: var(--color-text-sub);
    transition: color        var(--motion-duration-base) var(--ease-ui),
                border-color var(--motion-duration-base) var(--ease-ui);
  }
  .legal__toc-link:hover { color: var(--color-text-base); border-inline-start-color: var(--color-border-base); }
  .legal__toc-link[aria-current='true'] {
    color: var(--color-action-primary);
    border-inline-start-color: var(--color-action-primary);
    font-weight: var(--font-weight-medium);
  }
  .legal__toc-num { flex: none; color: var(--color-faded-base); }
  .legal__toc-link[aria-current='true'] .legal__toc-num { color: var(--color-action-primary); }

  @media (prefers-reduced-motion: reduce) {
    .legal__anchor,
    .legal__jump-chevron,
    .legal__jump-list a,
    .legal__toc-link,
    .legal__top,
    .legal__top svg,
    .legal__p :global(a),
    .legal__note-body :global(a) { transition: none; }
  }
</style>
