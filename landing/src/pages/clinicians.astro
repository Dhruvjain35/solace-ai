---
import Page from '../layouts/Page.astro';
import CtaPrimary from '../components/CtaPrimary.astro';
import GlassPrebrief from '../components/mockups/GlassPrebrief.astro';
import GlassAuthority from '../components/mockups/GlassAuthority.astro';
import GlassShift from '../components/mockups/GlassShift.astro';
import HeroGlass from '../components/mockups/HeroGlass.astro';

/* Rebuilt dark, on glass.

   The page this replaces showed the same wide product panel three times — the
   Atlas snapshot, the letters workspace, the queue — and every one of them was
   a light rectangle full of small type. Three of anything is a pattern, and the
   pattern here was "here is another screenshot", which is the least persuasive
   thing a page can say to a clinician.

   Two decisions fix it.

   FIRST, the material. materials.css is explicit: glass lives on dark over
   something worth refracting, neumorphism lives on light over the warm bed, and
   a surface is never both. /product is the neumorphic page. This is the glass
   one. That is not decoration — it is what structurally stops the two pages
   from reading as one page printed twice, which no amount of different copy
   would have fixed on its own.

   SECOND, the argument. /product answers "what does it do". A clinician is not
   asking that. They are asking three things, in this order, and the page is now
   those three things and nothing else:

     What do I see before I walk in?        -> the pre-brief
     What happens when I disagree with it?  -> the override, and who wins
     What does this actually give me back?  -> the shift, as hours

   Every figure here appears nowhere else on the site, and each one is a 12s
   film on the same five-beat grid the rest of the system uses.

   No JavaScript ships from this page. The clips are driven by the observer in
   Base.astro; the reveals are scroll-driven CSS. Both are inside
   prefers-reduced-motion guards. */

type Act = {
  id: string;
  index: string;
  chapter: string;
  heading: string;
  sub: string;
  mock: 'prebrief' | 'authority' | 'shift';
};

const acts: Act[] = [
  {
    id: 'prebrief',
    index: '01',
    chapter: 'Before the door opens',
    heading: 'You know who is behind the door',
    sub: 'One line of story, the two things that must not be missed, and the next thing worth doing. Short enough to read while you walk.',
    mock: 'prebrief',
  },
  {
    id: 'authority',
    index: '02',
    chapter: 'When you disagree',
    heading: 'You can always overrule it',
    sub: 'Changing the level takes one tap and applies straight away. No dialog asks if you are sure, and the change is saved with your name on it.',
    mock: 'authority',
  },
  {
    id: 'shift',
    index: '03',
    chapter: 'What you get back',
    heading: 'Stop finishing notes at home',
    sub: 'Time with patients goes up a little. What really changes is the typing, the forms, and the hour you currently take home.',
    mock: 'shift',
  },
];

/* What Solace will not do. This section exists because a clinician's first
   question about an AI product is what it will do behind their back, and a page
   that only lists capabilities never answers it. */
const STATEMENT =
  'It suggests, you decide. Everything the AI reads or writes is saved to the record, and a clinician always makes the final call.';
const STATEMENT_WORDS = STATEMENT.split(' ');
---

<Page
  title="For clinicians: meet the story before the patient"
  description="One line of story, the causes that must not be missed and the next action worth taking — ready before you open the door. And when you disagree, you win."
>
  <div class="field">
  <!-- ══ Hero ═════════════════════════════════════════════════════════════ -->
  <section class="hero" data-color-scheme="light" aria-labelledby="hero-heading">
    <div class="container hero__inner">
      <h1 id="hero-heading" class="hero__title">Meet the story before the patient.</h1>
      <p class="hero__lede">
        Solace reads the chart, writes the note and fills the forms. It does not
        decide anything. When you disagree with it, you change it in one tap and
        your answer is the one that counts.
      </p>
      <div class="hero__cta">
        <CtaPrimary href="/demo" label="Book a demo" />
        <a class="arrow" href="/product">
          <span>See the whole product</span>
          <svg viewBox="0 0 20 14.17" fill="none" aria-hidden="true">
            <circle cx="2" cy="7.08" r="1.6" fill="currentColor" />
            <path d="M6.5 7.08h11M13.4 2.2l4.9 4.88-4.9 4.89" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div class="hero__figure">
        <HeroGlass variant="board" />
      </div>
    </div>
  </section>

  <!-- ══ Three acts ═══════════════════════════════════════════════════════ -->
  {acts.map((act, i) => (
    <section
      id={act.id}
      class:list={['act', i % 2 === 1 && 'act--flip']}
      data-color-scheme="light"
      aria-labelledby={`act-${act.index}`}
    >
        <div class="container act__inner">
        <div class="act__copy reveal">
          <h2 id={`act-${act.index}`} class="act__heading">{act.heading}</h2>
          <p class="act__sub">{act.sub}</p>
        </div>

        <figure class="act__stage reveal">
          <span class="act__ghost" aria-hidden="true">{act.index}</span>
          <div class="act__mock">
            {act.mock === 'prebrief' && <GlassPrebrief />}
            {act.mock === 'authority' && <GlassAuthority />}
            {act.mock === 'shift' && <GlassShift />}
          </div>
        </figure>
      </div>
    </section>
  ))}

  <!-- ══ Statement ════════════════════════════════════════════════════════ -->
  <section class="say" data-color-scheme="light" aria-labelledby="say-heading">
    <div class="container page-section">
      <h2 id="say-heading" class="visually-hidden">How Solace treats clinical judgement</h2>
      <p class="say__text">
        <span class="visually-hidden">{STATEMENT}</span>
        <span aria-hidden="true">
          {STATEMENT_WORDS.map((word, i, all) => (
            <>
              <span class="scrub"><span class="scrub__ink">{word}</span></span>
              {i < all.length - 1 ? ' ' : ''}
            </>
          ))}
        </span>
      </p>
    </div>
  </section>

  <!-- ══ Close ════════════════════════════════════════════════════════════ -->
  <section class="close" data-color-scheme="dark" aria-labelledby="close-heading">
    <div class="container page-section close__inner">
      <h2 id="close-heading" class="close__heading reveal">Bring it to your team.</h2>
      <p class="close__sub reveal">
        Thirty minutes, your own department&rsquo;s numbers, and a straight answer
        about what it would and would not change.
      </p>
      <div class="close__cta reveal">
        <CtaPrimary href="/demo" label="Book a demo" />
        <a class="arrow" href="/pricing">
          <span>See pricing</span>
          <svg viewBox="0 0 20 14.17" fill="none" aria-hidden="true">
            <circle cx="2" cy="7.08" r="1.6" fill="currentColor" />
            <path d="M6.5 7.08h11M13.4 2.2l4.9 4.88-4.9 4.89" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>
  </div>
</Page>

<style>
  /* ══ THE FIELD ══════════════════════════════════════════════════════════
     One gradient wash, shared by the whole page. White at the top, a soft lilac
     drifting through the upper left, the brand mint settling toward the bottom.

     This replaces a dark bed with a mesh on it. That version had the material
     backwards: glass over a dark mesh is a lighting effect, and it only looked
     like anything because of what was behind it. Light glass — a tinted panel
     carrying white cards — reads as an interface at any size and does not need
     the page to do it any favours. */
  /* One gradient field, shared by the whole page. White at the top, a soft
     lilac drifting through the upper left, and the brand mint settling toward
     the bottom — the same wash the product screens sit on. It is a single
     stack of radials on white rather than a per-section mesh, so the page
     reads as one surface you scroll down instead of six panels stacked up. */
  /* One element carries the wash for the entire page. The previous version gave
     every section its own copy and offset it, which sounded continuous and was
     not: each section also painted white, so every boundary between them was a
     hard horizontal seam. A single field spanning the document has no seams to
     have, and the sections are simply transparent. */
  .field {
    position: relative;
    background-color: var(--white);
    isolation: isolate;
  }
  .field::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      /* Two very large off-axis lights. Each fades to its OWN hue at zero
         alpha rather than to `transparent` — `transparent` is rgba(0,0,0,0),
         so a fade to it interpolates through black and leaves a grey halo
         around every stop. */
      radial-gradient(128% 46% at 4% 12%, rgb(196 190 240 / 0.42), rgb(196 190 240 / 0) 74%),
      radial-gradient(120% 44% at 98% 66%, rgb(from var(--solace-30) r g b / 0.44), rgb(from var(--solace-30) r g b / 0) 76%),
      /* The through-line. This is the piece that was missing: without a wash
         running the full height there were white gaps between the coloured
         zones, and a white gap between two tints is a band, which is exactly
         what looked like a seam at every section boundary. */
      linear-gradient(180deg,
        rgb(255 255 255) 0%,
        rgb(241 239 251 / 0.58) 16%,
        rgb(236 243 247 / 0.52) 40%,
        rgb(230 244 238 / 0.58) 64%,
        rgb(233 246 240 / 0.52) 86%,
        rgb(255 255 255) 100%);
  }
  .hero, .act, .close, .say {
    position: relative;
    overflow: hidden;
    background-color: transparent;
  }

  .arrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2x);
    color: var(--color-primary-base);
    font-weight: var(--font-weight-medium);
  }
  .arrow span { text-decoration: underline; text-underline-offset: 3px; }
  .arrow svg { inline-size: 16px; transition: translate var(--motion-duration-slow) var(--ease-ui); }
  .arrow:hover svg { translate: 4px; }

  /* ══ HERO ═══════════════════════════════════════════════════════════════ */
  /* Centred, with the composition under it. Left-aligned copy with nothing on
     the right left two thirds of the fold empty, which is what made the hero
     look unfinished rather than spacious. */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5x);
    padding-block: var(--space-20x) var(--space-16x);
    color: var(--color-text-base);
  }
  @media (min-width: 640.02px) {
    .hero__inner { padding-block: var(--space-24x) var(--space-20x); }
  }
  .hero__figure {
    margin-block-start: var(--space-10x);
    inline-size: 100%;
    display: flex;
    justify-content: center;
  }
  .hero__title {
    font-size: var(--font-size-display-medium);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
    max-inline-size: 18ch;
  }
  .hero__lede {
    font-size: var(--font-size-text-large);
    line-height: var(--line-height-open);
    max-inline-size: 56ch;
    color: var(--color-text-sub);
  }
  .hero__cta {
    margin-block-start: var(--space-4x);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-6x);
  }

  /* ══ ACTS ═══════════════════════════════════════════════════════════════ */
  .act__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-10x);
    align-items: center;
    padding-block: var(--space-16x);
    color: var(--color-text-base);
  }
  @media (min-width: 640.02px) { .act__inner { padding-block: var(--space-20x); } }
  @media (min-width: 1080.02px) {
    .act__inner {
      grid-template-columns: minmax(0, 0.86fr) minmax(0, 1fr);
      gap: var(--space-12x);
      padding-block: var(--space-24x);
    }
    /* Sides alternate so the eye crosses the page. DOM order never changes, so
       the reading order stays copy-then-figure throughout. */
    .act--flip .act__copy { order: 2; }
    .act--flip .act__stage { order: 1; }
  }

  .act__copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4x); }
  .act__heading {
    font-size: var(--font-size-heading-large);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    max-inline-size: 15ch;
  }
  .act__sub {
    font-size: var(--font-size-text-large);
    line-height: var(--line-height-open);
    max-inline-size: 40ch;
    color: var(--color-text-sub);
  }

  /* No tinted bed here. On /product the figure needs a stage because it is
     opaque; glass needs the mesh itself to refract, so covering the mesh with a
     card would destroy the material. The stage is only the band that holds the
     act number. */
  .act__stage {
    position: relative;
    margin: 0;
    display: grid;
    place-items: center;
    padding-block-start: var(--space-20x);
  }
  .act__ghost {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    font-size: clamp(56px, 7vw, 104px);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    letter-spacing: var(--letter-spacing-display);
    font-variant-numeric: tabular-nums;
    color: rgb(from var(--neutral-40) r g b / 0.42);
    pointer-events: none;
  }
  /* The graphics measure themselves in cqw, and an element cannot be its own
     query container — so the container has to be this wrapper. */
  .act__mock {
    position: relative;
    container-type: inline-size;
    inline-size: 100%;
    max-inline-size: 640px;
  }

  /* ══ STATEMENT ══════════════════════════════════════════════════════════ */
  .say__text {
    position: relative;
    z-index: 1;
    font-size: var(--font-size-display-small);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
    max-inline-size: 22ch;
  }
  .scrub { display: inline-block; opacity: 1; }
  /* background-clip has to sit on the word, because the opacity that scrubs
     lives on its parent and would not fade a gradient painted by an ancestor.
     Per-word clipping restarts the ramp inside every word, which reads as candy
     stripes; anchoring to the viewport makes all the words sample one ramp. */
  .scrub__ink {
    -webkit-background-clip: text;
    background-clip: text;
    background-attachment: fixed;
    color: transparent;
    background-image: linear-gradient(
      123.97deg,
      var(--solace-60) 10.62%,
      #5e9da8 49.7%,
      var(--slate-60) 89.61%
    );
  }

  /* ══ CLOSE ══════════════════════════════════════════════════════════════ */
  /* The close carries a photograph: still water at dawn, the only landscape on
     the site and the only one it gets.

     Light ink on a dark veil, not the reverse. The first attempt veiled the
     plate with WHITE and put dark ink over it, which could never work — the
     photograph has near-black mountains in it, and any veil strong enough to
     bring #292827 to AA over those pixels erased the photograph. Measured the
     other way round: the brightest pixel through the band is 242, so a 0.62
     black veil puts the worst case at 92 and white text at 6.69:1, past AA
     with the plate still clearly there.

     The page closes dark, which gives it an ending rather than a stop. */
  .close {
    background-image:
      linear-gradient(180deg,
        rgb(from var(--slate-black) r g b / 0.34) 0%,
        rgb(from var(--slate-black) r g b / 0.62) 26%,
        rgb(from var(--slate-black) r g b / 0.62) 74%,
        rgb(from var(--slate-black) r g b / 0.88) 100%),
      url('/assets/photos/dawn.webp');
    background-size: auto, cover;
    background-position: center, center 50%;
    background-repeat: no-repeat, no-repeat;
  }
  @keyframes close-plate {
    from { background-position: center, center 32%; }
    to   { background-position: center, center 68%; }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .close {
        animation: close-plate linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }

  .close__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5x);
    color: var(--color-text-base);
  }
  .close__heading {
    color: var(--white);
    font-size: var(--font-size-display-small);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
    max-inline-size: 16ch;
  }
  .close__sub {
    color: rgb(from var(--white) r g b / 0.88);
    font-size: var(--font-size-text-large);
    line-height: var(--line-height-open);
    max-inline-size: 50ch;
    color: var(--color-text-sub);
  }
  .close__cta {
    margin-block-start: var(--space-4x);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-6x);
  }

  /* ══ SCROLL MOTION ══════════════════════════════════════════════════════
     Scroll-driven CSS, no JavaScript. Everything is behind a reduced-motion
     guard and a support query, so the page is fully legible without either. */
  /* Not a fade. Content is revealed by a wipe — a clip edge travelling up the
     block while it rises the last few pixels into place — so the words are
     opaque the whole way and the motion reads as material moving rather than as
     a page still loading. A scroll-triggered opacity fade is the single most
     over-used effect on the web and it makes everything it touches feel
     identical; this costs the same and does not. */
  @keyframes cl-reveal {
    from { clip-path: inset(18% 0 0 0); translate: 0 var(--space-5x); }
    to   { clip-path: inset(0 0 0 0);   translate: 0 0; }
  }
  @keyframes cl-scrub {
    from { opacity: 0.16; }
    to   { opacity: 1; }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .reveal {
        animation: cl-reveal linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 65%;
      }
      /* Each word owns its own timeline, so the paragraph lights up line by
         line as it rises through the viewport. */
      .scrub {
        animation: cl-scrub linear both;
        animation-timeline: view();
        animation-range: cover 32% cover 58%;
      }
    }
  }
</style>
