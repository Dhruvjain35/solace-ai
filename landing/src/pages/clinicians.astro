  @media (min-width: 1080.02px) { .waiting__lead { font-size: var(--font-size-24); } }
  .waiting__lead strong { font-weight: inherit; color: var(--color-text-base); }

  .waiting__tail { max-inline-size: 36ch; }

  .waiting__shots { display: grid; grid-template-columns: 1fr; gap: var(--space-6x); }
  @media (min-width: 640.02px) {
    .waiting__shots { grid-template-columns: repeat(2, 1fr); align-items: start; }
    /* the second card sits low, the way the drifting pair did */
    .waiting__shots > :last-child { margin-block-start: var(--space-16x); }
  }

  /* Gradient card whose curved edge crops the screenshot, the hims idiom
     rebuilt without the composited hand plate. */
  .phone {
    position: relative;
    margin: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    aspect-ratio: 1728 / 1910;
    padding-inline: var(--space-7x);
    padding-block-start: var(--space-10x);
    border-radius: var(--radius-12x);
    overflow: hidden;
  }
  .phone--pale { background-image: linear-gradient(166deg, var(--solace-10) 0%, var(--solace-20) 100%); }
  .phone--deep { background-image: linear-gradient(166deg, var(--solace-90) 0%, var(--solace-100) 55%, var(--slate-black) 100%); }

  .phone__shot {
    display: block;
    inline-size: min(100%, 74%);
    block-size: 100%;
    overflow: hidden;
    border-start-start-radius: var(--radius-6x);
    border-start-end-radius: var(--radius-6x);
    box-shadow: var(--elevation-large);
  }
  .phone__shot img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .phone .tag {
    position: absolute;
    inset-block-start: var(--space-3x);
    inset-inline-end: var(--space-3x);
  }

  /* ══════════════════════════════════════════════════════════════════════
     SHOWCASE HEADS
     ══════════════════════════════════════════════════════════════════════ */

  .showcase__head {
    display: flex;
