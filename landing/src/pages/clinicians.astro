---
import Page from '../layouts/Page.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaPrimary from '../components/CtaPrimary.astro';

/* /clinicians — ported from legacy/src/pages/Clinicians.tsx (713 lines).
   The legacy page was the forhims category rhythm: white opening statement,
   drifting phone cards, laptop rigs holding live-DOM product screens, a tile
   band, a scrubbed gradient paragraph, a dark queue act, a white close.

   Rebuilt on the Superhuman system. What changed and why:
     - Framer Motion is gone. The reveal idiom is reproduced with CSS
       scroll-driven animations (animation-timeline: view()), which degrade to
       "already visible" where unsupported.
     - QueueScreen / EhrScreen / LettersScreen were React components built from
       lucide icons and Tailwind cqw utilities. They are rebuilt here as plain
       markup with an Atlas palette mapped onto the primitive tokens, so the
       app chrome keeps its own light identity even inside the dark section.
     - Sizes inside the rigs stay in cqw. That is the one unit outside the
       space scale, and it is load-bearing: it is what makes the mockups scale
       vector-crisp with the rig rather than breaking apart at small widths. */

/* Inner SVG markup for the mockup chrome. lucide is not a dependency here, so
   these are hand-drawn on the same 24-unit grid. Injected with set:html; the
   parent <svg> carries stroke/fill, so children inherit. */
const ICON = {
  activity: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  bell: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  shield: '<path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M20.5 20.5 17 17"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  close: '<path d="M18 6 6 18M6 6l12 12"/>',
  users: '<path d="M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 20v-2a4 4 0 0 0-3-3.9"/>',
  mic: '<rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 17v4"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>',
  inbox: '<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.4 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.4-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.8 1.1z"/>',
  workflow: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><path d="M6.5 10v4a3 3 0 0 0 3 3H14"/>',
  slash: '<circle cx="12" cy="12" r="9"/><path d="M6 18 18 6"/>',
  flask: '<path d="M10 3h4M10 3v6l-5.5 9A2 2 0 0 0 6.2 21h11.6a2 2 0 0 0 1.7-3L14 9V3"/>',
  image: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="1.5"/><path d="m21 15-5-5L5 21"/>',
  monitor: '<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>',
  printer: '<path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M6 14h12v7H6z"/>',
  message: '<path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/>',
  messages: '<path d="M14 9a2 2 0 0 1-2 2H7l-3 3V4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2z"/><path d="M18 8h1a2 2 0 0 1 2 2v11l-3-3h-6a2 2 0 0 1-2-2v-1"/>',
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  grip: '<circle cx="9" cy="6" r="1.1"/><circle cx="9" cy="12" r="1.1"/><circle cx="9" cy="18" r="1.1"/><circle cx="15" cy="6" r="1.1"/><circle cx="15" cy="12" r="1.1"/><circle cx="15" cy="18" r="1.1"/>',
};

/* Atlas rail: the admin nav, shared by all three screens. */
const ADMIN = [
  { label: 'Ambient scribe', icon: ICON.mic },
  { label: 'Inbox + admin', icon: ICON.inbox },
  { label: 'Letters & forms', icon: ICON.file },
  { label: 'Workflows', icon: ICON.workflow },
];

/* Deterministic QR-looking module grid, carried over verbatim from the legacy
   AtlasSidebar so the check-in card reads the same. */
const QR_FINDERS = [[0, 0], [8, 0], [0, 8]];
const QR_MODULES = [
  [4, 0], [5, 0], [8, 0], [4, 2], [6, 2], [5, 3], [7, 3], [8, 4], [4, 4],
  [0, 4], [2, 4], [1, 5], [3, 5], [9, 5], [10, 4], [5, 5], [7, 5], [4, 6],
  [6, 6], [8, 6], [10, 6], [0, 8], [2, 8], [4, 8], [7, 8], [9, 8], [5, 9],
  [8, 9], [10, 9], [4, 10], [6, 10], [9, 10],
];

/* ── QueueScreen data ──────────────────────────────────────────────────── */
const STATS = [
  { label: 'Patients waiting', value: '4', icon: ICON.activity, tint: true },
  { label: 'Active pain alarms', value: '1', icon: ICON.bell, tint: false },
  { label: 'Avg wait', value: '41m', icon: ICON.clock, tint: false },
  { label: 'ML-refined', value: '75%', icon: ICON.shield, tint: false },
];

const QUEUE = [
  { name: 'Sriyan', sub: '4m wait · EN', esi: 3, active: true },
  { name: 'Elena', sub: '12m wait · ES', esi: 2, active: false },
  { name: 'Wei', sub: '9m wait · ZH', esi: 4, active: false },
  { name: 'Amira', sub: '16m wait · AR', esi: 3, active: false },
];

/* ── EhrScreen data ────────────────────────────────────────────────────── */
const DDX = [
  { name: 'Spontaneous pneumothorax', mustNotMiss: true, likely: 'MODERATE', icd: 'J93.9' },
  { name: 'ACS / Myocarditis', mustNotMiss: true, likely: 'MODERATE', icd: 'I24.1' },
  { name: 'Chest wall pain (MSK)', mustNotMiss: false, likely: 'MODERATE', icd: 'M94.0' },
  { name: 'Pulmonary embolism', mustNotMiss: true, likely: 'LOW', icd: 'I26.99' },
  { name: 'Aortic dissection', mustNotMiss: true, likely: 'LOW', icd: 'I71.00' },
];

const ORDER_SETS = [
  { icon: ICON.flask, items: ['Troponin (serial)', 'BNP', 'D-dimer', 'CBC', 'BMP'] },
  { icon: ICON.image, items: ['ECG', 'CXR PA/lateral', 'CT chest PE protocol'] },
  { icon: ICON.monitor, items: ['Cardiac monitor', 'SpO₂', 'Vitals q15min'] },
];

/* SHAP attribution rows. Burnt-amber bars push acuity up, green pull down. */
const DRIVERS = [
  { name: 'dyspnea_flag', value: '+1.12', width: '92%', up: true },
  { name: 'pain_score', value: '+0.86', width: '70%', up: true },
  { name: 'age', value: '−0.42', width: '34%', up: false },
  { name: 'news2_score', value: '−0.08', width: '8%', up: false },
  { name: 'temperature_c', value: '−0.02', width: '4%', up: false },
];

/* ── LettersScreen data ────────────────────────────────────────────────── */
const TEMPLATES = [
  { name: 'Work or school note', active: true },
  { name: 'FMLA certification', active: false },
  { name: 'Return to play (concussion)', active: false },
  { name: 'Fitness to travel', active: false },
  { name: 'Medical necessity', active: false },
  { name: 'Jury duty excuse', active: false },
];

/* ── The dark act's snapshot tabs ──────────────────────────────────────── */
const SNAPSHOT_TABS = [
  { label: 'Summary', icon: ICON.file },
  { label: 'Vitals', icon: ICON.activity },
  { label: 'Transcript', icon: ICON.messages },
];

/* The scrubbed gradient paragraph. Each word gets its own reveal band. */
const STATEMENT =
  'It suggests, you decide. Everything the AI reads or writes is saved to the record, and a clinician always makes the final call.';
const STATEMENT_WORDS = STATEMENT.split(' ');
---

<Page
  title="For clinicians: meet the story before the patient"
  description="Meet the story before the patient. A clear summary, the dangerous causes to rule out and the suggested tests, ready while your patient is still in the waiting room."
>
  <PageHeader
    eyebrow="For clinicians"
    title="Meet the story before the patient."
    lede="A clear summary, the dangerous causes to rule out and the suggested tests, ready while your patient is still in the waiting room."
  >
    <div class="header-cta">
      <CtaPrimary href="/demo" label="Book a demo" />
    </div>
  </PageHeader>

  {/* ═══ 1 · Waiting room ═══════════════════════════════════════════════ */}
  <section data-background-color="primary-default" aria-labelledby="waiting-heading">
    <div class="container page-section waiting">
      <div class="waiting__copy reveal">
        <p class="eyebrow">Before you walk in</p>
        <div class="dashed" aria-hidden="true"></div>
        <h2 id="waiting-heading" class="heading-large">It starts in the waiting room.</h2>
        <p class="waiting__lead">
          <strong>Your patient tells their story once,</strong> on their own phone, in their own
          language. Medications, allergies and history land as a clean record, not a wall of loose
          notes.
        </p>
        <p class="text-medium text-sub waiting__tail">
          By the time you open the chart, it reads like a colleague already took the history for
          you.
        </p>
      </div>

      <div class="waiting__shots">
        <figure class="phone phone--pale reveal">
          <span class="phone__shot">
            <img
              src="/assets/screens/meds.webp"
              alt="Solace intake confirming the medications a patient takes"
              width="1179"
              height="2556"
              loading="lazy"
              decoding="async"
            />
          </span>
</figure>

        <figure class="phone phone--deep reveal">
          <span class="phone__shot">
            <img
              src="/assets/screens/medical.webp"
              alt="Solace intake asking a patient about past medical history"
              width="1179"
              height="2556"
              loading="lazy"
              decoding="async"
            />
          </span>
</figure>
      </div>
    </div>
  </section>

  {/* ═══ 2 · Atlas showcase — the EHR patient snapshot ══════════════════ */}
  <section id="atlas" data-background-color="secondary-default" aria-labelledby="atlas-heading">
    <div class="container page-section">
      <div class="showcase__head reveal">
        <p class="eyebrow">Solace Atlas</p>
        <div class="dashed" aria-hidden="true"></div>
        <h2 id="atlas-heading" class="heading-medium">
          Open the chart and the work is already started.
        </h2>
        <p class="text-medium text-sub showcase__sub">
          The summary on top, the causes to rule out under it, the tests ready to order. Review it,
          change it, make it yours.
        </p>
      </div>

      <figure class="rig reveal">
        <div class="rig__shell" aria-hidden="true">
          <div class="rig__screen">
            <div class="atlas">
              {/* ── rail ── */}
              <div class="atlas__rail">
                <div class="atlas__brand">
                  <span class="atlas__mark">S</span>
                  <span class="atlas__word">solace</span>
                </div>
                <p class="atlas__railkicker">Atlas</p>

                <div class="atlas__user">
                  <span class="atlas__avatar">C</span>
                  <span class="atlas__userbody">
                    <span class="atlas__username">Dr. Chen</span>
                    <span class="atlas__userrole">Chief</span>
                  </span>
                  <span class="atlas__signout">Sign out</span>
                </div>

                <p class="atlas__navlabel">Queue</p>
                <div class="atlas__navrow atlas__navrow--on">Waiting <span>4</span></div>
                <div class="atlas__navrow">All <span>6</span></div>

                <p class="atlas__navlabel">Admin</p>
                <div class="atlas__admin">
                  {ADMIN.map((item) => (
                    <div class="atlas__adminrow">
                      <svg aria-hidden="true" class="atlas__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                      {item.label}
                    </div>
                  ))}
                </div>

                <div class="atlas__qr">
                  <svg aria-hidden="true" class="atlas__qrglyph" viewBox="0 0 11 11">
                    {QR_FINDERS.map(([x, y]) => (
                      <>
                        <rect x={x} y={y} width="3" height="3" />
                        <rect x={x + 1} y={y + 1} width="1" height="1" class="atlas__qrhole" />
                      </>
                    ))}
                    {QR_MODULES.map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}
                  </svg>
                  <p class="atlas__qrnote">Patients scan to check in</p>
                </div>
              </div>

              {/* ── main ── */}
              <div class="atlas__main">
                <div class="atlas__card atlas__card--full">
                  <div class="atlas__cardhead">
                    <svg aria-hidden="true" class="atlas__i atlas__i--soft" viewBox="0 0 24 24" fill="currentColor" stroke="none" set:html={ICON.grip} />
                    <svg aria-hidden="true" class="atlas__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.activity} />
                    <span class="atlas__cardtitle">Patient snapshot</span>
                    <span class="atlas__cardmeta">Sriyan · 4m wait · EN</span>
                    <svg aria-hidden="true" class="atlas__i atlas__i--end" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.close} />
                  </div>

                  <div class="atlas__split">
                    {/* left: acuity, pre-brief, workup, dispo */}
                    <div class="atlas__pane">
                      <div class="atlas__acuity">
                        <p class="atlas__label">Triage acuity</p>
                        <div class="atlas__acuityrow">
                          <span>
                            <span class="atlas__acuitymini">Provisional · on intake</span>
                            <span class="atlas__acuitybig">ESI 3 <span class="atlas__acuitypct">98%</span></span>
                          </span>
                          <span class="atlas__acuityarrow">→</span>
                          <span>
                            <span class="atlas__acuitymini">Refined · vitals pending</span>
                            <span class="atlas__acuitynote">take vitals to refine</span>
                          </span>
                        </div>
                      </div>

                      <div>
                        <p class="atlas__label">Pre-brief</p>
                        <p class="atlas__prebrief">
                          19yo M c/o acute-onset chest tightness and sharp back pain following
                          basketball practice 1 hour ago, now worsening, with associated dyspnea;
                          denies trauma; reports pain 7–10/10. Hx asthma on steroids; allergies:
                          peanuts (moderate), sulfa (anaphylaxis).
                        </p>
                      </div>

                      <div>
                        <div class="atlas__labelrow">
                          <p class="atlas__label">Workup order set (AI draft)</p>
                          <span class="atlas__accept">Accept all (11)</span>
                        </div>
                        <div class="atlas__orders">
                          {ORDER_SETS.map((set) => (
                            <div class="atlas__orderrow">
                              <svg aria-hidden="true" class="atlas__i atlas__i--muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={set.icon} />
                              <div class="atlas__chips">
                                {set.items.map((item) => <span class="atlas__chip">{item}</span>)}
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>

                      <div class="atlas__dispo">
                        <span class="atlas__dispotag">◉ OBSERVE</span>
                        <span class="atlas__dispometa">· obs unit · ~6h LOS</span>
                      </div>

                      <div>
                        <p class="atlas__label">Patient&rsquo;s words</p>
                        <p class="atlas__quote">
                          &ldquo;I have a tight feeling in my chest and sharp back pain. It started
                          after basketball practice an hour ago and is getting worse.&rdquo;
                        </p>
                      </div>

                      <div>
                        <p class="atlas__label">Risk scores</p>
                        <p class="atlas__risk">
                          Awaiting bedside vitals. Enter HR, BP, RR and SpO₂ and the system refines
                          the triage score automatically.
                        </p>
                      </div>
                    </div>

                    {/* right: differential, attribution, actions */}
                    <div class="atlas__pane atlas__pane--split">
                      <div>
                        <div class="atlas__labelrow">
                          <p class="atlas__label">Differential diagnosis (AI draft)</p>
                          <span class="atlas__count">9 entries</span>
                        </div>
                        <div class="atlas__ddx">
                          {DDX.map((d) => (
                            <div class="atlas__ddxrow">
                              <span class="atlas__ddxname">{d.name}</span>
                              {d.mustNotMiss && (
                                <span class="atlas__mnm">
                                  <svg aria-hidden="true" class="atlas__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" set:html={ICON.slash} />
                                  Must not miss
                                </span>
                              )}
                              <span class:list={['atlas__likely', d.likely === 'MODERATE' && 'atlas__likely--mod']}>
                                {d.likely}
                              </span>
                              <span class="atlas__icd">{d.icd}</span>
                            </div>
                          ))}
                        </div>
                      </div>

                      <div>
                        <p class="atlas__label">What drove this ESI</p>
                        <div class="atlas__drivers">
                          {DRIVERS.map((f) => (
                            <div class="atlas__driver">
                              <span class="atlas__drivername">{f.name}</span>
                              <span class="atlas__track">
                                <span class:list={['atlas__bar', f.up ? 'atlas__bar--up' : 'atlas__bar--down']} style={`width:${f.width}`}></span>
                              </span>
                              <span class="atlas__drivervalue">{f.value}</span>
                            </div>
                          ))}
                        </div>
                      </div>

                      <div class="atlas__actions">
                        <span class="atlas__btn">
                          <svg aria-hidden="true" class="atlas__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.printer} />
                          Print notes
                        </span>
                        <span class="atlas__btn">
                          <svg aria-hidden="true" class="atlas__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.message} />
                          Text discharge
                        </span>
                        <span class="atlas__btn atlas__btn--primary">Mark seen</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="rig__deck" aria-hidden="true"></div>
        <figcaption class="rig__cap">
<span class="visually-hidden">
            Solace Atlas patient snapshot: a clear summary, the dangerous causes to rule out and the
            suggested tests.
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* ═══ 3 · Feature tiles ══════════════════════════════════════════════ */}
  <section data-background-color="primary-default" aria-labelledby="tiles-heading">
    <div class="container page-section">
      <h2 id="tiles-heading" class="visually-hidden">What Solace Atlas does for clinicians</h2>

      <div class="tiles">
        <article class="tile tile--ink reveal" data-color-scheme="dark">
          <div class="tile__top">
            <p class="tile__kicker">The snapshot</p>
            <div class="tile__bars" aria-hidden="true">
              <span style="width:92%"></span>
              <span style="width:72%"></span>
              <span style="width:48%"></span>
            </div>
          </div>
          <div class="tile__foot">
            <h3 class="tile__title">The whole story, one glance.</h3>
            <p class="tile__sub">what your patient said, summed up before you walk in.</p>
          </div>
        </article>

        <article class="tile tile--green reveal" data-color-scheme="dark">
          <div class="tile__top">
            <p class="tile__kicker">The watch-list</p>
            <ul class="tile__watch">
              <li><span class="tile__watchname">Collapsed lung</span><span class="tile__flag">must not miss</span></li>
              <li><span class="tile__watchname">Blood clot</span><span class="tile__flag">must not miss</span></li>
            </ul>
          </div>
          <div class="tile__foot">
            <h3 class="tile__title">Dangerous causes, never buried.</h3>
            <p class="tile__sub">the ones to rule out, flagged on every patient.</p>
          </div>
        </article>

        <article class="tile tile--paper reveal">
          <div class="tile__top">
            <p class="tile__kicker">Ready to order</p>
            <div class="tile__tests">
              <span class="tile__test">ECG</span>
              <span class="tile__test">Chest X-ray</span>
              <span class="tile__test">Blood tests</span>
              <span class="tile__test">Heart monitor</span>
              <span class="tile__more">+ 7 more</span>
            </div>
          </div>
          <div class="tile__foot">
            <h3 class="tile__title">Tests, suggested.</h3>
            <p class="tile__sub">accept the ones you agree with, skip the rest.</p>
          </div>
        </article>

        <article class="tile tile--mint reveal">
          <div class="tile__top">
            <p class="tile__kicker">After the visit</p>
            <div class="tile__letter" aria-hidden="true">
              <span class="tile__line" style="width:66%"></span>
              <span class="tile__line" style="width:50%"></span>
              <span class="tile__line" style="width:60%"></span>
              <span class="tile__send">Sign and send</span>
            </div>
          </div>
          <div class="tile__foot">
            <h3 class="tile__title">Letters and replies, drafted.</h3>
            <p class="tile__sub">you read, you sign, you send.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* ═══ 4 · Letters and forms ══════════════════════════════════════════ */}
  <section data-background-color="secondary-default" aria-labelledby="letters-heading">
    <div class="container page-section">
      <div class="showcase__head reveal">
        <p class="eyebrow">Letters and forms</p>
        <div class="dashed" aria-hidden="true"></div>
        <h2 id="letters-heading" class="heading-medium">
          Twenty-four letters and forms, filled from the chart.
        </h2>
        <p class="text-medium text-sub showcase__sub">You read, you sign, you send.</p>
      </div>

      <figure class="rig rig--short reveal">
        <div class="rig__shell" aria-hidden="true">
          <div class="rig__screen">
            <div class="atlas atlas--letters">
              <div class="atlas__rail">
                <div class="atlas__brand">
                  <span class="atlas__mark">S</span>
                  <span class="atlas__word">solace</span>
                </div>
                <p class="atlas__railkicker">Atlas</p>

                <div class="atlas__user">
                  <span class="atlas__avatar">C</span>
                  <span class="atlas__userbody">
                    <span class="atlas__username">Dr. Chen</span>
                    <span class="atlas__userrole">Chief</span>
                  </span>
                  <span class="atlas__signout">Sign out</span>
                </div>

                <p class="atlas__navlabel">Queue</p>
                <div class="atlas__navrow atlas__navrow--on">Waiting <span>4</span></div>
                <div class="atlas__navrow">All <span>6</span></div>

