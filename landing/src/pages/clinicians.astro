  }

  .waiting__copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4x); }

  .waiting__lead {
    margin-block-start: var(--space-2x);
    max-inline-size: 34ch;
    font-size: var(--font-size-text-large);
