    inline-size: 100%;
    padding: var(--space-2_5x);
    border-radius: var(--radius-3_5x);
    background: linear-gradient(180deg, var(--neutral-95) 0%, var(--neutral-100) 100%);
    box-shadow:
      inset 0 0 0 1px rgb(from var(--white) r g b / 0.10),
      var(--elevation-large);
  }

  .rig__screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-2x);
    background-color: var(--neutral-5);
    container-type: inline-size;
  }
  .rig--short .rig__screen { aspect-ratio: 16 / 9; }
  /* Panel glow off the top edge of the display. */
  .rig__screen::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(180deg, rgb(from var(--white) r g b / 0.05) 0, transparent 45%);
  }

  /* The deck overhangs the lid, which is what makes the rig read as a machine
     rather than a floating rectangle. The overhang is expressed as an absolute
     amount, NOT a percentage: a percentage of a 1040px rig is wider than the
     page gutter and pushes the whole document sideways. */
  .rig__deck {
    inline-size: calc(100% + var(--space-6x));
    block-size: 14px;
    border-start-start-radius: var(--radius-0_5x);
    border-start-end-radius: var(--radius-0_5x);
    border-end-start-radius: var(--radius-4x);
    border-end-end-radius: var(--radius-4x);
    background: linear-gradient(180deg, var(--neutral-80) 0%, var(--neutral-95) 55%, var(--neutral-100) 100%);
    box-shadow: inset 0 1px 0 0 rgb(from var(--white) r g b / 0.15);
  }
  @media (min-width: 640.02px) { .rig__deck { inline-size: calc(100% + var(--space-10x)); } }

  .rig__cap {
    position: absolute;
    inset-block-start: var(--space-5x);
    inset-inline-end: var(--space-5x);
  }

  /* ══════════════════════════════════════════════════════════════════════
     ATLAS — the clinician terminal, rebuilt as markup.

     Every colour is a local alias over a PRIMITIVE token, never a semantic
     one. That is deliberate: primitives do not flip with the colour scheme,
     so the app chrome keeps its light identity inside the dark section.

     Sizes are cqw against .rig__screen so the whole terminal scales as one
     piece. This is the only place on the page that leaves the space scale.
     ══════════════════════════════════════════════════════════════════════ */

  .atlas {
    --atlas-page: var(--neutral-5);
    --atlas-rail: var(--neutral-10);
    --atlas-surface: var(--white);
    --atlas-ink: var(--neutral-100);
    --atlas-muted: var(--neutral-60);
    --atlas-primary: var(--slate-80);
    --atlas-active: var(--solace-20);
    --atlas-line: rgb(from var(--neutral-60) r g b / 0.24);
    --atlas-chip: var(--neutral-10);
    --atlas-alert: var(--red-80);
    --atlas-up: var(--orange-80);
    --atlas-down: var(--solace-80);
    --atlas-mid: var(--yellow-80);

    display: flex;
    inline-size: 100%;
    block-size: 100%;
    background-color: var(--atlas-page);
    color: var(--atlas-ink);
    font-family: var(--font-family-sans);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-default);
    letter-spacing: var(--letter-spacing-base);
    text-align: start;
  }

  .atlas p { margin: 0; }
  .atlas__i { inline-size: 1em; block-size: 1em; flex: none; }
  .atlas__i--soft { color: var(--atlas-muted); opacity: 0.6; }
  .atlas__i--muted { color: var(--atlas-muted); }
  .atlas__i--end { margin-inline-start: auto; color: var(--atlas-muted); }

  /* ── rail ─────────────────────────────────────────────────────────── */
  .atlas__rail {
    display: flex;
    flex-direction: column;
    inline-size: 19%;
    flex: none;
    padding: 1.2cqw;
    background-color: var(--atlas-rail);
    border-inline-end: 1px solid var(--atlas-line);
  }

  .atlas__brand { display: flex; align-items: center; gap: 0.6cqw; }
  .atlas__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.2cqw;
    block-size: 2.2cqw;
    border: 0.16cqw solid var(--atlas-primary);
    border-radius: 0.55cqw;
    color: var(--atlas-primary);
    font-size: 1.3cqw;
    font-weight: var(--font-weight-bold);
  }
  .atlas__word {
    color: var(--atlas-primary);
    font-size: 1.7cqw;
    font-weight: var(--font-weight-semibold);
  }
  .atlas__railkicker {
    margin-block-start: 0.3cqw;
    color: var(--atlas-muted);
    font-size: 0.62cqw;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .atlas__user {
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    margin-block-start: 1cqw;
    padding: 0.7cqw;
    border-radius: 0.85cqw;
    background-color: var(--atlas-surface);
  }
  .atlas__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    inline-size: 2.4cqw;
    block-size: 2.4cqw;
    border-radius: 50%;
    background-color: var(--atlas-primary);
    color: var(--white);
    font-size: 1cqw;
    font-weight: var(--font-weight-semibold);
  }
  .atlas__userbody { display: flex; flex-direction: column; min-inline-size: 0; flex: 1 1 auto; }
  .atlas__username { font-size: 1cqw; font-weight: var(--font-weight-semibold); }
  .atlas__userrole {
    color: var(--atlas-muted);
    font-size: 0.6cqw;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .atlas__signout {
    flex: none;
    color: var(--atlas-muted);
    font-size: 0.55cqw;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .atlas__navlabel {
    margin-block-start: 1.2cqw;
    color: var(--atlas-muted);
    font-size: 0.62cqw;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .atlas__navrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65cqw 0.9cqw;
    color: var(--atlas-muted);
    font-size: 0.95cqw;
    font-weight: var(--font-weight-medium);
  }
  .atlas__navrow--on {
    margin-block-start: 0.5cqw;
    border-radius: 0.85cqw;
    background-color: var(--atlas-active);
    color: var(--atlas-primary);
  }
  .atlas__navrow span { opacity: 0.7; }

  .atlas__admin { display: flex; flex-direction: column; gap: 0.15cqw; margin-block-start: 0.4cqw; }
  .atlas__adminrow {
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    padding: 0.55cqw 0.9cqw;
    border-radius: 0.6cqw;
    color: var(--atlas-muted);
    font-size: 0.92cqw;
    font-weight: var(--font-weight-medium);
  }
  .atlas__adminrow--on { background-color: var(--atlas-surface); color: var(--atlas-ink); }

  .atlas__qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-block-start: auto;
    padding: 1cqw;
    border-radius: 0.85cqw;
    background-color: var(--atlas-surface);
  }
  .atlas__qrglyph { inline-size: 55%; block-size: auto; fill: var(--atlas-ink); }
  .atlas__qrhole { fill: var(--atlas-surface); }
  .atlas__qrnote { margin-block-start: 0.7cqw; color: var(--atlas-muted); font-size: 0.72cqw; text-align: center; }

  /* ── main column ──────────────────────────────────────────────────── */
  .atlas__main { display: flex; flex-direction: column; flex: 1 1 auto; min-inline-size: 0; overflow: hidden; padding: 1.3cqw; }
  .atlas__main--queue { gap: 1cqw; }

  .atlas__label {
    color: var(--atlas-muted);
    font-size: 0.6cqw;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .atlas__labelrow { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6cqw; }
  .atlas__accept { color: var(--atlas-primary); font-size: 0.78cqw; font-weight: var(--font-weight-semibold); }
  .atlas__count { color: var(--atlas-muted); font-size: 0.75cqw; }
  .atlas__hint { color: var(--atlas-muted); font-size: 0.75cqw; font-style: italic; }

  /* Cards */
  .atlas__card {
    display: flex;
    flex-direction: column;
    min-block-size: 0;
    overflow: hidden;
    border: 1px solid var(--atlas-line);
    border-radius: 1.1cqw;
    background-color: var(--atlas-surface);
  }
  .atlas__card--full { flex: 1 1 auto; }
  .atlas__card--grow { flex: 1 1 auto; }

  .atlas__cardhead {
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    padding: 0.7cqw 1cqw;
    border-block-end: 1px solid var(--atlas-line);
    background-color: rgb(from var(--atlas-chip) r g b / 0.5);
    font-size: 0.95cqw;
  }
  .atlas__cardtitle { font-weight: var(--font-weight-semibold); }
  .atlas__cardmeta { color: var(--atlas-muted); font-size: 0.8cqw; }

  .atlas__split { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1cqw; flex: 1 1 auto; min-block-size: 0; overflow: hidden; padding: 1.1cqw; }
  .atlas__split--letters { grid-template-columns: 36% 1fr; }

  .atlas__pane { display: flex; flex-direction: column; gap: 0.9cqw; min-block-size: 0; overflow: hidden; }
  .atlas__pane--split { justify-content: space-between; }
  .atlas__pane--pad { padding: 1cqw; gap: 0.8cqw; }

  /* Acuity */
  .atlas__acuity { padding: 0.9cqw; border: 1px solid var(--atlas-line); border-radius: 1.3cqw; }
  .atlas__acuityrow { display: flex; align-items: center; gap: 1cqw; margin-block-start: 0.5cqw; }
  .atlas__acuityrow > span { display: flex; flex-direction: column; }
  .atlas__acuitymini {
    color: var(--atlas-muted);
    font-size: 0.55cqw;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .atlas__acuitybig { font-size: 1.7cqw; font-weight: var(--font-weight-bold); line-height: var(--line-height-tight); }
  .atlas__acuitypct { color: var(--atlas-muted); font-size: 0.8cqw; font-weight: var(--font-weight-regular); }
  .atlas__acuityarrow { color: var(--atlas-muted); font-size: 1cqw; }
  .atlas__acuitynote { color: var(--atlas-muted); font-size: 0.9cqw; font-style: italic; }

  .atlas__prebrief {
    margin-block-start: 0.4cqw;
    padding: 0.9cqw;
    border-radius: 0.85cqw;
    background-color: rgb(from var(--atlas-active) r g b / 0.45);
    font-size: 0.88cqw;
    line-height: var(--line-height-open);
  }

  /* Order set */
  .atlas__orders {
    display: flex;
    flex-direction: column;
    gap: 0.6cqw;
    margin-block-start: 0.5cqw;
    padding: 0.9cqw;
    border: 1px solid var(--atlas-line);
    border-radius: 0.85cqw;
  }
  .atlas__orderrow { display: flex; align-items: center; gap: 0.6cqw; font-size: 0.95cqw; }
  .atlas__chips { display: flex; flex-wrap: wrap; gap: 0.4cqw; }
  .atlas__chip {
    padding: 0.35cqw 0.7cqw;
    border-radius: 0.45cqw;
    background-color: var(--atlas-chip);
    font-size: 0.78cqw;
    font-weight: var(--font-weight-medium);
  }

  .atlas__dispo { display: flex; align-items: center; gap: 0.7cqw; }
  .atlas__dispotag {
    padding: 0.4cqw 0.8cqw;
    border-radius: 0.45cqw;
    background-color: rgb(from var(--atlas-up) r g b / 0.15);
    color: var(--atlas-up);
    font-size: 0.85cqw;
    font-weight: var(--font-weight-bold);
  }
  .atlas__dispometa { color: var(--atlas-muted); font-size: 0.85cqw; }

  .atlas__quote {
    margin-block-start: 0.4cqw;
    color: var(--atlas-muted);
    font-size: 0.88cqw;
    font-style: italic;
    line-height: var(--line-height-open);
  }
  .atlas__risk {
    margin-block-start: 0.4cqw;
    padding: 0.9cqw;
    border: 1px solid var(--atlas-line);
    border-radius: 0.85cqw;
    color: var(--atlas-muted);
    font-size: 0.85cqw;
    font-style: italic;
    line-height: var(--line-height-open);
  }

  /* Differential */
  .atlas__ddx { display: flex; flex-direction: column; gap: 0.45cqw; margin-block-start: 0.5cqw; }
  .atlas__ddxrow {
    display: flex;
    align-items: center;
    gap: 0.6cqw;
    padding: 0.55cqw 0.8cqw;
    border: 1px solid var(--atlas-line);
    border-radius: 0.85cqw;
  }
  .atlas__ddxname {
    flex: 1 1 auto;
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.88cqw;
    font-weight: var(--font-weight-semibold);
  }
  .atlas__mnm {
    display: flex;
    align-items: center;
    gap: 0.3cqw;
    flex: none;
    padding: 0.25cqw 0.5cqw;
    border-radius: 0.3cqw;
    background-color: var(--atlas-alert);
    color: var(--white);
    font-size: 0.58cqw;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
  }
  .atlas__likely {
    flex: none;
    padding: 0.25cqw 0.6cqw;
    border-radius: var(--radius-full);
    background-color: var(--atlas-chip);
    color: var(--atlas-muted);
    font-size: 0.58cqw;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
  }
  .atlas__likely--mod { background-color: rgb(from var(--atlas-up) r g b / 0.15); color: var(--atlas-up); }
  .atlas__icd { flex: none; color: var(--atlas-muted); font-family: var(--font-family-mono); font-size: 0.72cqw; letter-spacing: normal; }

  /* SHAP attribution */
  .atlas__drivers { display: flex; flex-direction: column; gap: 0.45cqw; margin-block-start: 0.5cqw; }
  .atlas__driver { display: flex; align-items: center; gap: 0.7cqw; font-family: var(--font-family-mono); letter-spacing: normal; }
  .atlas__drivername { inline-size: 32%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.75cqw; }
  .atlas__track { flex: 1 1 auto; block-size: 0.9cqw; overflow: hidden; border-radius: 0.25cqw; background-color: var(--atlas-chip); }
  .atlas__bar { display: block; block-size: 100%; border-radius: 0.25cqw; }
  .atlas__bar--up { background-color: var(--atlas-up); }
  .atlas__bar--down { background-color: var(--atlas-down); }
  .atlas__drivervalue { inline-size: 3.4cqw; text-align: end; font-size: 0.75cqw; }

  /* Actions */
  .atlas__actions { display: flex; align-items: center; gap: 0.6cqw; margin-block-start: auto; }
  .atlas__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45cqw;
    padding: 0.55cqw 0.9cqw;
    border: 1px solid var(--atlas-line);
    border-radius: 0.45cqw;
    background-color: var(--atlas-chip);
    font-size: 0.85cqw;
    font-weight: var(--font-weight-semibold);
  }
  .atlas__btn--primary {
    flex: 1 1 auto;
    border-color: transparent;
    background-color: var(--atlas-primary);
    color: var(--white);
    font-size: 0.95cqw;
    font-weight: var(--font-weight-medium);
  }
  .atlas__btn--auto { flex: none; }

  /* ── QueueScreen-only pieces ──────────────────────────────────────── */
  .atlas__stats { display: flex; gap: 0.9cqw; }
  .atlas__stat {
    display: flex;
    align-items: center;
    gap: 0.8cqw;
    flex: 1 1 0;
    padding: 0.8cqw 1cqw;
    border: 1px solid var(--atlas-line);
    border-radius: 1.3cqw;
    background-color: var(--atlas-surface);
  }
  .atlas__stat > span:last-child { display: flex; flex-direction: column; }
  .atlas__staticon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    inline-size: 2.5cqw;
    block-size: 2.5cqw;
    border-radius: 50%;
    background-color: var(--atlas-chip);
    color: var(--atlas-primary);
    font-size: 1.1cqw;
  }
  .atlas__staticon--on { background-color: var(--atlas-active); }
  .atlas__statvalue { font-size: 1.5cqw; font-weight: var(--font-weight-bold); line-height: var(--line-height-tight); }

  .atlas__search { padding: 0.7cqw; border: 1px solid var(--atlas-line); border-radius: 1.1cqw; background-color: var(--atlas-surface); }
  .atlas__searchbar {
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    block-size: 2.6cqw;
    padding-inline: 1cqw;
    border-radius: var(--radius-full);
    background-color: var(--atlas-chip);
    color: var(--atlas-muted);
    font-size: 0.95cqw;
  }
  .atlas__tagchip {
    display: inline-flex;
    align-items: center;
    gap: 0.5cqw;
    margin-block-start: 0.6cqw;
    padding: 0.35cqw 0.9cqw;
    border-radius: var(--radius-full);
    background-color: var(--atlas-primary);
    color: var(--white);
    font-size: 0.8cqw;
    font-weight: var(--font-weight-semibold);
  }

  .atlas__wshead { display: flex; align-items: flex-end; justify-content: space-between; gap: 1cqw; }
  .atlas__wshead > span:first-child { display: flex; flex-direction: column; }
  .atlas__wstitle { font-size: 1.25cqw; font-weight: var(--font-weight-semibold); }
  .atlas__wssub { color: var(--atlas-muted); font-size: 0.9cqw; }
  .atlas__add {
    display: flex;
    align-items: center;
    gap: 0.45cqw;
    padding: 0.6cqw 1.1cqw;
    border-radius: var(--radius-full);
    background-color: var(--atlas-primary);
    color: var(--white);
    font-size: 0.9cqw;
    font-weight: var(--font-weight-semibold);
  }

  .atlas__wsgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1cqw; flex: 1 1 auto; min-block-size: 0; }
  .atlas__wscol { display: flex; flex-direction: column; gap: 1cqw; min-block-size: 0; }

  .atlas__queue { display: flex; flex-direction: column; gap: 0.45cqw; padding: 0.7cqw; }
  .atlas__qrow { display: flex; align-items: center; gap: 0.8cqw; padding: 0.55cqw 0.8cqw; border-radius: 1.3cqw; }
  .atlas__qrow--on {
    background-color: rgb(from var(--atlas-active) r g b / 0.55);
    box-shadow: inset 0 0 0 1px rgb(from var(--atlas-primary) r g b / 0.4);
  }
  .atlas__qrow > span:last-child { display: flex; flex-direction: column; }
  .atlas__esi {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    inline-size: 2.4cqw;
    block-size: 2.4cqw;
    border-radius: 50%;
    color: var(--white);
    font-size: 1.05cqw;
    font-weight: var(--font-weight-bold);
  }
  .atlas__esi--2 { background-color: var(--atlas-up); }
  .atlas__esi--3 { background-color: var(--atlas-mid); }
  .atlas__esi--4 { background-color: var(--atlas-muted); }
  .atlas__qname { font-size: 1cqw; font-weight: var(--font-weight-semibold); }
  .atlas__qsub { color: var(--atlas-muted); font-size: 0.78cqw; }

  .atlas__scribe { display: flex; flex-direction: column; align-items: flex-start; flex: 1 1 auto; min-block-size: 0; padding: 1cqw; }
  .atlas__scribetitle { font-size: 1.05cqw; font-weight: var(--font-weight-semibold); }
  .atlas__scribesub { margin-block-start: 0.3cqw; color: var(--atlas-muted); font-size: 0.82cqw; }
  .atlas__scriberow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    inline-size: 100%;
    margin-block-start: 0.9cqw;
    padding-block-start: 0.8cqw;
    border-block-start: 1px solid var(--atlas-line);
  }
  .atlas__chunks { display: flex; align-items: center; gap: 0.5cqw; color: var(--atlas-muted); font-size: 0.8cqw; }
  .atlas__count-pill {
    padding: 0.2cqw 0.6cqw;
    border-radius: 0.4cqw;
    background-color: var(--atlas-chip);
    color: var(--atlas-ink);
    font-family: var(--font-family-mono);
    font-size: 0.85cqw;
    font-weight: var(--font-weight-semibold);
    letter-spacing: normal;
  }
  .atlas__record {
    display: inline-flex;
    align-items: center;
    gap: 0.5cqw;
    margin-block-start: 0.7cqw;
    padding: 0.55cqw 1cqw;
    border-radius: 0.45cqw;
    background-color: var(--atlas-alert);
    color: var(--white);
    font-size: 0.9cqw;
    font-weight: var(--font-weight-medium);
  }
