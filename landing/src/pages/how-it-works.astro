---
import Page from '../layouts/Page.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaPrimary from '../components/CtaPrimary.astro';

/* Ported from legacy/src/pages/HowItWorks.tsx.

   The legacy page was built on the forhims clone: framer-motion reveals, a
   photographic hand+phone rig corner-pinned with a runtime homography, and two
   React-rendered laptop screens. None of that survives the port. What survives
   is the structure, which is the actual idea: numbered editorial rows carrying
   the journey, interleaved with the app moment that matches the step, then the
   same journey retold from the clinician's chair on a dark stage.

   Every reveal here is a CSS view() timeline, the same mechanism the header
   already uses. No JS ships with this page. */

type Step = { num: string; title: string; sub: string };

const patientSteps: Step[] = [
  {
    num: '01',
    title: 'Scan the code.',
    sub: 'a QR code in the waiting room opens Solace on their own phone. nothing to install.',
  },
  {
    num: '02',
    title: 'Pick a language.',
    sub: 'twenty languages, spoken and written. the whole visit happens in theirs.',
  },
  {
    num: '03',
    title: 'Tell your story.',
    sub: 'talk naturally or type. the AI asks two or three follow-up questions that fit, and every answer is saved for the care team.',
  },
  {
    num: '04',
    title: 'Snap the insurance card.',
    sub: 'one photo and the details fill themselves in. no clipboard, no spelling out a member ID.',
  },
  {
    num: '05',
    title: 'Know where you stand.',
    sub: 'a clear priority, an honest wait time that updates every 15 seconds, and spoken guidance back in about 7 seconds.',
  },
  {
    num: '06',
    title: 'Never wait in the dark.',
    sub: 'pain got worse? one press and the care team knows right away.',
  },
];

const clinicianSteps: Step[] = [
  {
    num: '07',
    title: 'The live queue.',
    sub: 'everyone waiting, who needs help first, at a glance. your clinicians always make the final call.',
  },
  {
    num: '08',
    title: 'The patient snapshot.',
    sub: 'a clear summary, the dangerous causes to rule out, and the suggested tests.',
  },
  {
    num: '09',
    title: 'Notes that write themselves.',
    sub: 'talk to your patient. the note drafts while you do.',
  },
  {
    num: '10',
    title: 'The paperwork, handled.',
    sub: 'work notes, school notes, insurance forms and two dozen more, drafted from the visit. your clinician reviews and signs.',
  },
  {
    num: '11',
    title: 'Into the chart.',
    sub: 'everything lands in your hospital system through HL7 and FHIR, and every AI step is saved to the record.',
  },
];

const handoffText =
  'By the time a clinician says your name, your story is already on their screen.';

const clinicianStatement =
  'The wait becomes a head start. The queue, the summary and the full conversation are ready before you open the door. Solace suggests, your clinicians decide.';

const megaText =
  'Calm, understandable emergency care has never been easier. And when everyone can see the line, the waiting room finally makes sense, to the people running it and the people sitting in it.';

const faqs = [
  {
    q: 'Where does Solace run?',
    a: 'Patients check in on their own phone from a QR code in your waiting room. There is nothing to install. Clinicians see the summary on their dashboard or inside the tools they already use.',
  },
  {
    q: 'Does Solace replace triage nurses?',
    a: 'No. Solace handles the paperwork side. It drafts a suggested urgency level and a clean history so your nurses start informed, and a clinician always makes the call.',
  },
  {
    q: 'What languages are supported?',
    a: '20 at launch, voice and text. The patient speaks in their own language, and the care team reads it in theirs.',
  },
  {
    q: 'How does it connect to our EHR?',
    a: 'Through the standard hospital interfaces, HL7 and FHIR. The summary lands in the patient chart as real fields, not a PDF.',
  },
  {
    q: 'Can patients check in by phone?',
    a: 'Yes. The phone agent takes the same story by voice, in the same 20 languages. If anything sounds like an emergency, the caller is told to dial 911 right away and your team is alerted.',
  },
];

const letterTemplates = [
  'Work or school note',
  'FMLA certification',
  'Return to play (concussion)',
  'Fitness to travel',
  'Medical necessity',
  'Jury duty excuse',
];
---

<Page
  title="How Solace works: from the front door to the chart"
  description="The complete Solace journey. Every step a patient takes on their own phone, and everything the care team sees before the room is ready."
>
  <PageHeader
    eyebrow="How it works"
    title="From the front door to the chart."
    lede="Every step a patient takes, and everything your team sees, in one calm flow."
  />

  <!-- ══ 1 · The patient's side ═══════════════════════════════════════════ -->
  <section id="patient-side" data-background-color="primary-default" aria-labelledby="patient-side-heading">
    <div class="container page-section">
      <div class="side-head reveal">
        <p class="eyebrow">The patient&rsquo;s side</p>
        <div class="dashed" aria-hidden="true"></div>
        <h2 id="patient-side-heading" class="heading-medium">
          From their own phone, in their own words.
        </h2>
      </div>

      <div class="steps">
        {patientSteps.slice(0, 2).map((step) => (
          <div class="step reveal">
            <div class="step__lead">
              <span class="step__num" aria-hidden="true">{step.num}</span>
              <h3 class="step__title">{step.title}</h3>
            </div>
            <p class="step__sub text-medium text-sub">{step.sub}</p>
          </div>
        ))}
      </div>

      <div class="moment-slot moment-slot--start">
        <div class="drift drift--up">
          <figure class="moment moment--deep reveal" data-color-scheme="dark">
            <figcaption class="moment__label">their language, from the first tap</figcaption>
            <div class="device moment__device">
              <img
                src="/assets/screens/lang.png"
                alt="The Solace check-in asking the patient to choose their language, with twenty available"
                width="1179"
                height="2556"
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
        </div>
      </div>

      <div class="steps">
        <div class="step reveal">
          <div class="step__lead">
            <span class="step__num" aria-hidden="true">{patientSteps[2].num}</span>
            <h3 class="step__title">{patientSteps[2].title}</h3>
          </div>
          <p class="step__sub text-medium text-sub">{patientSteps[2].sub}</p>
        </div>
      </div>

      <div class="moment-slot moment-pair">
        <div class="drift drift--up">
          <figure class="moment moment--teal moment--sm reveal">
            <figcaption class="moment__label">spoken or typed, their words</figcaption>
            <div class="device moment__device">
              <img
                src="/assets/screens/symptoms.png"
                alt="The patient describing their symptoms by voice or by typing"
                width="1179"
                height="2556"
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
        </div>
        <div class="drift drift--down moment-pair__offset">
          <figure class="moment moment--ink moment--sm reveal" data-color-scheme="dark">
            <figcaption class="moment__label">two or three questions that fit</figcaption>
            <div class="device moment__device">
              <img
                src="/assets/screens/questions.png"
                alt="Follow-up questions chosen to fit the story the patient just told"
                width="1179"
                height="2556"
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
        </div>
      </div>

      <div class="steps">
        <div class="step reveal">
          <div class="step__lead">
            <span class="step__num" aria-hidden="true">{patientSteps[3].num}</span>
            <h3 class="step__title">{patientSteps[3].title}</h3>
          </div>
          <p class="step__sub text-medium text-sub">{patientSteps[3].sub}</p>
        </div>
      </div>

      <div class="moment-slot moment-slot--end">
        <div class="drift drift--down">
          <figure class="moment moment--paper neu-well reveal">
            <figcaption class="moment__label">one photo, the form fills itself</figcaption>
            <div class="device moment__device">
              <img
                src="/assets/screens/insurance.png"
                alt="The insurance card step, where one photo fills in the member details"
                width="1179"
                height="2556"
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
        </div>
      </div>

      <div class="steps">
        <div class="step reveal">
          <div class="step__lead">
            <span class="step__num" aria-hidden="true">{patientSteps[4].num}</span>
            <h3 class="step__title">{patientSteps[4].title}</h3>
          </div>
          <p class="step__sub text-medium text-sub">{patientSteps[4].sub}</p>
        </div>
      </div>

      <div class="moment-slot">
        <div class="drift drift--up">
          <figure class="moment moment--teal reveal">
            <figcaption class="moment__label">a clear place in line</figcaption>
            <div class="device moment__device">
              <img
                src="/assets/screens/plan.png"
                alt="The explained plan: the patient's priority, their wait time and what happens next"
                width="1179"
                height="2556"
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
        </div>
      </div>

      <div class="steps">
        <div class="step reveal">
          <div class="step__lead">
            <span class="step__num" aria-hidden="true">{patientSteps[5].num}</span>
            <h3 class="step__title">{patientSteps[5].title}</h3>
          </div>
          <p class="step__sub text-medium text-sub">{patientSteps[5].sub}</p>
        </div>
      </div>

      <p class="disclosure text-xsmall">Screens are illustrative.</p>
    </div>
  </section>

  <!-- ══ Handoff statement ════════════════════════════════════════════════ -->
  <section data-background-color="secondary-default">
    <div class="container page-section">
      <p class="statement statement--light statement--lg">
        <span class="visually-hidden">{handoffText}</span>
        <span aria-hidden="true">
          {handoffText.split(' ').map((word, i, all) => (
            <>
              <span class="scrub"><span class="scrub__ink">{word}</span></span>
              {i < all.length - 1 ? ' ' : ''}
            </>
          ))}
        </span>
      </p>
    </div>
  </section>

  <!-- ══ 2 · The clinician's side ═════════════════════════════════════════ -->
  <section id="clinician-side" class="stage" data-color-scheme="dark" aria-labelledby="clinician-side-heading">
    <div class="container page-section">
      <div class="side-head reveal">
        <p class="eyebrow">The clinician&rsquo;s side</p>
        <div class="dashed" aria-hidden="true"></div>
        <h2 id="clinician-side-heading" class="heading-medium">Ready before you walk in.</h2>
      </div>

      <div class="steps">
        {clinicianSteps.map((step) => (
          <div class="step reveal">
            <div class="step__lead">
              <span class="step__num" aria-hidden="true">{step.num}</span>
              <h3 class="step__title">{step.title}</h3>
            </div>
            <p class="step__sub text-medium text-sub">{step.sub}</p>
          </div>
        ))}
      </div>

      <p class="statement statement--dark stage__statement">
        <span class="visually-hidden">{clinicianStatement}</span>
        <span aria-hidden="true">
          {clinicianStatement.split(' ').map((word, i, all) => (
            <>
              <span class="scrub"><span class="scrub__ink">{word}</span></span>
              {i < all.length - 1 ? ' ' : ''}
            </>
          ))}
        </span>
      </p>

      <figure class="stage__figure reveal">
        <p class="stage__caption text-medium text-sub">
          This is the screen your team sees while the patient is still in the waiting room.
        </p>
        <div class="device-wide">
          <img
            src="/assets/shots/ehr-clean.png"
            alt="The Solace clinician view: the patient summary, the causes to rule out and the reasons behind the suggested priority"
            width="1148"
            height="556"
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>

      <figure class="stage__figure reveal">
        <p class="stage__caption text-medium text-sub">
          And when the visit ends, the paperwork is already waiting. Work notes, school notes and
          forms, drafted from the chart.
        </p>

        <!-- The legacy letters workspace was React-rendered DOM inside a laptop
             mockup, not a screenshot. Rebuilt here as markup so it stays crisp
             at any width. It inherits the stage's dark scheme, so the panel and
             the recessed draft well both come from the dark material pair. -->
        <div class="letters neu-panel" aria-hidden="true">
          <div class="letters__chrome">
            <span class="letters__title weight-semibold">Letters and forms</span>
            <span class="letters__meta">Sriyan &middot; drafted from today&rsquo;s visit</span>
          </div>

          <div class="letters__body">
            <div class="letters__library">
              <p class="letters__label">24 templates, chart-aware</p>
              <ul class="letters__list">
                {letterTemplates.map((name, i) => (
                  <li class:list={['letters__template', i === 0 && 'letters__template--active']}>
                    {name}
                  </li>
                ))}
              </ul>
            </div>

            <div class="letters__preview">
              <div class="letters__preview-head">
                <p class="letters__label">Draft preview</p>
                <span class="letters__hint">review before signing</span>
              </div>
              <div class="letters__paper neu-inset">
                <p class="letters__paper-title weight-semibold">Work or school note</p>
                <p>To whom it may concern,</p>
                <p>
                  Sriyan was evaluated in our emergency department today for chest tightness and
                  back pain after exercise. He was assessed, observed and discharged in stable
                  condition.
                </p>
                <p>
                  He may return to school on Monday. Please excuse his absence today and tomorrow.
                  No contact sports or strenuous exercise for 48 hours.
                </p>
                <p class="letters__fine">
                  Drafted by Solace from the visit record. Valid only once reviewed and signed by
                  the treating clinician.
                </p>
                <div class="letters__actions">
                  <span class="letters__btn">Edit draft</span>
                  <span class="letters__btn letters__btn--primary">Sign and send</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <figcaption class="visually-hidden">
          The Solace letters workspace: two dozen chart-aware templates with a drafted work note
          ready to review and sign.
        </figcaption>
      </figure>

      <p class="disclosure text-xsmall">
        Screens are illustrative. Solace suggests; the clinician always makes the final call.
      </p>
    </div>
  </section>

  <!-- ══ 3 · The phone agent ══════════════════════════════════════════════ -->
  <section id="phone" data-background-color="primary-default" aria-labelledby="phone-heading">
    <div class="container page-section phone">
      <div class="phone__lead reveal">
        <p class="eyebrow">Phone agent</p>
        <div class="dashed" aria-hidden="true"></div>
        <h2 id="phone-heading" class="heading-medium">Can patients check in by phone?</h2>
      </div>
      <div class="phone__body reveal">
        <p class="text-large">
          Yes. The phone agent takes the same story by voice, in the same 20 languages. If anything
          sounds like an emergency, the caller is told to dial 911 right away and your team is
          alerted.
        </p>
        <a class="arrow-link" href="/demo">
          <span>Hear it on a demo call</span>
          <svg viewBox="0 0 20 14.17" fill="none" aria-hidden="true">
            <circle cx="2" cy="7.08" r="1.6" fill="currentColor" />
            <path
              d="M6.5 7.08h11M13.4 2.2l4.9 4.88-4.9 4.89"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ══ 4 · Closing band ═════════════════════════════════════════════════ -->
  <section data-background-color="secondary-default" aria-labelledby="closing-heading">
    <div class="container page-section">
      <div class="band">
        <div class="band__copy">
          <h2 id="closing-heading" class="band__heading reveal">
            Every patient knows where they stand.
          </h2>
          <p class="band__sub text-large reveal">
            A clear priority, an honest wait time and what happens next. On their own phone, in
            their own language.
          </p>
          <div class="band__actions reveal">
            <CtaPrimary href="/demo" label="Book a Demo" />
            <a class="cta-secondary" href="/demo">Try the Patient Flow</a>
          </div>
        </div>

        <div class="device band__device" aria-hidden="true">
          <img
            src="/assets/screens/plan.png"
            alt=""
            width="1179"
            height="2556"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 5 · Mega statement ═══════════════════════════════════════════════ -->
  <section data-background-color="primary-default">
    <div class="container page-section">
      <p class="statement statement--light">
        <span class="visually-hidden">{megaText}</span>
        <span aria-hidden="true">
          {megaText.split(' ').map((word, i, all) => (
            <>
              <span class="scrub"><span class="scrub__ink">{word}</span></span>
              {i < all.length - 1 ? ' ' : ''}
            </>
          ))}
        </span>
      </p>
    </div>
  </section>

  <!-- ══ 6 · FAQ ══════════════════════════════════════════════════════════ -->
  <section id="faq" data-background-color="secondary-default" aria-labelledby="faq-heading">
    <div class="container page-section faq">
      <h2 id="faq-heading" class="heading-medium">Solace FAQs</h2>

      <ul class="faq__list">
        {faqs.map((faq) => (
          <li>
            <details class="faq__item">
              <summary class="faq__q">
                <span>{faq.q}</span>
                <svg class="faq__chev" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M4 6.25 8 10.25l4-4"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <div class="faq__a">
                <p class="text-medium text-sub">{faq.a}</p>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Page>

<style>
  /* ── Shared section head ─────────────────────────────────────────────── */
  .side-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4x);
    padding-block-end: var(--space-12x);
  }
  @media (min-width: 640.02px) {
    .side-head { padding-block-end: var(--space-16x); }
  }
  .side-head h2 { max-inline-size: 20ch; }

  /* 4-on / 4-off dashed rule, the Suite idiom. */
  .dashed {
    inline-size: min(100%, 320px);
    block-size: 1px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--color-border-sub) 0, var(--color-border-sub) 4px,
      transparent 4px, transparent 8px
    );
  }

  /* ── Numbered step rows ──────────────────────────────────────────────── */
  .steps { display: block; }

  .step {
    display: grid;
    gap: var(--space-3x);
    padding-block: var(--space-9x);
    border-block-start: 1px solid var(--color-border-sub);
  }
  @media (min-width: 640.02px) {
    .step { padding-block: var(--space-12x); }
  }
  @media (min-width: 1080.02px) {
    .step {
      grid-template-columns: 1fr minmax(0, 400px);
      column-gap: var(--space-10x);
      align-items: center;
    }
  }

  .step__lead {
    display: flex;
    align-items: baseline;
    gap: var(--space-5x);
    min-inline-size: 0;
  }
  @media (min-width: 640.02px) {
    .step__lead { gap: var(--space-8x); }
  }

  .step__num {
    flex: none;
    font-size: var(--font-size-heading-large);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    letter-spacing: var(--letter-spacing-heading);
    font-variant-numeric: tabular-nums;
    color: rgb(from var(--color-primary-base) r g b / 45%);
  }

  .step__title {
    font-size: var(--font-size-heading-medium);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
  }

  /* No justify-self here on purpose: the column already caps the measure, and
     shrink-wrapping to the end leaves one-line subs floating off the shared
     left edge that every other row shares. */
  .step__sub { max-inline-size: 46ch; }

  .disclosure {
    margin-block-start: var(--space-10x);
    color: var(--color-text-disabled);
  }

  /* ── App moments ─────────────────────────────────────────────────────── */
  .moment-slot { padding-block: var(--space-16x); }
  @media (min-width: 1080.02px) {
    .moment-slot { padding-block: var(--space-20x); }
    /* The legacy page pushed alternating cards toward opposite gutters so the
       column never reads as a centred stack. */
    .moment-slot--start { padding-inline-end: 30%; }
    .moment-slot--end   { padding-inline-start: 30%; }
  }

  .moment-pair { display: grid; gap: var(--space-10x); }
  @media (min-width: 640.02px) {
    .moment-pair { grid-template-columns: repeat(2, 1fr); gap: var(--space-6x); }
    .moment-pair__offset { margin-block-start: var(--space-16x); }
  }

  /* Cards crop the phone at their bottom edge, the composite the legacy page
     got from the photographed hand running off the card. */
  .moment {
    position: relative;
    /* Capped and centred inside its slot: the slot's asymmetric padding is
       what throws the card off the page's centre line, the same way the
       legacy wrapper's one-sided padding did. */
    inline-size: min(100%, 460px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8x);
    padding: var(--space-7x) var(--space-6x) 0;
    border-radius: var(--radius-6x);
    overflow: hidden;
  }

  .moment--teal {
    background-image: linear-gradient(166.14deg, var(--solace-10) 0%, var(--solace-20) 100%);
  }
  .moment--deep {
    background-image: linear-gradient(
      166.14deg,
      var(--solace-90) 0%,
      var(--solace-100) 55%,
      var(--slate-black) 100%
    );
  }
  .moment--ink { background-color: var(--slate-100); }

  .moment__label {
    align-self: flex-start;
    padding: var(--space-1_5x) var(--space-4x);
    border-radius: var(--radius-full);
    font-size: var(--font-size-12);
    font-weight: var(--font-weight-medium);
    letter-spacing: normal;
    line-height: var(--line-height-default);
    background-color: rgb(from var(--white) r g b / 80%);
    color: var(--neutral-90);
  }
  .moment--deep .moment__label,
  .moment--ink .moment__label {
    background-color: rgb(from var(--white) r g b / 10%);
    border: 1px solid rgb(from var(--white) r g b / 20%);
    color: var(--color-text-base);
  }
  .moment--paper .moment__label {
    background-color: var(--white);
    box-shadow: var(--elevation-xsmall);
  }

  .moment--sm { inline-size: min(100%, 420px); }
  .moment__device { inline-size: min(100%, 248px); translate: 0 var(--space-8x); }
  .moment--sm .moment__device { inline-size: min(100%, 220px); }

  /* ── Device frames ───────────────────────────────────────────────────── */
  .device {
    padding: var(--space-1_5x);
    border-radius: var(--radius-10x);
    background-image: linear-gradient(180deg, var(--neutral-90) 0%, var(--slate-black) 100%);
    box-shadow:
      inset 0 1px 0 0 rgb(from var(--white) r g b / 18%),
      0 2px 4px -1px rgb(from var(--slate-black) r g b / 20%),
      0 16px 32px -12px rgb(from var(--slate-black) r g b / 30%),
      0 40px 64px -28px rgb(from var(--slate-black) r g b / 32%);
  }
  .device img { inline-size: 100%; border-radius: var(--radius-8x); }

  .device-wide {
    padding: var(--space-2x);
