---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import IntegrationWall from '../components/IntegrationWall.astro';
import Suite from '../components/Suite.astro';
import Manifesto from '../components/Manifesto.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Solace: AI-native intake & triage for the emergency department"
  description="Solace turns ED intake into a calm, AI-native workflow: multilingual voice intake for patients and an instant, explainable acuity pre-brief for clinicians."
>
  <div class="page-homepage">
    <Header />
    <main>
      <Hero />
      <IntegrationWall />
      <Suite />
      <Manifesto />
      <TrustStrip />
      <ClosingCta />
    </main>
    <Footer />
  </div>
</Base>

<style>
  /* timeline-scope lifts the hero's view timeline into a scope the sticky
     header can see, even though the header is not a descendant of the hero. */
  .page-homepage {
    timeline-scope: --homepage-hero-section;
    --content-max-width: 1440px;
    position: relative;
  }

  /* The hero's colour carries down the WHOLE page rather than stopping at it.
     Two halves to this, and the first attempt only did one of them.

     The wash: a tall, very low-contrast field of the same teal and blue behind
     everything, running the full document height.

     The half that was missing: every section paints an OPAQUE background from
     its data-background-color, so a field sitting behind them showed through
     precisely nowhere. On this page those backgrounds become 92% opaque, which
     lets 8% of the field through the entire page. Enough to tint, far too
     little to touch contrast. Sections keep their own colour and their own
     boundaries; they just sit on a surface that remembers where the page
     started. */
  .page-homepage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(180deg,
        rgb(from var(--solace-60) r g b / 0.30) 0%,
        rgb(from var(--slate-40) r g b / 0.20) 22%,
        rgb(from var(--solace-30) r g b / 0.13) 48%,
        rgb(from var(--solace-30) r g b / 0.08) 74%,
        rgb(from var(--slate-30) r g b / 0.06) 100%);
  }
  .page-homepage > * { position: relative; z-index: 1; }

  .page-homepage :global([data-background-color]) {
    background-color: color-mix(in srgb, var(--section-bg-color) 92%, transparent);
  }
  /* The footer stays fully opaque. It is the one dark block on the page and a
     pale tint bleeding into it would grey it. */
  .page-homepage :global(.footer) { background-color: var(--slate-100); }
</style>
